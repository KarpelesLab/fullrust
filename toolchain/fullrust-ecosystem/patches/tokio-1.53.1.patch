# fullrust support for tokio 1.53.1 — cfg broadenings only, so feature "net"
# (TcpListener/TcpStream/TcpSocket/UdpSocket) and tokio::io::unix::AsyncFd build
# on target_os = "fullrust" via the fd-level (std::os::fd) code paths tokio
# already has for unix/wasi, and the Linux socket flags. No libc dependency.
# Needs the bundle's mio (fullrust epoll backend) and a fullrust socket2 0.6.
# Not covered: process, signal (need libc/signal-hook-registry and
# std::os::unix::process), net::unix (needs std::os::unix::net).
# Applied on top of crates.io tokio 1.53.1 (vendored in crates/tokio/).
