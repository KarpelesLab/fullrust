+pub(crate) unsafe fn socket(domain: c_int, ty: c_int, protocol: c_int) -> c_int {
+    unsafe { sc(nr::SOCKET, domain as usize, ty as usize, protocol as usize, 0, 0, 0) as c_int }
+}
