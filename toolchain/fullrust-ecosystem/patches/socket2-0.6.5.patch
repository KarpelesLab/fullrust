+#[cfg(target_os = "fullrust")]
+macro_rules! syscall {
+    (fcntl ( $fd: expr, $cmd: expr $(,)* ) ) => { syscall!(fcntl($fd, $cmd, 0)) };
+    ($fn: ident ( $($arg: expr),* $(,)* ) ) => {{
+        #[allow(unused_unsafe)]
+        let res = unsafe { libc::$fn($($arg, )*) };
+        if res < 0 {
+            Err(std::io::Error::from_raw_os_error(-(res as i32)))
+        } else {
+            Ok(res)
+        }
+    }};
+}
