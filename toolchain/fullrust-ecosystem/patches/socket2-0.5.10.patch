# fullrust support for socket2 0.5.10 — upstream's own Linux backend
# (src/sys/unix.rs), run on a libc-free raw-syscall shim.
# Applied on top of crates.io socket2 0.5.10 (vendored in crates/socket2/;
# 0.5.10 is the latest 0.5.x).
#
# * New file src/sys/fullrust_libc.rs (identical to socket2-0.6's): a private
#   `mod libc` stand-in (Linux x86-64 types with compile-time size/align
#   checks, constants generated from libc 0.2.189 on x86_64-unknown-linux-gnu,
#   raw `syscall` functions), plus the fullrust-only extension
#   `Socket::peer_cred` -> `UCred`.
# * Every cfg predicate rewritten by ../patches/fullrust-cfg.py:
#     unix               -> any(unix, target_os = "fullrust")
#     target_os="linux"  -> any(target_os = "linux", target_os = "fullrust")
#     target_env="gnu"   -> any(target_env = "gnu", target_os = "fullrust")
#   so fullrust compiles exactly the x86_64-linux-gnu code paths.
# * Hand edits: `use crate::libc` (unix.rs, socket.rs), `mod libc` +
#   `pub use UCred` (lib.rs), a fullrust `syscall!` arm (raw -errno results;
#   2-arg fcntl), std::os::fd / std::os::fullrust::ffi instead of
#   std::os::unix::{io, ffi} (kept for unix: MSRV 1.63 predates std::os::fd),
#   keeping the std::os::unix::net conversions / SockAddr::as_unix unix-only
#   (those std types do not exist on fullrust), and re-exporting
#   `sock_filter`/`sockaddr_storage` (0.5's API names these libc types).
# * Cargo.toml: check-cfg for target_os = "fullrust".

