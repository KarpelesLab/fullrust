diff --git a/compiler/rustc_target/src/spec/targets/x86_64_unknown_linux_fullrust.rs b/compiler/rustc_target/src/spec/targets/x86_64_unknown_linux_fullrust.rs
new file mode 100644
index 00000000..d20db759
--- /dev/null
+++ b/compiler/rustc_target/src/spec/targets/x86_64_unknown_linux_fullrust.rs
@@ -0,0 +1,33 @@
+use crate::spec::{Cc, LinkerFlavor, Lld, StackProbeType, Target, TargetMetadata, base};
+
+/// `x86_64-unknown-linux-fullrust`: 64-bit Linux, but **libc-free and fully
+/// static**. Same kernel syscall ABI and codegen as `x86_64-unknown-linux-gnu`
+/// (hence the shared `llvm_target`/`data_layout`), but std is implemented on
+/// raw syscalls via `std::sys::pal::fullrust` — no libc, no C runtime, no
+/// dynamic linker. Produces a single statically-linked ELF executable.
+pub(crate) fn target() -> Target {
+    let mut base = base::fullrust::opts();
+    base.cpu = "x86-64".into();
+    base.plt_by_default = false;
+    base.max_atomic_width = Some(64);
+    base.stack_probes = StackProbeType::Inline;
+    // Statically link the binary; do not pull in any default/C libraries.
+    // `add_pre_link_args` takes the `Lld::No` flavor and adds the `Lld::Yes`
+    // twin itself, so pass `Lld::No` here even though we link with rust-lld.
+    base.add_pre_link_args(LinkerFlavor::Gnu(Cc::No, Lld::No), &["-static"]);
+
+    Target {
+        llvm_target: "x86_64-unknown-linux-gnu".into(),
+        metadata: TargetMetadata {
+            description: Some("64-bit Linux, libc-free fully-static (purestd/fullrust)".into()),
+            tier: Some(3),
+            host_tools: Some(false),
+            std: Some(true),
+        },
+        pointer_width: 64,
+        data_layout:
+            "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128".into(),
+        arch: "x86_64".into(),
+        options: base,
+    }
+}
