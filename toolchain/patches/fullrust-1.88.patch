diff --git a/library/std/src/sys/process/fullrust.rs b/library/std/src/sys/process/fullrust.rs
new file mode 100644
index 00000000..9f33ede5
--- /dev/null
+++ b/library/std/src/sys/process/fullrust.rs
@@ -0,0 +1,615 @@
+//! Process spawning for the fullrust target, on raw Linux syscalls (no libc).
+//!
+//! `spawn` is the classic `fork` + `execve`. All allocation-bearing work — the
+//! `argv`/`envp` pointer arrays, the `PATH` candidate list, the cwd — is done in
+//! the parent *before* forking, so the child touches only async-signal-safe
+//! syscalls (`dup2`, `chdir`, `execve`) and never the allocator or a lock it may
+//! have inherited mid-acquisition. `PATH` resolution happens by `execve`-ing each
+//! candidate in turn, exactly like `execvp`.
+
+use super::env::{CommandEnv, CommandEnvs};
+pub use crate::ffi::OsString as EnvKey;
+use crate::ffi::{CStr, CString, OsStr, OsString};
+use crate::num::NonZero;
+use crate::path::Path;
+use crate::sys::fs::File;
+use crate::sys::pal::sysc;
+use crate::sys::pipe::{self, AnonPipe};
+use crate::{fmt, io};
+
+// AT_FDCWD and the open/poll flags the spawner needs directly.
+const AT_FDCWD: usize = (-100isize) as usize;
+const O_RDONLY: i32 = 0;
+const O_WRONLY: i32 = 1;
+const O_CLOEXEC: i32 = 0o2000000;
+const SIGKILL: usize = 9;
+const WNOHANG: usize = 1;
+
+fn to_cstring(os: &OsStr) -> io::Result<CString> {
+    CString::new(os.as_encoded_bytes())
+        .map_err(|_| io::const_error!(io::ErrorKind::InvalidInput, "nul byte in command component"))
+}
+
+////////////////////////////////////////////////////////////////////////////////
+// Command
+////////////////////////////////////////////////////////////////////////////////
+
+pub struct Command {
+    program: OsString,
+    args: Vec<OsString>,
+    env: CommandEnv,
+    cwd: Option<OsString>,
+    stdin: Option<Stdio>,
+    stdout: Option<Stdio>,
+    stderr: Option<Stdio>,
+}
+
+pub struct StdioPipes {
+    pub stdin: Option<AnonPipe>,
+    pub stdout: Option<AnonPipe>,
+    pub stderr: Option<AnonPipe>,
+}
+
+pub enum Stdio {
+    Inherit,
+    Null,
+    MakePipe,
+    ParentStdout,
+    ParentStderr,
+    InheritFile(File),
+    Fd(AnonPipe),
+}
+
+/// What the child should install on a given stdio slot.
+enum Theirs {
+    /// Leave the inherited fd in place.
+    Inherit,
+    /// `dup2` this owned fd onto the slot; closed in the parent after the fork.
+    Owned(AnonPipe),
+    /// `dup2` this borrowed fd (a `File`/parent stdio) onto the slot.
+    Raw(i32),
+}
+
+impl Command {
+    pub fn new(program: &OsStr) -> Command {
+        Command {
+            program: program.to_owned(),
+            args: vec![program.to_owned()],
+            env: Default::default(),
+            cwd: None,
+            stdin: None,
+            stdout: None,
+            stderr: None,
+        }
+    }
+
+    pub fn arg(&mut self, arg: &OsStr) {
+        self.args.push(arg.to_owned());
+    }
+
+    pub fn env_mut(&mut self) -> &mut CommandEnv {
+        &mut self.env
+    }
+
+    pub fn cwd(&mut self, dir: &OsStr) {
+        self.cwd = Some(dir.to_owned());
+    }
+
+    pub fn stdin(&mut self, stdin: Stdio) {
+        self.stdin = Some(stdin);
+    }
+
+    pub fn stdout(&mut self, stdout: Stdio) {
+        self.stdout = Some(stdout);
+    }
+
+    pub fn stderr(&mut self, stderr: Stdio) {
+        self.stderr = Some(stderr);
+    }
+
+    pub fn get_program(&self) -> &OsStr {
+        &self.program
+    }
+
+    pub fn get_args(&self) -> CommandArgs<'_> {
+        let mut iter = self.args.iter();
+        iter.next();
+        CommandArgs { iter }
+    }
+
+    pub fn get_envs(&self) -> CommandEnvs<'_> {
+        self.env.iter()
+    }
+
+    pub fn get_current_dir(&self) -> Option<&Path> {
+        self.cwd.as_ref().map(|cs| Path::new(cs))
+    }
+
+    pub fn spawn(
+        &mut self,
+        default: Stdio,
+        needs_stdin: bool,
+    ) -> io::Result<(Process, StdioPipes)> {
+        // Resolve each stdio slot to a child-side fd plan plus an optional
+        // parent-side pipe end. Unset slots fall back to `default` (stdin only
+        // inherits when the caller needs it; otherwise it is `/dev/null`).
+        let null = Stdio::Null;
+        let default_stdin = if needs_stdin { &default } else { &null };
+        let stdin = self.stdin.as_ref().unwrap_or(default_stdin);
+        let stdout = self.stdout.as_ref().unwrap_or(&default);
+        let stderr = self.stderr.as_ref().unwrap_or(&default);
+        let (child_stdin, our_stdin) = to_child(stdin, true)?;
+        let (child_stdout, our_stdout) = to_child(stdout, false)?;
+        let (child_stderr, our_stderr) = to_child(stderr, false)?;
+
+        // Build everything the child will need *before* forking: argv, envp,
+        // the cwd, and the list of executables to try.
+        let argv: Vec<CString> =
+            self.args.iter().map(|a| to_cstring(a)).collect::<io::Result<_>>()?;
+        let mut argv_ptrs: Vec<*const i8> = argv.iter().map(|c| c.as_ptr()).collect();
+        argv_ptrs.push(crate::ptr::null());
+
+        let env_map = self.env.capture();
+        let mut env_cstrings: Vec<CString> = Vec::with_capacity(env_map.len());
+        for (k, v) in &env_map {
+            let mut buf = Vec::with_capacity(k.len() + v.len() + 1);
+            buf.extend_from_slice(k.as_encoded_bytes());
+            buf.push(b'=');
+            buf.extend_from_slice(v.as_encoded_bytes());
+            env_cstrings.push(CString::new(buf).map_err(|_| {
+                io::const_error!(io::ErrorKind::InvalidInput, "nul byte in environment")
+            })?);
+        }
+        let mut envp_ptrs: Vec<*const i8> = env_cstrings.iter().map(|c| c.as_ptr()).collect();
+        envp_ptrs.push(crate::ptr::null());
+
+        let candidates = resolve_candidates(&self.program, &env_map)?;
+        let cwd = self.cwd.as_ref().map(|c| to_cstring(c)).transpose()?;
+
+        // SAFETY: fork(2). In the child we only call async-signal-safe syscalls.
+        let pid = sysc::ret(unsafe { sysc::syscall1(sysc::FORK, 0) })
+            .map_err(io::Error::from_raw_os_error)?;
+        if pid == 0 {
+            // CHILD: no allocation, no locks — only syscalls on prebuilt data.
+            unsafe {
+                child_exec(
+                    &child_stdin,
+                    &child_stdout,
+                    &child_stderr,
+                    cwd.as_deref(),
+                    &candidates,
+                    argv_ptrs.as_ptr(),
+                    envp_ptrs.as_ptr(),
+                )
+            }
+        }
+
+        // PARENT: drop the child-side owned ends so only the child holds them.
+        drop((child_stdin, child_stdout, child_stderr));
+        Ok((
+            Process { pid: pid as i32, status: None },
+            StdioPipes { stdin: our_stdin, stdout: our_stdout, stderr: our_stderr },
+        ))
+    }
+}
+
+/// Resolve `program` into the list of paths the child should try to `execve`.
+/// A program containing `/` is used verbatim; otherwise each `PATH` entry is
+/// tried in order (an empty entry meaning the current directory).
+fn resolve_candidates(
+    program: &OsStr,
+    env_map: &crate::collections::BTreeMap<EnvKey, OsString>,
+) -> io::Result<Vec<CString>> {
+    let prog = program.as_encoded_bytes();
+    if prog.contains(&b'/') {
+        return Ok(vec![to_cstring(program)?]);
+    }
+    let path = env_map
+        .get(OsStr::new("PATH"))
+        .map(|p| p.as_encoded_bytes().to_vec())
+        .unwrap_or_else(|| b"/usr/local/bin:/usr/bin:/bin".to_vec());
+
+    let mut out = Vec::new();
+    for dir in path.split(|&b| b == b':') {
+        let mut full = Vec::with_capacity(dir.len() + 1 + prog.len());
+        if dir.is_empty() {
+            full.extend_from_slice(prog);
+        } else {
+            full.extend_from_slice(dir);
+            full.push(b'/');
+            full.extend_from_slice(prog);
+        }
+        if let Ok(c) = CString::new(full) {
+            out.push(c);
+        }
+    }
+    if out.is_empty() {
+        return Err(io::const_error!(io::ErrorKind::NotFound, "no candidate paths for program"));
+    }
+    Ok(out)
+}
+
+/// Lower a `Stdio` into the child's fd plan and the parent's pipe end (if any).
+fn to_child(stdio: &Stdio, readable: bool) -> io::Result<(Theirs, Option<AnonPipe>)> {
+    match stdio {
+        Stdio::Inherit => Ok((Theirs::Inherit, None)),
+        Stdio::Null => Ok((Theirs::Owned(open_devnull(readable)?), None)),
+        Stdio::MakePipe => {
+            let (read, write) = pipe::pipe()?;
+            if readable {
+                // child reads its stdin; parent keeps the write end
+                Ok((Theirs::Owned(read), Some(write)))
+            } else {
+                // child writes; parent reads
+                Ok((Theirs::Owned(write), Some(read)))
+            }
+        }
+        Stdio::ParentStdout => Ok((Theirs::Raw(1), None)),
+        Stdio::ParentStderr => Ok((Theirs::Raw(2), None)),
+        Stdio::InheritFile(f) => Ok((Theirs::Raw(f.as_raw_fd()), None)),
+        Stdio::Fd(p) => Ok((Theirs::Raw(p.as_raw_fd()), None)),
+    }
+}
+
+fn open_devnull(readable: bool) -> io::Result<AnonPipe> {
+    let flags = (if readable { O_RDONLY } else { O_WRONLY }) | O_CLOEXEC;
+    let fd = sysc::ret(unsafe {
+        sysc::syscall4(sysc::OPENAT, AT_FDCWD, c"/dev/null".as_ptr() as usize, flags as usize, 0)
+    })
+    .map_err(io::Error::from_raw_os_error)?;
+    Ok(AnonPipe::from_fd(fd as i32))
+}
+
+/// The post-fork child: install stdio, change directory, and `execve` the first
+/// candidate that works. Never returns to Rust.
+///
+/// # Safety
+/// Must run only in the forked child and call nothing but the syscalls below.
+unsafe fn child_exec(
+    stdin: &Theirs,
+    stdout: &Theirs,
+    stderr: &Theirs,
+    cwd: Option<&CStr>,
+    candidates: &[CString],
+    argv: *const *const i8,
+    envp: *const *const i8,
+) -> ! {
+    unsafe {
+        install(stdin, 0);
+        install(stdout, 1);
+        install(stderr, 2);
+        if let Some(cwd) = cwd {
+            sysc::syscall1(sysc::CHDIR, cwd.as_ptr() as usize);
+        }
+        for cand in candidates {
+            sysc::syscall3(
+                sysc::EXECVE,
+                cand.as_ptr() as usize,
+                argv as usize,
+                envp as usize,
+            );
+            // If execve returned, this candidate failed; try the next one.
+        }
+        // Nothing executed: mirror the shell's "command not found" code.
+        sysc::syscall1(sysc::EXIT_GROUP, 127);
+        // exit_group never returns.
+        core::hint::unreachable_unchecked()
+    }
+}
+
+/// `dup2` a `Theirs` fd onto `slot` (clearing close-on-exec so it survives exec).
+unsafe fn install(theirs: &Theirs, slot: usize) {
+    let fd = match theirs {
+        Theirs::Inherit => return,
+        Theirs::Owned(p) => p.as_raw_fd(),
+        Theirs::Raw(fd) => *fd,
+    };
+    unsafe {
+        sysc::syscall2(sysc::DUP2, fd as usize, slot);
+    }
+}
+
+pub fn output(cmd: &mut Command) -> io::Result<(ExitStatus, Vec<u8>, Vec<u8>)> {
+    let (mut process, mut pipes) = cmd.spawn(Stdio::MakePipe, false)?;
+    drop(pipes.stdin.take());
+    let (mut stdout, mut stderr) = (Vec::new(), Vec::new());
+    match (pipes.stdout.take(), pipes.stderr.take()) {
+        (None, None) => {}
+        (Some(out), None) => {
+            out.read_to_end(&mut stdout)?;
+        }
+        (None, Some(err)) => {
+            err.read_to_end(&mut stderr)?;
+        }
+        (Some(out), Some(err)) => {
+            pipe::read2(out, &mut stdout, err, &mut stderr)?;
+        }
+    }
+    let status = process.wait()?;
+    Ok((status, stdout, stderr))
+}
+
+impl From<AnonPipe> for Stdio {
+    fn from(pipe: AnonPipe) -> Stdio {
+        Stdio::Fd(pipe)
+    }
+}
+
+impl From<io::Stdout> for Stdio {
+    fn from(_: io::Stdout) -> Stdio {
+        Stdio::ParentStdout
+    }
+}
+
+impl From<io::Stderr> for Stdio {
+    fn from(_: io::Stderr) -> Stdio {
+        Stdio::ParentStderr
+    }
+}
+
+impl From<File> for Stdio {
+    fn from(file: File) -> Stdio {
+        Stdio::InheritFile(file)
+    }
+}
+
+impl fmt::Debug for Stdio {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        match self {
+            Stdio::Inherit => f.write_str("Inherit"),
+            Stdio::Null => f.write_str("Null"),
+            Stdio::MakePipe => f.write_str("MakePipe"),
+            Stdio::ParentStdout => f.write_str("ParentStdout"),
+            Stdio::ParentStderr => f.write_str("ParentStderr"),
+            Stdio::InheritFile(file) => f.debug_tuple("InheritFile").field(file).finish(),
+            Stdio::Fd(p) => f.debug_tuple("Fd").field(p).finish(),
+        }
+    }
+}
+
+impl fmt::Debug for Command {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        if f.alternate() {
+            let mut debug_command = f.debug_struct("Command");
+            debug_command.field("program", &self.program).field("args", &self.args);
+            if !self.env.is_unchanged() {
+                debug_command.field("env", &self.env);
+            }
+            if self.cwd.is_some() {
+                debug_command.field("cwd", &self.cwd);
+            }
+            if self.stdin.is_some() {
+                debug_command.field("stdin", &self.stdin);
+            }
+            if self.stdout.is_some() {
+                debug_command.field("stdout", &self.stdout);
+            }
+            if self.stderr.is_some() {
+                debug_command.field("stderr", &self.stderr);
+            }
+            debug_command.finish()
+        } else {
+            if let Some(ref cwd) = self.cwd {
+                write!(f, "cd {cwd:?} && ")?;
+            }
+            if self.env.does_clear() {
+                write!(f, "env -i ")?;
+            } else {
+                let mut any_removed = false;
+                for (key, value_opt) in self.get_envs() {
+                    if value_opt.is_none() {
+                        if !any_removed {
+                            write!(f, "env ")?;
+                            any_removed = true;
+                        }
+                        write!(f, "-u {} ", key.to_string_lossy())?;
+                    }
+                }
+            }
+            for (key, value_opt) in self.get_envs() {
+                if let Some(value) = value_opt {
+                    write!(f, "{}={value:?} ", key.to_string_lossy())?;
+                }
+            }
+            if self.program != self.args[0] {
+                write!(f, "[{:?}] ", self.program)?;
+            }
+            write!(f, "{:?}", self.args[0])?;
+            for arg in &self.args[1..] {
+                write!(f, " {:?}", arg)?;
+            }
+            Ok(())
+        }
+    }
+}
+
+////////////////////////////////////////////////////////////////////////////////
+// Process / exit status
+////////////////////////////////////////////////////////////////////////////////
+
+pub struct Process {
+    pid: i32,
+    /// Cached once the child has been reaped, so repeated `wait`s are cheap and
+    /// the pid is never reused out from under us.
+    status: Option<ExitStatus>,
+}
+
+impl Process {
+    pub fn id(&self) -> u32 {
+        self.pid as u32
+    }
+
+    pub fn kill(&mut self) -> io::Result<()> {
+        if self.status.is_some() {
+            return Err(io::const_error!(
+                io::ErrorKind::InvalidInput,
+                "invalid argument: can't kill an exited process",
+            ));
+        }
+        sysc::ret(unsafe { sysc::syscall2(sysc::KILL, self.pid as usize, SIGKILL) })
+            .map(drop)
+            .map_err(io::Error::from_raw_os_error)
+    }
+
+    pub fn wait(&mut self) -> io::Result<ExitStatus> {
+        if let Some(s) = self.status {
+            return Ok(s);
+        }
+        let mut status: i32 = 0;
+        loop {
+            match sysc::ret(unsafe {
+                sysc::syscall4(
+                    sysc::WAIT4,
+                    self.pid as usize,
+                    &mut status as *mut i32 as usize,
+                    0,
+                    0,
+                )
+            }) {
+                Ok(_) => break,
+                Err(4) => continue, // EINTR
+                Err(e) => return Err(io::Error::from_raw_os_error(e)),
+            }
+        }
+        let s = ExitStatus(status);
+        self.status = Some(s);
+        Ok(s)
+    }
+
+    pub fn try_wait(&mut self) -> io::Result<Option<ExitStatus>> {
+        if let Some(s) = self.status {
+            return Ok(Some(s));
+        }
+        let mut status: i32 = 0;
+        match sysc::ret(unsafe {
+            sysc::syscall4(
+                sysc::WAIT4,
+                self.pid as usize,
+                &mut status as *mut i32 as usize,
+                WNOHANG,
+                0,
+            )
+        }) {
+            Ok(0) => Ok(None), // still running
+            Ok(_) => {
+                let s = ExitStatus(status);
+                self.status = Some(s);
+                Ok(Some(s))
+            }
+            Err(4) => Ok(None), // EINTR — treat as not-yet
+            Err(e) => Err(io::Error::from_raw_os_error(e)),
+        }
+    }
+}
+
+/// A raw Linux wait status (the `int` filled in by `wait4`).
+#[derive(PartialEq, Eq, Clone, Copy, Default)]
+pub struct ExitStatus(i32);
+
+impl ExitStatus {
+    pub fn exit_ok(&self) -> Result<(), ExitStatusError> {
+        // A wait status of 0 is the only success.
+        match NonZero::<i32>::try_from(self.0) {
+            Ok(failure) => Err(ExitStatusError(failure)),
+            Err(_) => Ok(()),
+        }
+    }
+
+    pub fn code(&self) -> Option<i32> {
+        // WIFEXITED: low 7 bits zero. Exit code is bits 8..16.
+        (self.0 & 0x7f == 0).then(|| (self.0 >> 8) & 0xff)
+    }
+
+    fn signal(&self) -> Option<i32> {
+        let term = self.0 & 0x7f;
+        (term != 0 && term != 0x7f).then_some(term)
+    }
+
+    fn core_dumped(&self) -> bool {
+        self.0 & 0x80 != 0
+    }
+}
+
+impl fmt::Display for ExitStatus {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        if let Some(code) = self.code() {
+            write!(f, "exit status: {code}")
+        } else if let Some(signal) = self.signal() {
+            if self.core_dumped() {
+                write!(f, "signal: {signal} (core dumped)")
+            } else {
+                write!(f, "signal: {signal}")
+            }
+        } else {
+            write!(f, "unrecognised wait status: {}", self.0)
+        }
+    }
+}
+
+impl fmt::Debug for ExitStatus {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        f.debug_tuple("unix_wait_status").field(&self.0).finish()
+    }
+}
+
+#[derive(PartialEq, Eq, Clone, Copy, Debug)]
+pub struct ExitStatusError(NonZero<i32>);
+
+impl Into<ExitStatus> for ExitStatusError {
+    fn into(self) -> ExitStatus {
+        ExitStatus(self.0.into())
+    }
+}
+
+impl ExitStatusError {
+    pub fn code(self) -> Option<NonZero<i32>> {
+        ExitStatus(self.0.into()).code().map(|st| NonZero::new(st).unwrap())
+    }
+}
+
+#[derive(PartialEq, Eq, Clone, Copy, Debug)]
+pub struct ExitCode(u8);
+
+impl ExitCode {
+    pub const SUCCESS: ExitCode = ExitCode(0);
+    pub const FAILURE: ExitCode = ExitCode(1);
+
+    pub fn as_i32(&self) -> i32 {
+        self.0 as i32
+    }
+}
+
+impl From<u8> for ExitCode {
+    fn from(code: u8) -> Self {
+        Self(code)
+    }
+}
+
+pub struct CommandArgs<'a> {
+    iter: crate::slice::Iter<'a, OsString>,
+}
+
+impl<'a> Iterator for CommandArgs<'a> {
+    type Item = &'a OsStr;
+    fn next(&mut self) -> Option<&'a OsStr> {
+        self.iter.next().map(|os| &**os)
+    }
+    fn size_hint(&self) -> (usize, Option<usize>) {
+        self.iter.size_hint()
+    }
+}
+
+impl<'a> ExactSizeIterator for CommandArgs<'a> {
+    fn len(&self) -> usize {
+        self.iter.len()
+    }
+    fn is_empty(&self) -> bool {
+        self.iter.is_empty()
+    }
+}
+
+impl<'a> fmt::Debug for CommandArgs<'a> {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        f.debug_list().entries(self.iter.clone()).finish()
+    }
+}
