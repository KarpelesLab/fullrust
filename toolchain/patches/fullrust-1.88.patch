diff --git a/library/std/src/sys/alloc/fullrust.rs b/library/std/src/sys/alloc/fullrust.rs
new file mode 100644
index 00000000..df74af19
--- /dev/null
+++ b/library/std/src/sys/alloc/fullrust.rs
@@ -0,0 +1,71 @@
+//! Global allocator for the fullrust target: anonymous `mmap`/`munmap`.
+//!
+//! Milestone-1 allocator: every allocation is a page-rounded private anonymous
+//! mapping, released with `munmap` on free (the size comes back via `Layout`,
+//! so no header is needed). Simple and correct; wasteful for small allocations.
+//! A segregated free-list (ported from purestd) replaces this later.
+
+use super::super::pal::sysc;
+use crate::alloc::{GlobalAlloc, Layout, System};
+use crate::ptr;
+
+const PAGE: usize = 4096;
+
+#[inline]
+fn round_up(v: usize, to: usize) -> usize {
+    (v + to - 1) & !(to - 1)
+}
+
+#[inline]
+fn mmap(len: usize) -> *mut u8 {
+    let r = unsafe {
+        // mmap(NULL, len, PROT_READ|PROT_WRITE, MAP_PRIVATE|MAP_ANONYMOUS, -1, 0)
+        sysc::syscall6(
+            sysc::MMAP,
+            0,
+            len,
+            sysc::PROT_READ | sysc::PROT_WRITE,
+            sysc::MAP_PRIVATE | sysc::MAP_ANONYMOUS,
+            usize::MAX, // fd = -1
+            0,
+        )
+    };
+    match sysc::ret(r) {
+        // The kernel handed us a fresh mapping at address `p`; materialize a
+        // pointer with provenance for it (strict-provenance compliant).
+        Ok(p) => ptr::with_exposed_provenance_mut(p),
+        Err(_) => ptr::null_mut(),
+    }
+}
+
+#[stable(feature = "alloc_system_type", since = "1.28.0")]
+unsafe impl GlobalAlloc for System {
+    #[inline]
+    unsafe fn alloc(&self, layout: Layout) -> *mut u8 {
+        // mmap returns page-aligned memory; that satisfies any alignment up to a
+        // page. std's allocations are far below that.
+        debug_assert!(layout.align() <= PAGE);
+        mmap(round_up(layout.size().max(1), PAGE))
+    }
+
+    #[inline]
+    unsafe fn alloc_zeroed(&self, layout: Layout) -> *mut u8 {
+        // Freshly mmap'd anonymous memory is already zeroed.
+        unsafe { self.alloc(layout) }
+    }
+
+    #[inline]
+    unsafe fn dealloc(&self, ptr: *mut u8, layout: Layout) {
+        if ptr.is_null() {
+            return;
+        }
+        unsafe {
+            sysc::syscall2(sysc::MUNMAP, ptr as usize, round_up(layout.size().max(1), PAGE));
+        }
+    }
+
+    #[inline]
+    unsafe fn realloc(&self, ptr: *mut u8, layout: Layout, new_size: usize) -> *mut u8 {
+        unsafe { super::realloc_fallback(self, ptr, layout, new_size) }
+    }
+}
