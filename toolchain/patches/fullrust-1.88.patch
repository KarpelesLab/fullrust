diff --git a/library/std/src/sys/pal/fullrust/common.rs b/library/std/src/sys/pal/fullrust/common.rs
new file mode 100644
index 00000000..cf8c20ca
--- /dev/null
+++ b/library/std/src/sys/pal/fullrust/common.rs
@@ -0,0 +1,50 @@
+use crate::io as std_io;
+
+// Called once by `rt::init` via `sys::init`, with the real argc/argv that the
+// compiler-emitted `main` passed to `lang_start`. We hand them to the args
+// machinery so `std::env::args()` works.
+//
+// SAFETY: must be called only once during runtime initialization.
+pub unsafe fn init(argc: isize, argv: *const *const u8, _sigpipe: u8) {
+    unsafe { crate::sys::args::init(argc, argv) };
+}
+
+// SAFETY: must be called only once during runtime cleanup.
+pub unsafe fn cleanup() {}
+
+pub fn unsupported<T>() -> std_io::Result<T> {
+    Err(unsupported_err())
+}
+
+pub fn unsupported_err() -> std_io::Error {
+    std_io::Error::UNSUPPORTED_PLATFORM
+}
+
+pub fn is_interrupted(code: i32) -> bool {
+    code == 4 // EINTR
+}
+
+pub fn decode_error_kind(code: i32) -> crate::io::ErrorKind {
+    use crate::io::ErrorKind::*;
+    match code {
+        1 | 13 => PermissionDenied,  // EPERM / EACCES
+        2 => NotFound,               // ENOENT
+        4 => Interrupted,            // EINTR
+        11 => WouldBlock,            // EAGAIN
+        17 => AlreadyExists,         // EEXIST
+        21 => IsADirectory,          // EISDIR
+        22 => InvalidInput,          // EINVAL
+        28 => StorageFull,           // ENOSPC
+        32 => BrokenPipe,            // EPIPE
+        110 => TimedOut,             // ETIMEDOUT
+        111 => ConnectionRefused,    // ECONNREFUSED
+        _ => Uncategorized,
+    }
+}
+
+pub fn abort_internal() -> ! {
+    unsafe {
+        super::sysc::syscall1(super::sysc::EXIT_GROUP, 134);
+    }
+    core::intrinsics::abort()
+}
diff --git a/library/std/src/sys/pal/fullrust/mod.rs b/library/std/src/sys/pal/fullrust/mod.rs
new file mode 100644
index 00000000..27279914
--- /dev/null
+++ b/library/std/src/sys/pal/fullrust/mod.rs
@@ -0,0 +1,138 @@
+//! The `fullrust` platform abstraction layer: libc-free Linux on raw syscalls.
+//!
+//! This pal provides what a hosted std gets from libc + crt0: the process entry
+//! point (`_start`), process control, time, and the syscall wrappers the other
+//! `sys` modules build on. The kernel ABI is plain Linux x86-64 `syscall`; there
+//! is no C runtime. Ported from purestd's raw-syscall layer, inlined here so std
+//! stays self-contained.
+
+#![deny(unsafe_op_in_unsafe_fn)]
+
+pub mod os;
+pub mod pipe;
+pub mod thread;
+pub mod time;
+
+mod common;
+pub use common::*;
+
+// ---------------------------------------------------------------------------
+// Raw syscall layer (x86-64). Number in rax; args rdi, rsi, rdx, r10, r8, r9;
+// result in rax; -errno in [-4095, -1].
+// ---------------------------------------------------------------------------
+pub mod sysc {
+    use core::arch::asm;
+
+    #[inline]
+    pub unsafe fn syscall1(n: usize, a: usize) -> usize {
+        let r;
+        unsafe {
+            asm!("syscall", inlateout("rax") n => r, in("rdi") a,
+                 lateout("rcx") _, lateout("r11") _, options(nostack, preserves_flags));
+        }
+        r
+    }
+    #[inline]
+    pub unsafe fn syscall2(n: usize, a: usize, b: usize) -> usize {
+        let r;
+        unsafe {
+            asm!("syscall", inlateout("rax") n => r, in("rdi") a, in("rsi") b,
+                 lateout("rcx") _, lateout("r11") _, options(nostack, preserves_flags));
+        }
+        r
+    }
+    #[inline]
+    pub unsafe fn syscall3(n: usize, a: usize, b: usize, c: usize) -> usize {
+        let r;
+        unsafe {
+            asm!("syscall", inlateout("rax") n => r, in("rdi") a, in("rsi") b, in("rdx") c,
+                 lateout("rcx") _, lateout("r11") _, options(nostack, preserves_flags));
+        }
+        r
+    }
+    #[inline]
+    pub unsafe fn syscall6(
+        n: usize, a: usize, b: usize, c: usize, d: usize, e: usize, f: usize,
+    ) -> usize {
+        let r;
+        unsafe {
+            asm!("syscall", inlateout("rax") n => r, in("rdi") a, in("rsi") b, in("rdx") c,
+                 in("r10") d, in("r8") e, in("r9") f,
+                 lateout("rcx") _, lateout("r11") _, options(nostack, preserves_flags));
+        }
+        r
+    }
+
+    pub const READ: usize = 0;
+    pub const WRITE: usize = 1;
+    pub const GETPID: usize = 39;
+    pub const EXIT_GROUP: usize = 231;
+    pub const CLOCK_GETTIME: usize = 228;
+    pub const GETRANDOM: usize = 318;
+    pub const SCHED_YIELD: usize = 24;
+    pub const NANOSLEEP: usize = 35;
+    pub const MMAP: usize = 9;
+    pub const MUNMAP: usize = 11;
+
+    pub const PROT_READ: usize = 0x1;
+    pub const PROT_WRITE: usize = 0x2;
+    pub const MAP_PRIVATE: usize = 0x2;
+    pub const MAP_ANONYMOUS: usize = 0x20;
+
+    /// Interpret a raw return as `Result<usize, i32>` (Err is the errno).
+    #[inline]
+    pub fn ret(r: usize) -> Result<usize, i32> {
+        let s = r as isize;
+        if (-4095..0).contains(&s) { Err(-s as i32) } else { Ok(r) }
+    }
+}
+
+// ---------------------------------------------------------------------------
+// Process entry point. The kernel jumps here with rsp at argc; there is no
+// return address and no C runtime. We call the compiler-emitted C `main`, which
+// drives `lang_start` -> `rt::init` (capturing argc/argv) -> user `fn main`.
+// When it returns, exit_group with its code.
+// ---------------------------------------------------------------------------
+unsafe extern "C" {
+    // The C `main` shim the compiler emits for `fn main`: it calls
+    // `lang_start(user_main, argc, argv, sigpipe)`.
+    fn main(argc: core::ffi::c_int, argv: *const *const u8) -> core::ffi::c_int;
+}
+
+#[unsafe(naked)]
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn _start() -> ! {
+    core::arch::naked_asm!(
+        "xor rbp, rbp",
+        "mov rdi, rsp", // pointer to argc
+        "and rsp, -16", // ABI stack alignment
+        "call {start}",
+        start = sym rust_start,
+    )
+}
+
+unsafe extern "C" fn rust_start(stack: *const usize) -> ! {
+    // [argc][argv0..argv(argc-1)][NULL][envp0..][NULL][auxv...]
+    let argc = unsafe { *stack } as core::ffi::c_int;
+    let argv = unsafe { stack.add(1) } as *const *const u8;
+    let code = unsafe { main(argc, argv) };
+    os::exit(code as i32)
+}
+
+// ---------------------------------------------------------------------------
+// Symbols the toolchain expects from the environment that neither libc (absent)
+// nor compiler_builtins provide. `compiler-builtins-mem` supplies the `mem*`
+// intrinsics; `strlen` is not among them, and core's `CStr::from_ptr` (used to
+// decode argv/envp) calls it.
+// ---------------------------------------------------------------------------
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn strlen(s: *const core::ffi::c_char) -> usize {
+    let mut n = 0;
+    // SAFETY: `s` points to a NUL-terminated C string (caller contract).
+    unsafe {
+        while *s.add(n) != 0 {
+            n += 1;
+        }
+    }
+    n
+}
diff --git a/library/std/src/sys/pal/fullrust/os.rs b/library/std/src/sys/pal/fullrust/os.rs
