@@ -0,0 +1,53 @@
+//! `is_terminal` for the fullrust target.
+//!
+//! There is no libc `isatty`, so we ask the kernel directly: `ioctl(fd, TCGETS)`
+//! succeeds only on a tty (otherwise `ENOTTY`). The std types that implement
+//! `IsTerminal` are a fixed set, and on this target they aren't reachable through
+//! the unix `AsFd` machinery, so a small sealed trait maps each to its fd.
+
+use crate::fs::File;
+use crate::io::{Stderr, StderrLock, Stdin, StdinLock, Stdout, StdoutLock};
+use crate::sys::pal::sysc;
+use crate::sys_common::AsInner;
+
+// `ioctl` request that fetches terminal attributes; fails with ENOTTY otherwise.
+const TCGETS: usize = 0x5401;
+
+fn isatty(fd: i32) -> bool {
+    // `struct termios` (kernel `ktermios`) is well under 64 bytes; the ioctl only
+    // writes into the buffer on success, and we only care whether it succeeds.
+    let mut termios = [0u8; 64];
+    sysc::ret(unsafe {
+        sysc::syscall3(sysc::IOCTL, fd as usize, TCGETS, termios.as_mut_ptr() as usize)
+    })
+    .is_ok()
+}
+
+/// The fd backing each `IsTerminal` type on this target.
+pub trait TerminalFd {
+    fn terminal_fd(&self) -> i32;
+}
+
+macro_rules! std_stream_fd {
+    ($($t:ty => $fd:expr),* $(,)?) => {$(
+        impl TerminalFd for $t {
+            fn terminal_fd(&self) -> i32 { $fd }
+        }
+    )*};
+}
+
+std_stream_fd! {
+    Stdin => 0, StdinLock<'_> => 0,
+    Stdout => 1, StdoutLock<'_> => 1,
+    Stderr => 2, StderrLock<'_> => 2,
+}
+
+impl TerminalFd for File {
+    fn terminal_fd(&self) -> i32 {
+        self.as_inner().as_raw_fd()
+    }
+}
+
+pub fn is_terminal<T: TerminalFd>(t: &T) -> bool {
+    isatty(t.terminal_fd())
+}
