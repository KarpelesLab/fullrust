--- /dev/null
+++ b/library/std/src/sys/pal/fullrust/common.rs
@@ -0,0 +1,78 @@
+use crate::io as std_io;
+
+// Called once by `rt::init` via `sys::init`, with the real argc/argv that the
+// compiler-emitted `main` passed to `lang_start`. We hand them to the args
+// machinery so `std::env::args()` works, and derive `envp` (which follows the
+// NULL-terminated `argv` on the stack) for `std::env::var()`.
+//
+// SAFETY: must be called only once during runtime initialization.
+pub unsafe fn init(argc: isize, argv: *const *const u8, _sigpipe: u8) {
+    unsafe { crate::sys::args::init(argc, argv) };
+    // Stack layout: [argv0..argv(argc-1)][NULL][envp0..][NULL]. So `envp` begins
+    // one past the argv NULL terminator, i.e. at `argv[argc + 1]`.
+    if !argv.is_null() && argc >= 0 {
+        let envp = unsafe { argv.add(argc as usize + 1) } as *const *const core::ffi::c_char;
+        unsafe { crate::sys::env::init(envp) };
+    }
+    // Ignore SIGPIPE, as std does on unix: a write to a closed pipe/socket must
+    // surface as `EPIPE`, never terminate the process. Without this (and with no
+    // signal handler installed) the kernel's default action would kill us.
+    unsafe { ignore_sigpipe() };
+}
+
+/// `rt_sigaction(SIGPIPE, SIG_IGN)` via the raw kernel ABI.
+unsafe fn ignore_sigpipe() {
+    use super::sysc;
+    const SIGPIPE: usize = 13;
+    const SIG_IGN: usize = 1;
+    // struct kernel_sigaction { sa_handler; sa_flags; sa_restorer; sa_mask[1]; }
+    let act: [usize; 4] = [SIG_IGN, 0, 0, 0];
+    unsafe {
+        // Final arg is the sigset size in bytes (8 for the 64-bit kernel mask).
+        sysc::syscall4(sysc::RT_SIGACTION, SIGPIPE, act.as_ptr() as usize, 0, 8);
+    }
+}
+
+// SAFETY: must be called only once during runtime cleanup.
+pub unsafe fn cleanup() {}
+
+// Retained for parity with other pals and any subsystem not yet ported to raw
+// syscalls; the ported fs/process/net paths no longer reach for it.
+#[allow(dead_code)]
+pub fn unsupported<T>() -> std_io::Result<T> {
+    Err(unsupported_err())
+}
+
+#[allow(dead_code)]
+pub fn unsupported_err() -> std_io::Error {
+    std_io::Error::UNSUPPORTED_PLATFORM
+}
+
+pub fn is_interrupted(code: i32) -> bool {
+    code == 4 // EINTR
+}
+
+pub fn decode_error_kind(code: i32) -> crate::io::ErrorKind {
+    use crate::io::ErrorKind::*;
+    match code {
+        1 | 13 => PermissionDenied,  // EPERM / EACCES
+        2 => NotFound,               // ENOENT
+        4 => Interrupted,            // EINTR
+        11 => WouldBlock,            // EAGAIN
+        17 => AlreadyExists,         // EEXIST
+        21 => IsADirectory,          // EISDIR
+        22 => InvalidInput,          // EINVAL
+        28 => StorageFull,           // ENOSPC
+        32 => BrokenPipe,            // EPIPE
+        110 => TimedOut,             // ETIMEDOUT
+        111 => ConnectionRefused,    // ECONNREFUSED
+        _ => Uncategorized,
+    }
+}
+
+pub fn abort_internal() -> ! {
+    unsafe {
+        super::sysc::syscall1(super::sysc::EXIT_GROUP, 134);
+    }
+    core::intrinsics::abort()
+}
