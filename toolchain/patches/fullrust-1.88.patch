--- /dev/null
+++ b/library/std/src/sys/args/fullrust.rs
@@ -0,0 +1,38 @@
+//! Command-line arguments for the fullrust target.
+//!
+//! `argc`/`argv` are captured once at startup (by `pal::fullrust::common::init`,
+//! which `rt::init` calls). Decoded lazily, lossily as UTF-8 — matching how
+//! purestd treats non-Unicode args on a best-effort basis.
+
+pub use super::common::Args;
+use crate::ffi::{CStr, OsString};
+use crate::ptr;
+use crate::sync::atomic::{AtomicIsize, AtomicPtr, Ordering};
+
+static ARGC: AtomicIsize = AtomicIsize::new(0);
+static ARGV: AtomicPtr<*const u8> = AtomicPtr::new(ptr::null_mut());
+
+/// One-time global initialization.
+pub unsafe fn init(argc: isize, argv: *const *const u8) {
+    ARGC.store(argc, Ordering::Relaxed);
+    ARGV.store(argv as *mut *const u8, Ordering::Relaxed);
+}
+
+/// Returns the command line arguments.
+pub fn args() -> Args {
+    let argv = ARGV.load(Ordering::Relaxed);
+    let argc = if argv.is_null() { 0 } else { ARGC.load(Ordering::Relaxed) };
+
+    let mut vec = Vec::with_capacity(argc.max(0) as usize);
+    for i in 0..argc {
+        // SAFETY: argv is non-null with at least `argc` entries.
+        let ptr = unsafe { (argv as *const *const u8).offset(i).read() };
+        if ptr.is_null() {
+            break;
+        }
+        // SAFETY: argv entries are valid NUL-terminated C strings.
+        let bytes = unsafe { CStr::from_ptr(ptr.cast()).to_bytes() };
+        vec.push(OsString::from(String::from_utf8_lossy(bytes).into_owned()));
+    }
+    Args::new(vec)
+}
