diff --git a/library/std/src/sys/pal/fullrust/thread.rs b/library/std/src/sys/pal/fullrust/thread.rs
new file mode 100644
index 00000000..8d7112c9
--- /dev/null
+++ b/library/std/src/sys/pal/fullrust/thread.rs
@@ -0,0 +1,211 @@
+use super::sysc;
+use crate::ffi::CStr;
+use crate::io;
+use crate::num::NonZero;
+use crate::sync::Arc;
+use crate::sync::atomic::{AtomicU32, Ordering};
+use crate::time::Duration;
+
+pub const DEFAULT_MIN_STACK_SIZE: usize = 2 * 1024 * 1024;
+
+// Child-stack-launching clone wrapper (musl-style): the child begins on the new
+// stack and calls `entry(arg)`, then exits. `ctid` is passed as the child-tid
+// pointer so the kernel can clear it (CLONE_CHILD_CLEARTID) once the thread has
+// fully left its stack — the join handshake.
+//   rdi=entry, rsi=stack_top, rdx=flags, rcx=arg, r8=ctid
+core::arch::global_asm!(
+    ".text",
+    ".globl __fullrust_clone",
+    ".hidden __fullrust_clone",
+    "__fullrust_clone:",
+    "  and rsi, -16",
+    "  sub rsi, 16",
+    "  mov [rsi], rdi",   // save entry on child stack
+    "  mov [rsi+8], rcx", // save arg
+    "  mov r10, r8",      // child_tid = ctid
+    "  mov rdi, rdx",     // clone arg1 = flags (rsi already = child stack)
+    "  xor edx, edx",     // parent_tid = 0
+    "  xor r8d, r8d",     // tls = 0
+    "  mov eax, 56",      // SYS_clone
+    "  syscall",
+    "  test rax, rax",
+    "  jnz 1f",           // parent: return tid
+    "  xor ebp, ebp",     // child: end the call-frame chain
+    "  pop rax",          // rax = entry
+    "  pop rdi",          // rdi = arg
+    "  call rax",         // entry(arg); never returns
+    "  mov eax, 60",      // SYS_exit (fallback)
+    "  xor edi, edi",
+    "  syscall",
+    "1:",
+    "  ret",
+);
+
+unsafe extern "C" {
+    fn __fullrust_clone(
+        entry: extern "C" fn(*mut u8) -> !,
+        stack_top: *mut u8,
+        flags: usize,
+        arg: *mut u8,
+        ctid: *mut u32,
+    ) -> isize;
+}
+
+// Shared VM/fds/signals, same thread group — a thread, not a process.
+const CLONE_VM: usize = 0x00000100;
+const CLONE_FS: usize = 0x00000200;
+const CLONE_FILES: usize = 0x00000400;
+const CLONE_SIGHAND: usize = 0x00000800;
+const CLONE_THREAD: usize = 0x00010000;
+const CLONE_SYSVSEM: usize = 0x00040000;
+const CLONE_CHILD_CLEARTID: usize = 0x00200000;
+
+struct Inner {
+    /// The child-tid futex word: nonzero while the thread exists, cleared to 0
+    /// (and futex-woken) by the kernel once the thread has terminated and is no
+    /// longer using its stack.
+    ctid: AtomicU32,
+}
+
+pub struct Thread {
+    inner: Arc<Inner>,
+    stack_base: *mut u8,
+    stack_size: usize,
+}
+
+// The handle is moved between threads; the stack pointer is only used (munmap)
+// after the kernel reports the thread gone.
+unsafe impl Send for Thread {}
+unsafe impl Sync for Thread {}
+
+type Payload = (Box<dyn FnOnce()>, Arc<Inner>);
+
+extern "C" fn thread_start(arg: *mut u8) -> ! {
+    // SAFETY: `arg` is the `Payload` box leaked in `Thread::new`.
+    let payload = unsafe { Box::from_raw(arg as *mut Payload) };
+    let (f, inner) = *payload;
+    f();
+    // Keep `Inner` (and thus the `ctid` word) alive past our exit: the kernel
+    // writes 0 to it *after* this thread is gone. The joiner owns the other Arc
+    // ref and frees `Inner` once it has observed the clear.
+    core::mem::forget(inner);
+    unsafe { exit_thread() }
+}
+
+unsafe fn exit_thread() -> ! {
+    unsafe {
+        sysc::syscall1(60, 0); // SYS_exit — this thread only
+    }
+    loop {
+        core::hint::spin_loop();
+    }
+}
+
+fn mmap_stack(size: usize) -> *mut u8 {
+    let r = unsafe {
+        sysc::syscall6(
+            sysc::MMAP,
+            0,
+            size,
+            sysc::PROT_READ | sysc::PROT_WRITE,
+            sysc::MAP_PRIVATE | sysc::MAP_ANONYMOUS,
+            usize::MAX,
+            0,
+        )
+    };
+    match sysc::ret(r) {
+        Ok(p) => crate::ptr::with_exposed_provenance_mut(p),
+        Err(_) => crate::ptr::null_mut(),
+    }
+}
+
+impl Thread {
+    // unsafe: see thread::Builder::spawn_unchecked for safety requirements
+    pub unsafe fn new(stack: usize, p: Box<dyn FnOnce()>) -> io::Result<Thread> {
+        // ctid starts nonzero; the kernel clears it on thread exit.
+        let inner = Arc::new(Inner { ctid: AtomicU32::new(1) });
+        let payload: Box<Payload> = Box::new((p, inner.clone()));
+        let arg = Box::into_raw(payload) as *mut u8;
+
+        let size = stack.max(DEFAULT_MIN_STACK_SIZE);
+        let base = mmap_stack(size);
+        if base.is_null() {
+            drop(unsafe { Box::from_raw(arg as *mut Payload) });
+            return Err(io::Error::from_raw_os_error(12)); // ENOMEM
+        }
+
+        let stack_top = unsafe { base.add(size) };
+        let ctid = inner.ctid.as_ptr();
+        let flags = CLONE_VM
+            | CLONE_FS
+            | CLONE_FILES
+            | CLONE_SIGHAND
+            | CLONE_THREAD
+            | CLONE_SYSVSEM
+            | CLONE_CHILD_CLEARTID;
+        let r = unsafe { __fullrust_clone(thread_start, stack_top, flags, arg, ctid) };
+        if r <= 0 {
+            drop(unsafe { Box::from_raw(arg as *mut Payload) });
+            unsafe {
+                sysc::syscall2(sysc::MUNMAP, base as usize, size);
+            }
+            return Err(io::Error::from_raw_os_error(if r < 0 { -r as i32 } else { 11 }));
+        }
+
+        Ok(Thread { inner, stack_base: base, stack_size: size })
+    }
+
+    pub fn yield_now() {
+        unsafe {
+            sysc::syscall1(sysc::SCHED_YIELD, 0);
+        }
+    }
+
+    pub fn set_name(_name: &CStr) {
+        // prctl(PR_SET_NAME) — not wired up yet.
+    }
+
+    pub fn sleep(dur: Duration) {
+        let ts = [dur.as_secs() as i64, dur.subsec_nanos() as i64];
+        unsafe {
+            sysc::syscall2(sysc::NANOSLEEP, ts.as_ptr() as usize, 0);
+        }
+    }
+
+    pub fn join(self) {
+        // Wait for the kernel to clear the child-tid word (thread fully gone).
+        // CLONE_CHILD_CLEARTID's exit wake is a *non-private* FUTEX_WAKE, so we
+        // must wait with a non-private FUTEX_WAIT (not the private one used by
+        // the sync primitives) or the wake lands in a different hash bucket.
+        const FUTEX_WAIT: usize = 0; // shared (no FUTEX_PRIVATE_FLAG)
+        let ptr = self.inner.ctid.as_ptr() as usize;
+        loop {
+            let v = self.inner.ctid.load(Ordering::Acquire);
+            if v == 0 {
+                break;
+            }
+            unsafe {
+                // futex(uaddr, FUTEX_WAIT, v, NULL)
+                sysc::syscall6(202, ptr, FUTEX_WAIT, v as usize, 0, 0, 0);
+            }
+        }
+        // Safe now: the thread is no longer executing on its stack.
+        unsafe {
+            sysc::syscall2(sysc::MUNMAP, self.stack_base as usize, self.stack_size);
+        }
+    }
+}
+
+pub fn available_parallelism() -> io::Result<NonZero<usize>> {
+    // sched_getaffinity(0, sizeof(set), &set) then count the set CPU bits.
+    let mut set = [0u64; 16]; // up to 1024 CPUs
+    let r =
+        unsafe { sysc::syscall3(204, 0, core::mem::size_of_val(&set), set.as_mut_ptr() as usize) };
+    match sysc::ret(r) {
+        Ok(_) => {
+            let n: u32 = set.iter().map(|w| w.count_ones()).sum();
+            Ok(NonZero::new(n.max(1) as usize).unwrap())
+        }
+        Err(_) => Ok(NonZero::new(1).unwrap()),
+    }
+}
diff --git a/library/std/src/sys/pal/fullrust/time.rs b/library/std/src/sys/pal/fullrust/time.rs
new file mode 100644
index 00000000..6c0ae184
--- /dev/null
+++ b/library/std/src/sys/pal/fullrust/time.rs
@@ -0,0 +1,55 @@
+use super::sysc;
+use crate::time::Duration;
+
+#[derive(Copy, Clone, PartialEq, Eq, PartialOrd, Ord, Debug, Hash)]
+pub struct Instant(Duration);
+
+#[derive(Copy, Clone, PartialEq, Eq, PartialOrd, Ord, Debug, Hash)]
+pub struct SystemTime(Duration);
+
+pub const UNIX_EPOCH: SystemTime = SystemTime(Duration::from_secs(0));
+
+fn clock(id: usize) -> Duration {
+    // struct timespec { i64 tv_sec; i64 tv_nsec; }
+    let mut ts = [0i64; 2];
+    unsafe {
+        sysc::syscall2(sysc::CLOCK_GETTIME, id, ts.as_mut_ptr() as usize);
+    }
+    Duration::new(ts[0] as u64, ts[1] as u32)
+}
+
+impl Instant {
+    pub fn now() -> Instant {
+        Instant(clock(1)) // CLOCK_MONOTONIC
+    }
+
+    pub fn checked_sub_instant(&self, other: &Instant) -> Option<Duration> {
+        self.0.checked_sub(other.0)
+    }
+
+    pub fn checked_add_duration(&self, other: &Duration) -> Option<Instant> {
+        Some(Instant(self.0.checked_add(*other)?))
+    }
+
+    pub fn checked_sub_duration(&self, other: &Duration) -> Option<Instant> {
+        Some(Instant(self.0.checked_sub(*other)?))
+    }
+}
+
+impl SystemTime {
+    pub fn now() -> SystemTime {
+        SystemTime(clock(0)) // CLOCK_REALTIME
+    }
+
+    pub fn sub_time(&self, other: &SystemTime) -> Result<Duration, Duration> {
+        self.0.checked_sub(other.0).ok_or_else(|| other.0 - self.0)
+    }
+
+    pub fn checked_add_duration(&self, other: &Duration) -> Option<SystemTime> {
+        Some(SystemTime(self.0.checked_add(*other)?))
+    }
+
+    pub fn checked_sub_duration(&self, other: &Duration) -> Option<SystemTime> {
+        Some(SystemTime(self.0.checked_sub(*other)?))
+    }
+}
