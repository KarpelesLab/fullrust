+//! TCP/UDP sockets and DNS for the fullrust target, on raw Linux syscalls.
+//!
+//! A single `Socket` (an owned fd) backs `TcpStream`, `TcpListener`, and
+//! `UdpSocket`; the public types are thin wrappers exposing the std interface.
+//! Addresses are marshalled to/from raw `sockaddr_in`/`sockaddr_in6` bytes. All
+//! sends use `MSG_NOSIGNAL` because this target installs no `SIGPIPE` handler —
+//! a write to a closed peer must return `EPIPE`, not kill the process. Name
+//! resolution is a self-contained DNS client (`/etc/hosts` + `/etc/resolv.conf`
+//! + UDP queries), since there is no libc `getaddrinfo`.
+
+use crate::io::{self, BorrowedCursor, IoSlice, IoSliceMut};
+use crate::net::{IpAddr, Ipv4Addr, Ipv6Addr, Shutdown, SocketAddr, SocketAddrV4, SocketAddrV6};
+use crate::sys::pal::sysc;
+use crate::time::Duration;
+use crate::{fmt, mem};
+
+// Address families / socket types / protocols.
+const AF_INET: usize = 2;
+const AF_INET6: usize = 10;
+const SOCK_STREAM: usize = 1;
+const SOCK_DGRAM: usize = 2;
+const SOCK_CLOEXEC: usize = 0o2000000;
+
+const SOL_SOCKET: usize = 1;
+const IPPROTO_IP: usize = 0;
+const IPPROTO_TCP: usize = 6;
+const IPPROTO_IPV6: usize = 41;
+
+// Socket options.
+const SO_REUSEADDR: usize = 2;
+const SO_ERROR: usize = 4;
+const SO_BROADCAST: usize = 6;
+const SO_LINGER: usize = 13;
+const SO_RCVTIMEO: usize = 20;
+const SO_SNDTIMEO: usize = 21;
+const TCP_NODELAY: usize = 1;
+const IP_TTL: usize = 2;
+const IP_MULTICAST_TTL: usize = 33;
+const IP_MULTICAST_LOOP: usize = 34;
+const IP_ADD_MEMBERSHIP: usize = 35;
+const IP_DROP_MEMBERSHIP: usize = 36;
+const IPV6_MULTICAST_LOOP: usize = 19;
+const IPV6_ADD_MEMBERSHIP: usize = 20;
+const IPV6_DROP_MEMBERSHIP: usize = 21;
+const IPV6_V6ONLY: usize = 26;
+
+// send/recv flags and shutdown / fcntl bits.
+const MSG_PEEK: usize = 2;
+const MSG_NOSIGNAL: usize = 0x4000;
+const O_NONBLOCK: usize = 0o4000;
+const F_GETFL: usize = 3;
+const F_SETFL: usize = 4;
+const F_DUPFD_CLOEXEC: usize = 1030;
+const POLLOUT: i16 = 0x4;
+const EINPROGRESS: i32 = 115;
+// Maximum iovec count the kernel accepts in one readv/writev (UIO_MAXIOV).
+const IOV_MAX: usize = 1024;
+
+#[inline]
+fn cvt(r: usize) -> io::Result<usize> {
+    sysc::ret(r).map_err(io::Error::from_raw_os_error)
+}
+
+// ---------------------------------------------------------------------------
+// sockaddr marshalling
+// ---------------------------------------------------------------------------
+
+/// Serialize a `SocketAddr` into a raw `sockaddr_in`/`sockaddr_in6`, returning
+/// the significant length.
+fn addr_to_raw(addr: &SocketAddr, buf: &mut [u8; 28]) -> usize {
+    *buf = [0; 28];
+    match addr {
+        SocketAddr::V4(a) => {
+            buf[0..2].copy_from_slice(&(AF_INET as u16).to_ne_bytes());
+            buf[2..4].copy_from_slice(&a.port().to_be_bytes());
+            buf[4..8].copy_from_slice(&a.ip().octets());
+            16
+        }
+        SocketAddr::V6(a) => {
+            buf[0..2].copy_from_slice(&(AF_INET6 as u16).to_ne_bytes());
+            buf[2..4].copy_from_slice(&a.port().to_be_bytes());
+            buf[4..8].copy_from_slice(&a.flowinfo().to_ne_bytes());
+            buf[8..24].copy_from_slice(&a.ip().octets());
+            buf[24..28].copy_from_slice(&a.scope_id().to_ne_bytes());
+            28
+        }
+    }
+}
+
+fn raw_to_addr(buf: &[u8]) -> io::Result<SocketAddr> {
+    let family = u16::from_ne_bytes([buf[0], buf[1]]) as usize;
+    match family {
+        AF_INET => {
+            let port = u16::from_be_bytes([buf[2], buf[3]]);
+            let ip = Ipv4Addr::new(buf[4], buf[5], buf[6], buf[7]);
+            Ok(SocketAddr::V4(SocketAddrV4::new(ip, port)))
+        }
+        AF_INET6 => {
+            let port = u16::from_be_bytes([buf[2], buf[3]]);
+            let flowinfo = u32::from_ne_bytes(buf[4..8].try_into().unwrap());
+            let mut octets = [0u8; 16];
+            octets.copy_from_slice(&buf[8..24]);
+            let scope = u32::from_ne_bytes(buf[24..28].try_into().unwrap());
+            Ok(SocketAddr::V6(SocketAddrV6::new(octets.into(), port, flowinfo, scope)))
+        }
+        _ => Err(io::const_error!(io::ErrorKind::InvalidInput, "unrecognized address family")),
+    }
+}
+
+// ---------------------------------------------------------------------------
+// Socket
+// ---------------------------------------------------------------------------
+
+pub struct Socket {
+    fd: i32,
+}
+
+impl Socket {
+    fn new_raw(family: usize, ty: usize) -> io::Result<Socket> {
+        let fd = cvt(unsafe { sysc::syscall3(sysc::SOCKET, family, ty | SOCK_CLOEXEC, 0) })?;
+        Ok(Socket { fd: fd as i32 })
+    }
+
+    fn new(addr: &SocketAddr, ty: usize) -> io::Result<Socket> {
+        let family = match addr {
+            SocketAddr::V4(..) => AF_INET,
+            SocketAddr::V6(..) => AF_INET6,
+        };
+        Socket::new_raw(family, ty)
+    }
+
+    fn setsockopt<T>(&self, level: usize, name: usize, value: T) -> io::Result<()> {
+        cvt(unsafe {
+            sysc::syscall5(
+                sysc::SETSOCKOPT,
+                self.fd as usize,
+                level,
+                name,
+                &value as *const T as usize,
+                mem::size_of::<T>(),
+            )
+        })?;
+        Ok(())
+    }
+
+    fn getsockopt<T: Copy>(&self, level: usize, name: usize) -> io::Result<T> {
+        // SAFETY: the kernel fills `val` with `len` bytes of plain option data.
+        unsafe {
+            let mut val: T = mem::zeroed();
+            let mut len = mem::size_of::<T>() as u32;
+            cvt(sysc::syscall5(
+                sysc::GETSOCKOPT,
+                self.fd as usize,
+                level,
+                name,
+                &mut val as *mut T as usize,
+                &mut len as *mut u32 as usize,
+            ))?;
+            Ok(val)
+        }
+    }
+
+    fn connect(&self, addr: &SocketAddr) -> io::Result<()> {
+        let mut raw = [0u8; 28];
+        let len = addr_to_raw(addr, &mut raw);
+        cvt(unsafe {
+            sysc::syscall3(sysc::CONNECT, self.fd as usize, raw.as_ptr() as usize, len)
+        })?;
+        Ok(())
+    }
+
+    fn connect_timeout(&self, addr: &SocketAddr, timeout: Duration) -> io::Result<()> {
+        self.set_nonblocking(true)?;
+        let mut raw = [0u8; 28];
+        let len = addr_to_raw(addr, &mut raw);
+        let r = sysc::ret(unsafe {
+            sysc::syscall3(sysc::CONNECT, self.fd as usize, raw.as_ptr() as usize, len)
+        });
+        let result = match r {
+            Ok(_) => Ok(()),
+            Err(e) if e == EINPROGRESS => {
+                if timeout.as_secs() == 0 && timeout.subsec_nanos() == 0 {
+                    return Err(io::const_error!(
+                        io::ErrorKind::InvalidInput,
+                        "cannot set a 0 duration timeout",
+                    ));
+                }
+                self.poll_connect(timeout)
+            }
+            Err(e) => Err(io::Error::from_raw_os_error(e)),
+        };
+        self.set_nonblocking(false)?;
+        result
+    }
+
+    fn poll_connect(&self, timeout: Duration) -> io::Result<()> {
+        #[repr(C)]
+        struct PollFd {
+            fd: i32,
+            events: i16,
+            revents: i16,
+        }
+        let mut ms = timeout.as_millis();
+        if ms == 0 {
+            ms = 1;
+        }
+        let ms = ms.min(i32::MAX as u128) as i32;
+        let mut pfd = PollFd { fd: self.fd, events: POLLOUT, revents: 0 };
+        loop {
+            match sysc::ret(unsafe {
+                sysc::syscall3(sysc::POLL, &mut pfd as *mut PollFd as usize, 1, ms as usize)
+            }) {
+                Ok(0) => {
+                    return Err(io::const_error!(
+                        io::ErrorKind::TimedOut,
+                        "connection timed out",
+                    ));
+                }
+                Ok(_) => break,
+                Err(4) => continue, // EINTR
+                Err(e) => return Err(io::Error::from_raw_os_error(e)),
+            }
+        }
+        // Connection result is reported via SO_ERROR.
+        let err: i32 = self.getsockopt(SOL_SOCKET, SO_ERROR)?;
+        if err == 0 { Ok(()) } else { Err(io::Error::from_raw_os_error(err)) }
+    }
+
+    fn accept(&self) -> io::Result<(Socket, SocketAddr)> {
+        let mut storage = [0u8; 28];
+        let mut len = storage.len() as u32;
+        let fd = cvt(unsafe {
+            sysc::syscall4(
+                sysc::ACCEPT4,
+                self.fd as usize,
+                storage.as_mut_ptr() as usize,
+                &mut len as *mut u32 as usize,
+                SOCK_CLOEXEC,
+            )
+        })?;
+        Ok((Socket { fd: fd as i32 }, raw_to_addr(&storage)?))
+    }
+
+    fn duplicate(&self) -> io::Result<Socket> {
+        let fd = cvt(unsafe {
+            sysc::syscall3(sysc::FCNTL, self.fd as usize, F_DUPFD_CLOEXEC, 0)
+        })?;
+        Ok(Socket { fd: fd as i32 })
+    }
+
+    fn recv_with_flags(&self, buf: &mut [u8], flags: usize) -> io::Result<usize> {
+        cvt(unsafe {
+            sysc::syscall6(
+                sysc::RECVFROM,
+                self.fd as usize,
+                buf.as_mut_ptr() as usize,
+                buf.len(),
+                flags,
+                0,
+                0,
+            )
+        })
+    }
+
+    fn read(&self, buf: &mut [u8]) -> io::Result<usize> {
+        self.recv_with_flags(buf, 0)
+    }
+
+    fn read_vectored(&self, bufs: &mut [IoSliceMut<'_>]) -> io::Result<usize> {
+        // `IoSliceMut` is `repr(transparent)` over `iovec`; cap at IOV_MAX.
+        let n = bufs.len().min(IOV_MAX);
+        cvt(unsafe {
+            sysc::syscall3(sysc::READV, self.fd as usize, bufs.as_mut_ptr() as usize, n)
+        })
+    }
+
+    fn write_vectored(&self, bufs: &[IoSlice<'_>]) -> io::Result<usize> {
+        // Safe without MSG_NOSIGNAL because SIGPIPE is ignored process-wide.
+        let n = bufs.len().min(IOV_MAX);
+        cvt(unsafe {
+            sysc::syscall3(sysc::WRITEV, self.fd as usize, bufs.as_ptr() as usize, n)
+        })
+    }
+
+    fn peek(&self, buf: &mut [u8]) -> io::Result<usize> {
+        self.recv_with_flags(buf, MSG_PEEK)
+    }
+
+    fn read_buf(&self, mut cursor: BorrowedCursor<'_>) -> io::Result<()> {
+        let n = cvt(unsafe {
+            let dst = cursor.as_mut().as_mut_ptr() as usize;
+            sysc::syscall6(sysc::RECVFROM, self.fd as usize, dst, cursor.capacity(), 0, 0, 0)
+        })?;
+        unsafe { cursor.advance_unchecked(n) };
+        Ok(())
+    }
+
+    fn recv_from_with_flags(
+        &self,
+        buf: &mut [u8],
+        flags: usize,
+    ) -> io::Result<(usize, SocketAddr)> {
+        let mut storage = [0u8; 28];
+        let mut len = storage.len() as u32;
+        let n = cvt(unsafe {
+            sysc::syscall6(
+                sysc::RECVFROM,
+                self.fd as usize,
+                buf.as_mut_ptr() as usize,
+                buf.len(),
+                flags,
+                storage.as_mut_ptr() as usize,
+                &mut len as *mut u32 as usize,
+            )
+        })?;
+        Ok((n, raw_to_addr(&storage)?))
+    }
+
+    fn write(&self, buf: &[u8]) -> io::Result<usize> {
+        cvt(unsafe {
+            sysc::syscall6(
+                sysc::SENDTO,
+                self.fd as usize,
+                buf.as_ptr() as usize,
+                buf.len(),
+                MSG_NOSIGNAL,
+                0,
+                0,
+            )
+        })
+    }
+
+    fn send_to(&self, buf: &[u8], addr: &SocketAddr) -> io::Result<usize> {
+        let mut raw = [0u8; 28];
+        let len = addr_to_raw(addr, &mut raw);
+        cvt(unsafe {
+            sysc::syscall6(
+                sysc::SENDTO,
+                self.fd as usize,
+                buf.as_ptr() as usize,
+                buf.len(),
+                MSG_NOSIGNAL,
+                raw.as_ptr() as usize,
+                len,
+            )
+        })
+    }
+
+    fn sockname(&self, which: usize) -> io::Result<SocketAddr> {
+        let mut storage = [0u8; 28];
+        let mut len = storage.len() as u32;
+        cvt(unsafe {
+            sysc::syscall3(which, self.fd as usize, storage.as_mut_ptr() as usize, &mut len
+                as *mut u32 as usize)
+        })?;
+        raw_to_addr(&storage)
+    }
+
+    fn shutdown(&self, how: Shutdown) -> io::Result<()> {
+        let how = match how {
+            Shutdown::Read => 0,
+            Shutdown::Write => 1,
+            Shutdown::Both => 2,
+        };
+        cvt(unsafe { sysc::syscall2(sysc::SHUTDOWN, self.fd as usize, how) })?;
+        Ok(())
+    }
+
+    fn set_nonblocking(&self, nonblocking: bool) -> io::Result<()> {
+        let flags = cvt(unsafe { sysc::syscall3(sysc::FCNTL, self.fd as usize, F_GETFL, 0) })?;
+        let new = if nonblocking { flags | O_NONBLOCK } else { flags & !O_NONBLOCK };
+        cvt(unsafe { sysc::syscall3(sysc::FCNTL, self.fd as usize, F_SETFL, new) })?;
+        Ok(())
+    }
+
+    fn set_timeout(&self, dur: Option<Duration>, opt: usize) -> io::Result<()> {
+        let tv: [i64; 2] = match dur {
+            Some(d) => {
+                if d.as_secs() == 0 && d.subsec_nanos() == 0 {
+                    return Err(io::const_error!(
+                        io::ErrorKind::InvalidInput,
+                        "cannot set a 0 duration timeout",
+                    ));
+                }
+                let secs = d.as_secs().min(i64::MAX as u64) as i64;
+                let mut usecs = d.subsec_micros() as i64;
+                // Never round a non-zero timeout down to "no timeout".
+                if secs == 0 && usecs == 0 {
+                    usecs = 1;
+                }
+                [secs, usecs]
+            }
+            None => [0, 0],
+        };
+        self.setsockopt(SOL_SOCKET, opt, tv)
+    }
+
+    fn timeout(&self, opt: usize) -> io::Result<Option<Duration>> {
+        let tv: [i64; 2] = self.getsockopt(SOL_SOCKET, opt)?;
+        if tv[0] == 0 && tv[1] == 0 {
+            Ok(None)
+        } else {
+            Ok(Some(Duration::new(tv[0] as u64, (tv[1] * 1000) as u32)))
+        }
+    }
+
+    fn take_error(&self) -> io::Result<Option<io::Error>> {
+        let err: i32 = self.getsockopt(SOL_SOCKET, SO_ERROR)?;
+        if err == 0 { Ok(None) } else { Ok(Some(io::Error::from_raw_os_error(err))) }
+    }
+}
+
+impl Drop for Socket {
+    fn drop(&mut self) {
+        unsafe {
+            sysc::syscall1(sysc::CLOSE, self.fd as usize);
+        }
+    }
+}
+
+impl fmt::Debug for Socket {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        f.debug_struct("Socket").field("fd", &self.fd).finish()
+    }
+}
+
+// ---------------------------------------------------------------------------
+// TcpStream
+// ---------------------------------------------------------------------------
+
+pub struct TcpStream {
+    inner: Socket,
+}
+
+impl TcpStream {
+    pub fn connect(addr: io::Result<&SocketAddr>) -> io::Result<TcpStream> {
+        let addr = addr?;
+        let sock = Socket::new(addr, SOCK_STREAM)?;
+        sock.connect(addr)?;
+        Ok(TcpStream { inner: sock })
+    }
+
+    pub fn connect_timeout(addr: &SocketAddr, timeout: Duration) -> io::Result<TcpStream> {
+        let sock = Socket::new(addr, SOCK_STREAM)?;
+        sock.connect_timeout(addr, timeout)?;
+        Ok(TcpStream { inner: sock })
+    }
+
+    pub fn set_read_timeout(&self, t: Option<Duration>) -> io::Result<()> {
+        self.inner.set_timeout(t, SO_RCVTIMEO)
+    }
+    pub fn set_write_timeout(&self, t: Option<Duration>) -> io::Result<()> {
+        self.inner.set_timeout(t, SO_SNDTIMEO)
+    }
+    pub fn read_timeout(&self) -> io::Result<Option<Duration>> {
+        self.inner.timeout(SO_RCVTIMEO)
+    }
+    pub fn write_timeout(&self) -> io::Result<Option<Duration>> {
+        self.inner.timeout(SO_SNDTIMEO)
+    }
+    pub fn peek(&self, buf: &mut [u8]) -> io::Result<usize> {
+        self.inner.peek(buf)
+    }
+    pub fn read(&self, buf: &mut [u8]) -> io::Result<usize> {
+        self.inner.read(buf)
+    }
+    pub fn read_buf(&self, cursor: BorrowedCursor<'_>) -> io::Result<()> {
+        self.inner.read_buf(cursor)
+    }
+    pub fn read_vectored(&self, bufs: &mut [IoSliceMut<'_>]) -> io::Result<usize> {
+        self.inner.read_vectored(bufs)
+    }
+    pub fn is_read_vectored(&self) -> bool {
+        true
+    }
+    pub fn write(&self, buf: &[u8]) -> io::Result<usize> {
+        self.inner.write(buf)
+    }
+    pub fn write_vectored(&self, bufs: &[IoSlice<'_>]) -> io::Result<usize> {
+        self.inner.write_vectored(bufs)
+    }
+    pub fn is_write_vectored(&self) -> bool {
+        true
+    }
+    pub fn peer_addr(&self) -> io::Result<SocketAddr> {
+        self.inner.sockname(sysc::GETPEERNAME)
+    }
+    pub fn socket_addr(&self) -> io::Result<SocketAddr> {
+        self.inner.sockname(sysc::GETSOCKNAME)
+    }
+    pub fn shutdown(&self, how: Shutdown) -> io::Result<()> {
+        self.inner.shutdown(how)
+    }
+    pub fn duplicate(&self) -> io::Result<TcpStream> {
+        Ok(TcpStream { inner: self.inner.duplicate()? })
+    }
+    pub fn set_linger(&self, linger: Option<Duration>) -> io::Result<()> {
+        // struct linger { i32 l_onoff; i32 l_linger; }
+        let l: [i32; 2] = match linger {
+            Some(d) => [1, d.as_secs().min(i32::MAX as u64) as i32],
+            None => [0, 0],
+        };
+        self.inner.setsockopt(SOL_SOCKET, SO_LINGER, l)
+    }
+    pub fn linger(&self) -> io::Result<Option<Duration>> {
+        let l: [i32; 2] = self.inner.getsockopt(SOL_SOCKET, SO_LINGER)?;
+        Ok(if l[0] == 0 { None } else { Some(Duration::from_secs(l[1] as u64)) })
+    }
+    pub fn set_nodelay(&self, nodelay: bool) -> io::Result<()> {
+        self.inner.setsockopt(IPPROTO_TCP, TCP_NODELAY, nodelay as i32)
+    }
+    pub fn nodelay(&self) -> io::Result<bool> {
+        let v: i32 = self.inner.getsockopt(IPPROTO_TCP, TCP_NODELAY)?;
+        Ok(v != 0)
+    }
+    pub fn set_ttl(&self, ttl: u32) -> io::Result<()> {
+        self.inner.setsockopt(IPPROTO_IP, IP_TTL, ttl as i32)
+    }
+    pub fn ttl(&self) -> io::Result<u32> {
+        let v: i32 = self.inner.getsockopt(IPPROTO_IP, IP_TTL)?;
+        Ok(v as u32)
+    }
+    pub fn take_error(&self) -> io::Result<Option<io::Error>> {
+        self.inner.take_error()
+    }
+    pub fn set_nonblocking(&self, nonblocking: bool) -> io::Result<()> {
+        self.inner.set_nonblocking(nonblocking)
+    }
+}
+
+impl fmt::Debug for TcpStream {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        f.debug_struct("TcpStream").field("fd", &self.inner.fd).finish()
+    }
+}
+
+// ---------------------------------------------------------------------------
+// TcpListener
+// ---------------------------------------------------------------------------
+
+pub struct TcpListener {
+    inner: Socket,
+}
+
+impl TcpListener {
+    pub fn bind(addr: io::Result<&SocketAddr>) -> io::Result<TcpListener> {
+        let addr = addr?;
+        let sock = Socket::new(addr, SOCK_STREAM)?;
+        // Match the BSD/std default so a restarted listener can rebind promptly.
+        sock.setsockopt(SOL_SOCKET, SO_REUSEADDR, 1i32)?;
+        let mut raw = [0u8; 28];
+        let len = addr_to_raw(addr, &mut raw);
+        cvt(unsafe {
+            sysc::syscall3(sysc::BIND, sock.fd as usize, raw.as_ptr() as usize, len)
+        })?;
+        cvt(unsafe { sysc::syscall2(sysc::LISTEN, sock.fd as usize, 128) })?;
+        Ok(TcpListener { inner: sock })
+    }
+
+    pub fn socket_addr(&self) -> io::Result<SocketAddr> {
+        self.inner.sockname(sysc::GETSOCKNAME)
+    }
+    pub fn accept(&self) -> io::Result<(TcpStream, SocketAddr)> {
+        let (sock, addr) = self.inner.accept()?;
+        Ok((TcpStream { inner: sock }, addr))
+    }
+    pub fn duplicate(&self) -> io::Result<TcpListener> {
+        Ok(TcpListener { inner: self.inner.duplicate()? })
+    }
+    pub fn set_ttl(&self, ttl: u32) -> io::Result<()> {
+        self.inner.setsockopt(IPPROTO_IP, IP_TTL, ttl as i32)
+    }
+    pub fn ttl(&self) -> io::Result<u32> {
+        let v: i32 = self.inner.getsockopt(IPPROTO_IP, IP_TTL)?;
+        Ok(v as u32)
+    }
+    pub fn set_only_v6(&self, only_v6: bool) -> io::Result<()> {
+        self.inner.setsockopt(IPPROTO_IPV6, IPV6_V6ONLY, only_v6 as i32)
+    }
+    pub fn only_v6(&self) -> io::Result<bool> {
+        let v: i32 = self.inner.getsockopt(IPPROTO_IPV6, IPV6_V6ONLY)?;
+        Ok(v != 0)
+    }
+    pub fn take_error(&self) -> io::Result<Option<io::Error>> {
+        self.inner.take_error()
+    }
+    pub fn set_nonblocking(&self, nonblocking: bool) -> io::Result<()> {
+        self.inner.set_nonblocking(nonblocking)
+    }
+}
+
+impl fmt::Debug for TcpListener {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        f.debug_struct("TcpListener").field("fd", &self.inner.fd).finish()
+    }
+}
