+++ b/library/std/src/sys/random/fullrust.rs
@@ -0,0 +1,19 @@
+//! Randomness for the fullrust target: the `getrandom(2)` syscall directly
+//! (no libc). Falls back to a fixed seed only if the syscall is unavailable,
+//! which on any modern Linux kernel does not happen.
+
+use super::super::pal::sysc;
+
+pub fn fill_bytes(mut bytes: &mut [u8]) {
+    while !bytes.is_empty() {
+        let r = unsafe {
+            sysc::syscall3(sysc::GETRANDOM, bytes.as_mut_ptr() as usize, bytes.len(), 0)
+        };
+        match sysc::ret(r) {
+            Ok(0) => break,
+            Ok(n) => bytes = &mut bytes[n..],
+            Err(4) => continue, // EINTR
+            Err(_) => break,
+        }
+    }
+}
