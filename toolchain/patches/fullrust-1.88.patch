index 00000000..0b7c19ae
--- /dev/null
+++ b/library/std/src/sys/thread_local/key/fullrust.rs
@@ -0,0 +1,46 @@
+//! Key-based TLS for the fullrust target.
+//!
+//! There is no libc and (for now) no ELF `#[thread_local]`, so thread-locals are
+//! stored in a global registry keyed by `(thread id, key)`. A `Key` is just a
+//! monotonically increasing id; `set`/`get` look up the current thread's slot.
+//! Destructors are not run at thread exit (the value is leaked) — the common
+//! `FOO.with(..)` access pattern works; this mirrors purestd's approach.
+
+use crate::collections::BTreeMap;
+use crate::sync::Mutex;
+use crate::sync::atomic::{AtomicUsize, Ordering};
+
+pub type Key = usize;
+
+static NEXT_KEY: AtomicUsize = AtomicUsize::new(1); // 0 is KEY_SENTVAL; never hand it out
+static REGISTRY: Mutex<BTreeMap<(u64, Key), usize>> = Mutex::new(BTreeMap::new());
+
+#[inline]
+fn tid() -> u64 {
+    // gettid(2) = 186 on x86-64; returns this thread's kernel id.
+    unsafe { crate::sys::pal::sysc::syscall1(186, 0) as u64 }
+}
+
+#[inline]
+pub fn create(_dtor: Option<unsafe extern "C" fn(*mut u8)>) -> Key {
+    NEXT_KEY.fetch_add(1, Ordering::Relaxed)
+}
+
+#[inline]
+pub unsafe fn set(key: Key, value: *mut u8) {
+    let v = value.expose_provenance();
+    REGISTRY.lock().unwrap().insert((tid(), key), v);
+}
+
+#[inline]
+pub unsafe fn get(key: Key) -> *mut u8 {
+    match REGISTRY.lock().unwrap().get(&(tid(), key)).copied() {
+        Some(v) => crate::ptr::with_exposed_provenance_mut(v),
+        None => crate::ptr::null_mut(),
+    }
+}
+
+#[inline]
+pub unsafe fn destroy(_key: Key) {
+    // Keys are never reused; nothing to free.
+}
