--- /dev/null
+++ b/library/std/src/sys/alloc/fullrust.rs
@@ -0,0 +1,33 @@
+//! Global allocator for the fullrust target.
+//!
+//! This is a thin shim over [`crate::sys::pal::fullrust::heap`], a mimalloc-class
+//! allocator: per-thread heaps reached via `%fs`, 4 MiB segments sliced into
+//! size-class pages, sharded local/cross-thread free lists, and OS purging via
+//! `madvise`/`munmap`. See that module for the design. Free is routed purely by
+//! `Layout`, so there is no per-allocation header.
+
+use super::super::pal::heap;
+use crate::alloc::{GlobalAlloc, Layout, System};
+
+#[stable(feature = "alloc_system_type", since = "1.28.0")]
+unsafe impl GlobalAlloc for System {
+    #[inline]
+    unsafe fn alloc(&self, layout: Layout) -> *mut u8 {
+        unsafe { heap::alloc(layout.size(), layout.align()) }
+    }
+
+    #[inline]
+    unsafe fn alloc_zeroed(&self, layout: Layout) -> *mut u8 {
+        unsafe { heap::alloc_zeroed(layout.size(), layout.align()) }
+    }
+
+    #[inline]
+    unsafe fn dealloc(&self, ptr: *mut u8, layout: Layout) {
+        unsafe { heap::dealloc(ptr, layout.size(), layout.align()) }
+    }
+
+    #[inline]
+    unsafe fn realloc(&self, ptr: *mut u8, layout: Layout, new_size: usize) -> *mut u8 {
+        unsafe { heap::realloc(ptr, layout.size(), layout.align(), new_size) }
+    }
+}
