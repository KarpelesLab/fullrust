new file mode 100644
index 00000000..e5776ab0
--- /dev/null
+++ b/compiler/rustc_target/src/spec/base/fullrust.rs
@@ -0,0 +1,49 @@
+use crate::spec::{Cc, LinkerFlavor, Lld, PanicStrategy, RelocModel, TargetOptions};
+
+/// Base options for the `fullrust` platform: a libc-free, fully-static Linux
+/// ABI target. The kernel interface is plain Linux syscalls (so `llvm_target`
+/// stays `x86_64-unknown-linux-gnu`), but there is **no libc and no C runtime**:
+/// the process entry point (`_start`), the `mem*` intrinsics and the std
+/// platform layer are all provided in-tree by `std::sys::pal::fullrust`
+/// (backed by purestd's raw-syscall code).
+///
+/// `os = "fullrust"` is deliberately a distinct OS rather than `linux` so that
+/// `cfg(unix)` is false and std selects our own pal instead of the libc-based
+/// `unix` one. It is not a member of the `unix` target family.
+pub(crate) fn opts() -> TargetOptions {
+    TargetOptions {
+        os: "fullrust".into(),
+        vendor: "unknown".into(),
+
+        // Libc-free, fully static: no dynamic linking, no C runtime, no PIE,
+        // static relocation model. crt-static is the only mode and is implied.
+        dynamic_linking: false,
+        executables: true,
+        crt_static_allows_dylibs: false,
+        crt_static_default: true,
+        crt_static_respected: true,
+        static_position_independent_executables: false,
+        position_independent_executables: false,
+        relocation_model: RelocModel::Static,
+
+        // No unwinder; panics abort. This removes the landing pads that would
+        // otherwise reference the personality routine.
+        panic_strategy: PanicStrategy::Abort,
+
+        // Native ELF `#[thread_local]` TLS: the pal sets up a `%fs`-based TCB in
+        // `_start` (main thread) and via CLONE_SETTLS (spawned threads), so std
+        // can use the fast single-instruction local-exec TLS model instead of a
+        // key/registry lookup. See `sys::pal::fullrust::tls`.
+        has_thread_local: true,
+
+        max_atomic_width: Some(64),
+
+        // Link with the Rust-bundled LLVM linker, GNU-flavored, invoked
+        // directly (no C compiler driver). No crt objects are linked: `_start`
+        // comes from std's fullrust pal.
+        linker: Some("rust-lld".into()),
+        linker_flavor: LinkerFlavor::Gnu(Cc::No, Lld::Yes),
+
+        ..Default::default()
+    }
+}
