diff --git a/library/std/src/sys/pal/fullrust/common.rs b/library/std/src/sys/pal/fullrust/common.rs
new file mode 100644
index 00000000..cf8c20ca
--- /dev/null
+++ b/library/std/src/sys/pal/fullrust/common.rs
@@ -0,0 +1,50 @@
+use crate::io as std_io;
+
+// Called once by `rt::init` via `sys::init`, with the real argc/argv that the
+// compiler-emitted `main` passed to `lang_start`. We hand them to the args
+// machinery so `std::env::args()` works.
+//
+// SAFETY: must be called only once during runtime initialization.
+pub unsafe fn init(argc: isize, argv: *const *const u8, _sigpipe: u8) {
+    unsafe { crate::sys::args::init(argc, argv) };
+}
+
+// SAFETY: must be called only once during runtime cleanup.
+pub unsafe fn cleanup() {}
+
+pub fn unsupported<T>() -> std_io::Result<T> {
+    Err(unsupported_err())
+}
+
+pub fn unsupported_err() -> std_io::Error {
+    std_io::Error::UNSUPPORTED_PLATFORM
+}
+
+pub fn is_interrupted(code: i32) -> bool {
+    code == 4 // EINTR
+}
+
+pub fn decode_error_kind(code: i32) -> crate::io::ErrorKind {
+    use crate::io::ErrorKind::*;
+    match code {
+        1 | 13 => PermissionDenied,  // EPERM / EACCES
+        2 => NotFound,               // ENOENT
+        4 => Interrupted,            // EINTR
+        11 => WouldBlock,            // EAGAIN
+        17 => AlreadyExists,         // EEXIST
+        21 => IsADirectory,          // EISDIR
+        22 => InvalidInput,          // EINVAL
+        28 => StorageFull,           // ENOSPC
+        32 => BrokenPipe,            // EPIPE
+        110 => TimedOut,             // ETIMEDOUT
+        111 => ConnectionRefused,    // ECONNREFUSED
+        _ => Uncategorized,
+    }
+}
+
+pub fn abort_internal() -> ! {
+    unsafe {
+        super::sysc::syscall1(super::sysc::EXIT_GROUP, 134);
+    }
+    core::intrinsics::abort()
+}
diff --git a/library/std/src/sys/pal/fullrust/futex.rs b/library/std/src/sys/pal/fullrust/futex.rs
new file mode 100644
index 00000000..47cf7101
--- /dev/null
+++ b/library/std/src/sys/pal/fullrust/futex.rs
@@ -0,0 +1,62 @@
+//! Futex primitives on the raw Linux `futex(2)` syscall (private futexes).
+//!
+//! This is the interface std's futex-based Mutex/Condvar/RwLock/Once/Parker are
+//! written against. Mirrors `pal::unix::futex` but calls the syscall directly.
+
+use super::sysc;
+use crate::sync::atomic::Atomic;
+use crate::sync::atomic::Ordering::Relaxed;
+use crate::time::Duration;
+
+/// An atomic for use as a futex that is at least 32-bits but may be larger.
+pub type Futex = Atomic<Primitive>;
+/// Must be the underlying type of Futex.
+pub type Primitive = u32;
+
+/// An atomic for use as a futex that is at least 8-bits but may be larger.
+pub type SmallFutex = Atomic<SmallPrimitive>;
+/// Must be the underlying type of SmallFutex.
+pub type SmallPrimitive = u32;
+
+const SYS_FUTEX: usize = 202;
+const FUTEX_WAIT_PRIVATE: usize = 0 | 128; // FUTEX_WAIT | FUTEX_PRIVATE_FLAG
+const FUTEX_WAKE_PRIVATE: usize = 1 | 128; // FUTEX_WAKE | FUTEX_PRIVATE_FLAG
+
+/// Waits for a `futex_wake` operation to wake us, returning early if the futex
+/// no longer holds `expected`. Returns false on timeout, true otherwise.
+pub fn futex_wait(futex: &Atomic<u32>, expected: u32, timeout: Option<Duration>) -> bool {
+    let ptr = futex as *const Atomic<u32> as usize;
+    // `FUTEX_WAIT` takes a *relative* timeout (timespec), or NULL for forever.
+    let ts = timeout.map(|d| [d.as_secs() as i64, d.subsec_nanos() as i64]);
+    loop {
+        // No need to wait if the value already changed.
+        if futex.load(Relaxed) != expected {
+            return true;
+        }
+        let ts_ptr = ts.as_ref().map_or(0usize, |t| t.as_ptr() as usize);
+        let r = unsafe {
+            sysc::syscall6(SYS_FUTEX, ptr, FUTEX_WAIT_PRIVATE, expected as usize, ts_ptr, 0, 0)
+        };
+        match sysc::ret(r) {
+            Err(110) => return false, // ETIMEDOUT
+            Err(4) => continue,       // EINTR
+            _ => return true,         // woken, or EAGAIN (value changed)
+        }
+    }
+}
+
+/// Wakes one thread blocked on `futex_wait` on this futex. Returns whether a
+/// thread was actually woken.
+pub fn futex_wake(futex: &Atomic<u32>) -> bool {
+    let ptr = futex as *const Atomic<u32> as usize;
+    let r = unsafe { sysc::syscall3(SYS_FUTEX, ptr, FUTEX_WAKE_PRIVATE, 1) };
+    sysc::ret(r).map(|n| n > 0).unwrap_or(false)
+}
+
+/// Wakes all threads blocked on `futex_wait` on this futex.
+pub fn futex_wake_all(futex: &Atomic<u32>) {
+    let ptr = futex as *const Atomic<u32> as usize;
+    unsafe {
+        sysc::syscall3(SYS_FUTEX, ptr, FUTEX_WAKE_PRIVATE, i32::MAX as usize);
+    }
+}
diff --git a/library/std/src/sys/pal/fullrust/heap.rs b/library/std/src/sys/pal/fullrust/heap.rs
new file mode 100644
index 00000000..887454d8
--- /dev/null
+++ b/library/std/src/sys/pal/fullrust/heap.rs
@@ -0,0 +1,815 @@
+//! A mimalloc-class global allocator for the fullrust target.
+//!
+//! The design follows mimalloc's "free-list sharding" model, adapted to a
+//! libc-free Linux target on raw syscalls:
+//!
+//!   * **Per-thread heaps.** Each thread owns a `Heap`, reached in one load off
+//!     the `%fs` TCB (see [`super::tls`]). The hot alloc/free path touches only
+//!     the owning thread's data — no lock, no atomics, no syscall.
+//!
+//!   * **Segments and pages.** Memory comes from 4 MiB, 4 MiB-aligned segments
+//!     (`mmap`). A segment is sliced into 64 KiB *pages*; each page serves a
+//!     single size class. Because segments are aligned, the segment header (and
+//!     thus a block's page) is found from any block pointer by masking — so
+//!     there is **no per-allocation header** and free is routed entirely by the
+//!     caller's `Layout`.
+//!
+//!   * **Sharded free lists.** A page has a `free` list owned exclusively by the
+//!     allocating thread (popped/pushed with no atomics) and an atomic
+//!     `thread_free` list onto which *other* threads push when they free a block
+//!     they don't own. The owner folds `thread_free` into `free` only when its
+//!     local list runs dry — so cross-thread frees never contend the fast path.
+//!
+//!   * **Size classes.** ~36 classes with bounded internal waste: 8 B, then
+//!     16 B-spaced, then four geometric steps per octave up to 8 KiB. Every
+//!     class above the 8 B one is a multiple of 16, so any allocation with
+//!     `align <= 16` is satisfied by class selection alone. Anything larger than
+//!     8 KiB, or with `align > 16`, takes a dedicated page-rounded `mmap`,
+//!     released to the OS on free.
+//!
+//! Memory is returned to the OS when a page empties (`madvise(MADV_FREE)`) and a
+//! fully-empty segment is `munmap`ped, so resident size tracks live bytes.
+
+use super::sysc;
+use super::tls;
+use crate::ptr;
+use crate::sync::atomic::{AtomicBool, AtomicPtr, Ordering};
+
+// --- geometry -------------------------------------------------------------
+
+const SEGMENT_SHIFT: usize = 22;
+const SEGMENT_SIZE: usize = 1 << SEGMENT_SHIFT; // 4 MiB
+const SEGMENT_MASK: usize = SEGMENT_SIZE - 1;
+
+const PAGE_SHIFT: usize = 16;
+const PAGE_SIZE: usize = 1 << PAGE_SHIFT; // 64 KiB
+const PAGES_PER_SEGMENT: usize = SEGMENT_SIZE / PAGE_SIZE; // 64; page 0 is the header
+
+const OS_PAGE: usize = 4096;
+const MAX_SMALL: usize = 8192; // largest size served from pages
+
+/// Size classes (bytes). All but the first are multiples of 16, so an
+/// allocation with `align <= 16` is satisfied by picking a class `>= max(size,
+/// align)` rounded to `align`.
+const CLASS_SIZES: [u32; 36] = [
+    8, 16, 24, 32, 40, 48, 56, 64, 80, 96, 112, 128, 160, 192, 224, 256, 320, 384, 448, 512, 640,
+    768, 896, 1024, 1280, 1536, 1792, 2048, 2560, 3072, 3584, 4096, 5120, 6144, 7168, 8192,
+];
+const NUM_CLASSES: usize = CLASS_SIZES.len();
+const IDX_LEN: usize = MAX_SMALL / 8; // 1024
+
+/// `IDX[(need - 1) >> 3]` is the index of the smallest class `>= need`, for
+/// `1 <= need <= MAX_SMALL`. Built so the whole `[need-7 ..= need]` bucket maps
+/// to a class large enough for the bucket's top.
+const IDX: [u8; IDX_LEN] = build_idx();
+
+const fn build_idx() -> [u8; IDX_LEN] {
+    let mut t = [0u8; IDX_LEN];
+    let mut b = 0;
+    while b < IDX_LEN {
+        let target = (b + 1) * 8;
+        let mut i = 0;
+        while i < NUM_CLASSES {
+            if CLASS_SIZES[i] as usize >= target {
+                break;
+            }
+            i += 1;
+        }
+        t[b] = i as u8;
+        b += 1;
+    }
+    t
+}
+
+#[inline]
+fn round_up(v: usize, to: usize) -> usize {
+    (v + to - 1) & !(to - 1)
+}
+
+/// Class index for an already-`need`-rounded request, `need <= MAX_SMALL`.
+#[inline]
+fn class_of(need: usize) -> usize {
+    IDX[(need - 1) >> 3] as usize
+}
+
+// --- raw OS memory --------------------------------------------------------
+
+#[inline]
+fn os_mmap(len: usize) -> *mut u8 {
+    let r = unsafe {
+        sysc::syscall6(
+            sysc::MMAP,
+            0,
+            len,
+            sysc::PROT_READ | sysc::PROT_WRITE,
+            sysc::MAP_PRIVATE | sysc::MAP_ANONYMOUS,
+            usize::MAX, // fd = -1
+            0,
+        )
+    };
+    match sysc::ret(r) {
+        Ok(p) => ptr::with_exposed_provenance_mut(p),
+        Err(_) => ptr::null_mut(),
+    }
+}
+
+#[inline]
+unsafe fn os_munmap(addr: usize, len: usize) {
+    unsafe {
+        sysc::syscall2(sysc::MUNMAP, addr, len);
+    }
+}
+
+#[inline]
+unsafe fn os_madvise(addr: usize, len: usize, advice: usize) {
+    unsafe {
+        sysc::syscall3(sysc::MADVISE, addr, len, advice);
+    }
+}
+
+/// Map a fresh 4 MiB segment aligned to its size (over-map by one segment, then
+/// trim the head and tail). Returns the aligned base, or null.
+fn os_alloc_segment() -> *mut u8 {
+    let over = SEGMENT_SIZE * 2;
+    let raw = os_mmap(over);
+    if raw.is_null() {
+        return ptr::null_mut();
+    }
+    let raw_addr = raw.addr();
+    let base_addr = round_up(raw_addr, SEGMENT_SIZE);
+    // Trim the unaligned head and the leftover tail back to the OS.
+    if base_addr > raw_addr {
+        unsafe { os_munmap(raw_addr, base_addr - raw_addr) };
+    }
+    let tail = base_addr + SEGMENT_SIZE;
+    let end = raw_addr + over;
+    if end > tail {
+        unsafe { os_munmap(tail, end - tail) };
+    }
+    ptr::with_exposed_provenance_mut(base_addr)
+}
+
+// --- data structures ------------------------------------------------------
+
+/// A free block: when on a free list, its first word is the next pointer.
+#[repr(C)]
+struct Block {
+    next: *mut Block,
+}
+
+/// Per-page metadata, stored in the owning segment's header (never in the page's
+/// own data area, which stays fully usable).
+#[repr(C)]
+struct Page {
+    /// Owner-thread free list (no atomics).
+    free: *mut Block,
+    /// Cross-thread free list: other threads push here atomically.
+    thread_free: AtomicPtr<Block>,
+    /// Bump pointer for never-yet-allocated blocks in this page.
+    bump: *mut u8,
+    /// End of this page's data area.
+    bump_end: *mut u8,
+    /// Outstanding blocks (handed out, not yet freed/collected). `0` ⟹ empty.
+    used: u32,
+    /// Size class in bytes, or `0` for an unused page slot.
+    block_size: u32,
+    /// Links within the owning heap's per-class page list.
+    next: *mut Page,
+    prev: *mut Page,
+}
+
+/// A 4 MiB segment header (at the segment base). `pages[0]`'s data area holds
+/// this header; usable pages are `1..PAGES_PER_SEGMENT`.
+#[repr(C)]
+struct Segment {
+    /// Owning heap, or null while abandoned. Atomic so a cross-thread freer can
+    /// read it while the owner publishes/abandons.
+    owner: AtomicPtr<Heap>,
+    /// Pages with `used > 0`. When this hits 0 the segment is fully free.
+    used_pages: u32,
+    /// Link in the owning heap's segment list.
+    next: *mut Segment,
+    prev: *mut Segment,
+    /// Link in the global abandoned-segment stack.
+    abandoned_next: *mut Segment,
+    pages: [Page; PAGES_PER_SEGMENT],
+}
+
+/// A per-thread heap: the head of a per-class page list, plus the owned
+/// segments. Created lazily on first allocation and reached via `%fs`.
+#[repr(C)]
+struct Heap {
+    /// Head page per size class (allocation tries this first).
+    active: [*mut Page; NUM_CLASSES],
+    /// Owned segments (doubly linked for O(1) unlink on free-to-OS).
+    segments: *mut Segment,
+}
+
+// --- segment / page helpers ----------------------------------------------
+
+#[inline]
+fn segment_of(block: *mut u8) -> *mut Segment {
+    ptr::with_exposed_provenance_mut(block.addr() & !SEGMENT_MASK)
+}
+
+#[inline]
+fn page_index(seg: *mut Segment, block: *mut u8) -> usize {
+    (block.addr() - (seg as *mut u8).addr()) >> PAGE_SHIFT
+}
+
+/// Data area base of page `i` within `seg`.
+#[inline]
+fn page_data(seg: *mut Segment, i: usize) -> *mut u8 {
+    ptr::with_exposed_provenance_mut((seg as *mut u8).addr() + i * PAGE_SIZE)
+}
+
+// --- the global allocator -------------------------------------------------
+
+/// Spinlock guarding the global abandoned-segment stack (touched only on thread
+/// exit and segment reclaim, both rare).
+static ABANDON_LOCK: AtomicBool = AtomicBool::new(false);
+static ABANDONED: AtomicPtr<Segment> = AtomicPtr::new(ptr::null_mut());
+
+#[inline]
+fn lock_abandon() {
+    while ABANDON_LOCK
+        .compare_exchange_weak(false, true, Ordering::Acquire, Ordering::Relaxed)
+        .is_err()
+    {
+        core::hint::spin_loop();
+    }
+}
+#[inline]
+fn unlock_abandon() {
+    ABANDON_LOCK.store(false, Ordering::Release);
+}
+
+/// Return this thread's heap, creating it (from raw `mmap`, never the global
+/// allocator) on first use.
+#[inline]
+fn heap() -> *mut Heap {
+    let h = tls::heap() as *mut Heap;
+    if !h.is_null() { h } else { heap_init() }
+}
+
+#[cold]
+fn heap_init() -> *mut Heap {
+    // One OS page holds the Heap struct; it is zero from a fresh mapping, so all
+    // `active` heads and `segments` start null.
+    let mem = os_mmap(round_up(core::mem::size_of::<Heap>(), OS_PAGE));
+    if mem.is_null() {
+        return ptr::null_mut();
+    }
+    let h = mem as *mut Heap;
+    tls::set_heap(h as *mut u8);
+    h
+}
+
+/// Pop one block from a page, folding in cross-thread frees and bumping a fresh
+/// block as needed. Returns null if the page is full.
+#[inline]
+unsafe fn page_alloc(p: *mut Page) -> *mut u8 {
+    let page = unsafe { &mut *p };
+    // Fast path: local free list.
+    let b = page.free;
+    if !b.is_null() {
+        page.free = unsafe { (*b).next };
+        page.used += 1;
+        return b as *mut u8;
+    }
+    // Local list empty: adopt any cross-thread frees.
+    let tf = page.thread_free.swap(ptr::null_mut(), Ordering::Acquire);
+    if !tf.is_null() {
+        // Count the adopted chain so `used` stays exact (those blocks were
+        // handed out but their frees haven't been subtracted yet).
+        let mut n: u32 = 0;
+        let mut node = tf;
+        while !node.is_null() {
+            n += 1;
+            node = unsafe { (*node).next };
+        }
+        page.used -= n;
+        let head = tf;
+        page.free = unsafe { (*head).next };
+        page.used += 1;
+        return head as *mut u8;
+    }
+    // Nothing freed: hand out a never-used block.
+    if page.bump.addr() < page.bump_end.addr() {
+        let b = page.bump;
+        page.bump = unsafe { page.bump.add(page.block_size as usize) };
+        page.used += 1;
+        return b;
+    }
+    ptr::null_mut()
+}
+
+/// Find a usable page slot in `h`'s segments (or a reclaimed/new segment) and
+/// initialize it for `class`, linking it as the head of the class list.
+#[cold]
+unsafe fn heap_alloc_page(h: *mut Heap, class: usize) -> *mut Page {
+    let heap = unsafe { &mut *h };
+    let bsize = CLASS_SIZES[class];
+
+    loop {
+        // Look for a free page slot (block_size == 0) in an owned segment. A
+        // reclaimed segment may have *live* pages re-queued at any slot, so we
+        // must take a genuinely free slot rather than assuming slot 1.
+        let mut seg = heap.segments;
+        while !seg.is_null() {
+            let s = unsafe { &mut *seg };
+            let mut i = 1;
+            while i < PAGES_PER_SEGMENT {
+                if s.pages[i].block_size == 0 {
+                    return unsafe { init_page(seg, i, class, bsize, h) };
+                }
+                i += 1;
+            }
+            seg = s.next;
+        }
+
+        // No free slot anywhere: adopt an abandoned segment, else map a new one.
+        // Both link the segment into `heap.segments`; loop back to claim a slot
+        // in it (a reclaimed segment can be full, in which case we try again).
+        let seg = unsafe { reclaim_segment(h) };
+        if seg.is_null() {
+            let seg = unsafe { new_segment(h) };
+            if seg.is_null() {
+                return ptr::null_mut();
+            }
+        }
+    }
+}
+
+/// Initialize page slot `i` of `seg` for `class` and push it to the head of the
+/// owning heap's class list.
+#[inline]
+unsafe fn init_page(
+    seg: *mut Segment,
+    i: usize,
+    class: usize,
+    bsize: u32,
+    h: *mut Heap,
+) -> *mut Page {
+    let s = unsafe { &mut *seg };
+    let data = page_data(seg, i);
+    let pg = &mut s.pages[i] as *mut Page;
+    let page = unsafe { &mut *pg };
+    page.free = ptr::null_mut();
+    page.thread_free = AtomicPtr::new(ptr::null_mut());
+    page.bump = data;
+    // Whole-number block count for this page.
+    let blocks = PAGE_SIZE / bsize as usize;
+    page.bump_end = unsafe { data.add(blocks * bsize as usize) };
+    page.used = 0;
+    page.block_size = bsize;
+    s.used_pages += 1;
+
+    // Push to the head of the class list.
+    let heap = unsafe { &mut *h };
+    page.prev = ptr::null_mut();
+    page.next = heap.active[class];
+    if !page.next.is_null() {
+        unsafe { (*page.next).prev = pg };
+    }
+    heap.active[class] = pg;
+    pg
+}
+
+/// Map and register a new segment owned by `h`.
+#[cold]
+unsafe fn new_segment(h: *mut Heap) -> *mut Segment {
+    let base = os_alloc_segment();
+    if base.is_null() {
+        return ptr::null_mut();
+    }
+    // Fresh mapping is zero: all Page fields, used_pages, links start cleared.
+    let seg = base as *mut Segment;
+    let s = unsafe { &mut *seg };
+    s.owner = AtomicPtr::new(h);
+    s.used_pages = 0;
+    s.abandoned_next = ptr::null_mut();
+    // Link into the heap's segment list.
+    let heap = unsafe { &mut *h };
+    s.prev = ptr::null_mut();
+    s.next = heap.segments;
+    if !s.next.is_null() {
+        unsafe { (*s.next).prev = seg };
+    }
+    heap.segments = seg;
+    seg
+}
+
+/// Try to take an abandoned segment off the global stack and adopt it into `h`:
+/// re-own it, re-queue its live pages, and fold in any cross-thread frees.
+#[cold]
+unsafe fn reclaim_segment(h: *mut Heap) -> *mut Segment {
+    lock_abandon();
+    let seg = ABANDONED.load(Ordering::Acquire);
+    if seg.is_null() {
+        unlock_abandon();
+        return ptr::null_mut();
+    }
+    let s = unsafe { &mut *seg };
+    ABANDONED.store(s.abandoned_next, Ordering::Release);
+    unlock_abandon();
+
+    s.abandoned_next = ptr::null_mut();
+    s.owner.store(h, Ordering::Release);
+
+    // Re-queue every live page into this heap's class lists and recount.
+    let heap = unsafe { &mut *h };
+    s.used_pages = 0;
+    let mut i = 1;
+    while i < PAGES_PER_SEGMENT {
+        let pg = &mut s.pages[i] as *mut Page;
+        let page = unsafe { &mut *pg };
+        if page.block_size != 0 {
+            // Fold cross-thread frees collected while abandoned.
+            let tf = page.thread_free.swap(ptr::null_mut(), Ordering::Acquire);
+            if !tf.is_null() {
+                let mut n: u32 = 0;
+                let mut node = tf;
+                let mut last = tf;
+                while !node.is_null() {
+                    n += 1;
+                    last = node;
+                    node = unsafe { (*node).next };
+                }
+                page.used -= n;
+                unsafe { (*last).next = page.free };
+                page.free = tf;
+            }
+            if page.used == 0 {
+                // Became fully free while abandoned: reset to an empty slot.
+                page.block_size = 0;
+                page.free = ptr::null_mut();
+            } else {
+                s.used_pages += 1;
+                let class = class_of(page.block_size as usize);
+                page.prev = ptr::null_mut();
+                page.next = heap.active[class];
+                if !page.next.is_null() {
+                    unsafe { (*page.next).prev = pg };
+                }
+                heap.active[class] = pg;
+            }
+        }
+        i += 1;
+    }
+
+    // Link the segment into the heap.
+    s.prev = ptr::null_mut();
+    s.next = heap.segments;
+    if !s.next.is_null() {
+        unsafe { (*s.next).prev = seg };
+    }
+    heap.segments = seg;
+    seg
+}
+
+/// Small (page-served) allocation for `class`.
+#[inline]
+unsafe fn alloc_small(class: usize) -> *mut u8 {
+    let h = heap();
+    if h.is_null() {
+        return ptr::null_mut();
+    }
+    let heap = unsafe { &mut *h };
+
+    // Try the active page for this class.
+    let head = heap.active[class];
+    if !head.is_null() {
+        let b = unsafe { page_alloc(head) };
+        if !b.is_null() {
+            return b;
+        }
+        // Active page full: scan the class list for one with space (folding in
+        // cross-thread frees), and promote it to the head.
+        let mut p = unsafe { (*head).next };
+        while !p.is_null() {
+            let b = unsafe { page_alloc(p) };
+            if !b.is_null() {
+                unsafe { promote(heap, class, p) };
+                return b;
+            }
+            p = unsafe { (*p).next };
+        }
+    }
+
+    // No page with space: get a fresh one.
+    let pg = unsafe { heap_alloc_page(h, class) };
+    if pg.is_null() {
+        return ptr::null_mut();
+    }
+    unsafe { page_alloc(pg) }
+}
+
+/// Move page `p` to the head of its class list.
+#[inline]
+unsafe fn promote(heap: &mut Heap, class: usize, p: *mut Page) {
+    if heap.active[class] == p {
+        return;
+    }
+    let page = unsafe { &mut *p };
+    // Unlink.
+    if !page.prev.is_null() {
+        unsafe { (*page.prev).next = page.next };
+    }
+    if !page.next.is_null() {
+        unsafe { (*page.next).prev = page.prev };
+    }
+    // Push front.
+    page.prev = ptr::null_mut();
+    page.next = heap.active[class];
+    if !page.next.is_null() {
+        unsafe { (*page.next).prev = p };
+    }
+    heap.active[class] = p;
+}
+
+/// Free a small (page-served) block back to its page.
+#[inline]
+unsafe fn free_small(block: *mut u8) {
+    let seg = segment_of(block);
+    let i = page_index(seg, block);
+    let s = unsafe { &mut *seg };
+    let pg = &mut s.pages[i] as *mut Page;
+
+    // Integrity check (debug only, zero release cost): the freed pointer must
+    // land on its page's current size-class grid. A miss means a double free, a
+    // free of a foreign/stale pointer, or a use-after-free — fail loudly here
+    // rather than corrupt the heap. (Caught the segment-reuse bug during bring-up.)
+    #[cfg(debug_assertions)]
+    {
+        let page = unsafe { &*pg };
+        let data = page_data(seg, i);
+        let off = block.addr().wrapping_sub(data.addr());
+        debug_assert!(
+            page.block_size != 0
+                && off < PAGE_SIZE
+                && off % page.block_size as usize == 0,
+            "invalid free: pointer not on its page's size-class grid",
+        );
+    }
+
+    let owner = s.owner.load(Ordering::Relaxed);
+    let me = tls::heap() as *mut Heap;
+    if owner == me && !owner.is_null() {
+        // Owner-thread free: push to the local free list, no atomics.
+        let page = unsafe { &mut *pg };
+        let b = block as *mut Block;
+        unsafe { (*b).next = page.free };
+        page.free = b;
+        page.used -= 1;
+        if page.used == 0 {
+            unsafe { retire_page(seg, i) };
+        }
+    } else {
+        // Cross-thread (or abandoned-segment) free: push atomically.
+        let page = unsafe { &*pg };
+        let b = block as *mut Block;
+        let mut head = page.thread_free.load(Ordering::Relaxed);
+        loop {
+            unsafe { (*b).next = head };
+            match page.thread_free.compare_exchange_weak(
+                head,
+                b,
+                Ordering::Release,
+                Ordering::Relaxed,
+            ) {
+                Ok(_) => break,
+                Err(h) => head = h,
+            }
+        }
+    }
+}
+
+/// A page just emptied (owner thread): drop its physical pages and mark the slot
+/// reusable; if its segment is now fully empty, return the whole segment.
+#[cold]
+unsafe fn retire_page(seg: *mut Segment, i: usize) {
+    let s = unsafe { &mut *seg };
+    let pg = &mut s.pages[i];
+    // Reset to an empty, reusable slot.
+    let class = class_of(pg.block_size as usize);
+    // Unlink from the class list.
+    let me = s.owner.load(Ordering::Relaxed);
+    if !me.is_null() {
+        let heap = unsafe { &mut *me };
+        if heap.active[class] == (pg as *mut Page) {
+            heap.active[class] = pg.next;
+        }
+        if !pg.prev.is_null() {
+            unsafe { (*pg.prev).next = pg.next };
+        }
+        if !pg.next.is_null() {
+            unsafe { (*pg.next).prev = pg.prev };
+        }
+    }
+    pg.next = ptr::null_mut();
+    pg.prev = ptr::null_mut();
+    pg.free = ptr::null_mut();
+    pg.block_size = 0;
+    // Drop the page's physical memory; the virtual range stays mapped for reuse.
+    let data = page_data(seg, i);
+    unsafe { os_madvise(data.addr(), PAGE_SIZE, sysc::MADV_FREE) };
+
+    s.used_pages -= 1;
+    if s.used_pages == 0 {
+        unsafe { free_segment(seg) };
+    }
+}
+
+/// Unlink a fully-empty segment from its heap and return it to the OS.
+#[cold]
+unsafe fn free_segment(seg: *mut Segment) {
+    let s = unsafe { &mut *seg };
+    let owner = s.owner.load(Ordering::Relaxed);
+    if !owner.is_null() {
+        let heap = unsafe { &mut *owner };
+        if heap.segments == seg {
+            heap.segments = s.next;
+        }
+        if !s.prev.is_null() {
+            unsafe { (*s.prev).next = s.next };
+        }
+        if !s.next.is_null() {
+            unsafe { (*s.next).prev = s.prev };
+        }
+    }
+    unsafe { os_munmap((seg as *mut u8).addr(), SEGMENT_SIZE) };
+}
+
+// --- huge (dedicated mmap) path ------------------------------------------
+
+/// Length of the dedicated mapping backing a huge/over-aligned allocation of
+/// `layout`. Recomputable from the `Layout` alone, so free needs no header.
+#[inline]
+fn huge_len(size: usize) -> usize {
+    round_up(size.max(1), OS_PAGE)
+}
+
+#[inline]
+unsafe fn alloc_huge(size: usize, align: usize) -> *mut u8 {
+    let len = huge_len(size);
+    if align <= OS_PAGE {
+        // mmap is already page-aligned, which covers any align up to a page.
+        os_mmap(len)
+    } else {
+        // Over-map and trim to an `align`-aligned region of exactly `len`.
+        let over = len + align;
+        let raw = os_mmap(over);
+        if raw.is_null() {
+            return ptr::null_mut();
+        }
+        let raw_addr = raw.addr();
+        let base = round_up(raw_addr, align);
+        if base > raw_addr {
+            unsafe { os_munmap(raw_addr, base - raw_addr) };
+        }
+        let end = raw_addr + over;
+        let tail = base + len;
+        if end > tail {
+            unsafe { os_munmap(tail, end - tail) };
+        }
+        ptr::with_exposed_provenance_mut(base)
+    }
+}
+
+#[inline]
+unsafe fn free_huge(ptr: *mut u8, size: usize) {
+    unsafe { os_munmap(ptr.addr(), huge_len(size)) };
+}
+
+// --- public entry points (called by the GlobalAlloc impl) -----------------
+
+/// Route by `Layout`: small page-served, or huge/over-aligned dedicated mmap.
+#[inline]
+fn need_of(size: usize, align: usize) -> usize {
+    round_up(size.max(1), align.max(1))
+}
+
+#[inline]
+pub unsafe fn alloc(size: usize, align: usize) -> *mut u8 {
+    if align <= 16 {
+        let need = need_of(size, align);
+        if need <= MAX_SMALL {
+            return unsafe { alloc_small(class_of(need)) };
+        }
+    }
+    unsafe { alloc_huge(size, align) }
+}
+
+#[inline]
+pub unsafe fn alloc_zeroed(size: usize, align: usize) -> *mut u8 {
+    if align <= 16 {
+        let need = need_of(size, align);
+        if need <= MAX_SMALL {
+            let p = unsafe { alloc_small(class_of(need)) };
+            if !p.is_null() {
+                unsafe { ptr::write_bytes(p, 0, size) };
+            }
+            return p;
+        }
+    }
+    // Huge path is a fresh mmap, already zero.
+    unsafe { alloc_huge(size, align) }
+}
+
+#[inline]
+pub unsafe fn dealloc(ptr: *mut u8, size: usize, align: usize) {
+    if ptr.is_null() {
+        return;
+    }
+    if align <= 16 && need_of(size, align) <= MAX_SMALL {
+        unsafe { free_small(ptr) };
+    } else {
+        unsafe { free_huge(ptr, size) };
+    }
+}
+
+#[inline]
+pub unsafe fn realloc(ptr: *mut u8, old_size: usize, align: usize, new_size: usize) -> *mut u8 {
+    // In-place when old and new map to the same small size class.
+    if align <= 16 {
+        let on = need_of(old_size, align);
+        let nn = need_of(new_size, align);
+        if on <= MAX_SMALL && nn <= MAX_SMALL && class_of(on) == class_of(nn) {
+            return ptr;
+        }
+    }
+    let new = unsafe { alloc(new_size, align) };
+    if new.is_null() {
+        return ptr::null_mut();
+    }
+    let n = if old_size < new_size { old_size } else { new_size };
+    unsafe { ptr::copy_nonoverlapping(ptr, new, n) };
+    unsafe { dealloc(ptr, old_size, align) };
+    new
+}
+
+/// Tear down the calling thread's heap at thread exit: fold pending cross-thread
+/// frees, return fully-empty segments to the OS, and abandon the rest for other
+/// threads to reclaim. The `Heap` struct itself is then unmapped.
+pub unsafe fn thread_exit() {
+    let h = tls::heap() as *mut Heap;
+    if h.is_null() {
+        return;
+    }
+    let heap = unsafe { &mut *h };
+
+    let mut seg = heap.segments;
+    while !seg.is_null() {
+        let s = unsafe { &mut *seg };
+        let next = s.next;
+
+        // Recount live pages after folding in cross-thread frees.
+        let mut live = 0u32;
+        let mut i = 1;
+        while i < PAGES_PER_SEGMENT {
+            let pg = &mut s.pages[i];
+            if pg.block_size != 0 {
+                let tf = pg.thread_free.swap(ptr::null_mut(), Ordering::Acquire);
+                if !tf.is_null() {
+                    let mut n: u32 = 0;
+                    let mut node = tf;
+                    let mut last = tf;
+                    while !node.is_null() {
+                        n += 1;
+                        last = node;
+                        node = unsafe { (*node).next };
+                    }
+                    pg.used -= n;
+                    unsafe { (*last).next = pg.free };
+                    pg.free = tf;
+                }
+                if pg.used == 0 {
+                    pg.block_size = 0;
+                } else {
+                    live += 1;
+                }
+            }
+            i += 1;
+        }
+        s.used_pages = live;
+
+        if live == 0 {
+            unsafe { os_munmap((seg as *mut u8).addr(), SEGMENT_SIZE) };
+        } else {
+            // Abandon: clear owner, push onto the global stack.
+            s.owner.store(ptr::null_mut(), Ordering::Release);
+            s.next = ptr::null_mut();
+            s.prev = ptr::null_mut();
+            lock_abandon();
+            s.abandoned_next = ABANDONED.load(Ordering::Acquire);
+            ABANDONED.store(seg, Ordering::Release);
+            unlock_abandon();
+        }
+        seg = next;
+    }
+
+    // Free the Heap struct and clear the TLS slot.
+    unsafe { os_munmap(h.addr(), round_up(core::mem::size_of::<Heap>(), OS_PAGE)) };
+    tls::set_heap(ptr::null_mut());
+}
diff --git a/library/std/src/sys/pal/fullrust/mod.rs b/library/std/src/sys/pal/fullrust/mod.rs
new file mode 100644
index 00000000..87cf7db7
--- /dev/null
+++ b/library/std/src/sys/pal/fullrust/mod.rs
@@ -0,0 +1,158 @@
+//! The `fullrust` platform abstraction layer: libc-free Linux on raw syscalls.
+//!
+//! This pal provides what a hosted std gets from libc + crt0: the process entry
+//! point (`_start`), process control, time, and the syscall wrappers the other
+//! `sys` modules build on. The kernel ABI is plain Linux x86-64 `syscall`; there
+//! is no C runtime. Ported from purestd's raw-syscall layer, inlined here so std
+//! stays self-contained.
+
+#![deny(unsafe_op_in_unsafe_fn)]
+
+pub mod futex;
+pub mod heap;
+pub mod os;
+pub mod pipe;
+pub mod thread;
+pub mod time;
+pub mod tls;
+
+mod common;
+pub use common::*;
+
+// ---------------------------------------------------------------------------
+// Raw syscall layer (x86-64). Number in rax; args rdi, rsi, rdx, r10, r8, r9;
+// result in rax; -errno in [-4095, -1].
+// ---------------------------------------------------------------------------
+pub mod sysc {
+    use core::arch::asm;
+
+    #[inline]
+    pub unsafe fn syscall1(n: usize, a: usize) -> usize {
+        let r;
+        unsafe {
+            asm!("syscall", inlateout("rax") n => r, in("rdi") a,
+                 lateout("rcx") _, lateout("r11") _, options(nostack, preserves_flags));
+        }
+        r
+    }
+    #[inline]
+    pub unsafe fn syscall2(n: usize, a: usize, b: usize) -> usize {
+        let r;
+        unsafe {
+            asm!("syscall", inlateout("rax") n => r, in("rdi") a, in("rsi") b,
+                 lateout("rcx") _, lateout("r11") _, options(nostack, preserves_flags));
+        }
+        r
+    }
+    #[inline]
+    pub unsafe fn syscall3(n: usize, a: usize, b: usize, c: usize) -> usize {
+        let r;
+        unsafe {
+            asm!("syscall", inlateout("rax") n => r, in("rdi") a, in("rsi") b, in("rdx") c,
+                 lateout("rcx") _, lateout("r11") _, options(nostack, preserves_flags));
+        }
+        r
+    }
+    #[inline]
+    pub unsafe fn syscall6(
+        n: usize, a: usize, b: usize, c: usize, d: usize, e: usize, f: usize,
+    ) -> usize {
+        let r;
+        unsafe {
+            asm!("syscall", inlateout("rax") n => r, in("rdi") a, in("rsi") b, in("rdx") c,
+                 in("r10") d, in("r8") e, in("r9") f,
+                 lateout("rcx") _, lateout("r11") _, options(nostack, preserves_flags));
+        }
+        r
+    }
+
+    pub const READ: usize = 0;
+    pub const WRITE: usize = 1;
+    pub const GETPID: usize = 39;
+    pub const EXIT_GROUP: usize = 231;
+    pub const CLOCK_GETTIME: usize = 228;
+    pub const GETRANDOM: usize = 318;
+    pub const SCHED_YIELD: usize = 24;
+    pub const NANOSLEEP: usize = 35;
+    pub const MMAP: usize = 9;
+    pub const MUNMAP: usize = 11;
+    pub const MADVISE: usize = 28;
+
+    pub const PROT_READ: usize = 0x1;
+    pub const PROT_WRITE: usize = 0x2;
+    pub const MAP_PRIVATE: usize = 0x2;
+    pub const MAP_ANONYMOUS: usize = 0x20;
+
+    // madvise(2) advice values.
+    #[allow(dead_code)]
+    pub const MADV_DONTNEED: usize = 4;
+    pub const MADV_FREE: usize = 8;
+
+    /// Interpret a raw return as `Result<usize, i32>` (Err is the errno).
+    #[inline]
+    pub fn ret(r: usize) -> Result<usize, i32> {
+        let s = r as isize;
+        if (-4095..0).contains(&s) { Err(-s as i32) } else { Ok(r) }
+    }
+}
+
+// ---------------------------------------------------------------------------
+// Process entry point. The kernel jumps here with rsp at argc; there is no
+// return address and no C runtime. We call the compiler-emitted C `main`, which
+// drives `lang_start` -> `rt::init` (capturing argc/argv) -> user `fn main`.
+// When it returns, exit_group with its code.
+// ---------------------------------------------------------------------------
+unsafe extern "C" {
+    // The C `main` shim the compiler emits for `fn main`: it calls
+    // `lang_start(user_main, argc, argv, sigpipe)`.
+    fn main(argc: core::ffi::c_int, argv: *const *const u8) -> core::ffi::c_int;
+}
+
+#[unsafe(naked)]
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn _start() -> ! {
+    core::arch::naked_asm!(
+        "xor rbp, rbp",
+        "mov rdi, rsp", // pointer to argc
+        "and rsp, -16", // ABI stack alignment
+        "call {start}",
+        start = sym rust_start,
+    )
+}
+
+unsafe extern "C" fn rust_start(stack: *const usize) -> ! {
+    // [argc][argv0..argv(argc-1)][NULL][envp0..][NULL][auxv...]
+    // Install native `%fs` thread-local storage for the main thread *first*:
+    // it parses the auxv that follows envp, and everything below (the allocator,
+    // any `#[thread_local]`) depends on `%fs` already pointing at a valid TCB.
+    unsafe { tls::init_main(stack) };
+    let argc = unsafe { *stack } as core::ffi::c_int;
+    let argv = unsafe { stack.add(1) } as *const *const u8;
+    let code = unsafe { main(argc, argv) };
+    // Run the main thread's `#[thread_local]` destructors and per-thread runtime
+    // cleanup before exiting (fullrust's `guard::enable` is a no-op, so std
+    // relies on the pal to invoke these — same as hermit's entry).
+    unsafe {
+        crate::sys::thread_local::destructors::run();
+    }
+    crate::rt::thread_cleanup();
+    os::exit(code as i32)
+}
+
+// ---------------------------------------------------------------------------
+// Symbols the toolchain expects from the environment that neither libc (absent)
+// nor compiler_builtins provide. `compiler-builtins-mem` supplies the `mem*`
+// intrinsics; `strlen` is not among them, and core's `CStr::from_ptr` (used to
+// decode argv/envp) calls it.
+// ---------------------------------------------------------------------------
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn strlen(s: *const core::ffi::c_char) -> usize {
+    let mut n = 0;
+    // SAFETY: `s` points to a NUL-terminated C string (caller contract).
+    unsafe {
+        while *s.add(n) != 0 {
+            n += 1;
+        }
+    }
+    n
+}
