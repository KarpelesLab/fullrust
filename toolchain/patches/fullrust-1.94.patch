+use crate::io;
+use crate::sys::pal::fd::FileDesc;
+use crate::sys::pal::pipe::pipe as pal_pipe;
+use crate::sys::IntoInner;
+
+// A `std::io::pipe` end is just an owned fd. Backing it with `FileDesc` (which
+// wraps `OwnedFd`) gives `PipeReader`/`PipeWriter` the full `os::fd` interop —
+// `as_fd()`, `as_raw_fd()`, `From<OwnedFd>` — exactly as on unix.
+pub type Pipe = FileDesc;
+
+#[inline]
+pub fn pipe() -> io::Result<(Pipe, Pipe)> {
+    // Reuse the pal's `pipe2(O_CLOEXEC)` and unwrap each end to its `FileDesc`.
+    pal_pipe().map(|(rx, wx)| (rx.into_inner(), wx.into_inner()))
+}
