--- /dev/null
+++ b/library/std/src/sys/thread/fullrust.rs
@@ -0,0 +1,277 @@
+//! Native threads for the `fullrust` target.
+//!
+//! In Rust 1.91 the per-OS `Thread` implementation moved out of the platform
+//! abstraction layer (`sys::pal::<os>::thread`) into this top-level `sys::thread`
+//! module, with `sleep`/`yield_now`/`set_name`/`current_os_id`/
+//! `available_parallelism` exposed as free functions (see `sys::thread::unix`).
+//! This is the libc-free, syscall-only implementation for fullrust; the low-level
+//! primitives (mmap, TLS block, stack-overflow guard, per-thread heap teardown)
+//! still live in the fullrust pal and are reused here.
+
+use crate::ffi::CStr;
+use crate::io;
+use crate::num::NonZero;
+use crate::sync::Arc;
+use crate::sync::atomic::{AtomicU32, Ordering};
+use crate::thread::ThreadInit;
+// The fullrust pal module is private; its items are re-exported through
+// `crate::sys::*` (`sys::mod` does `pub use pal::*`), so reach the low-level
+// primitives that way, exactly as `sys::thread::unix` reaches `sys::{os,
+// stack_overflow}`.
+use crate::sys::{heap, mmap_anon as mmap_stack, munmap, stack_overflow, sysc, tls};
+use crate::time::Duration;
+
+pub const DEFAULT_MIN_STACK_SIZE: usize = 2 * 1024 * 1024;
+
+// Child-stack-launching clone wrapper (musl-style): the child begins on the new
+// stack and calls `entry(arg)`, then exits. `ctid` is passed as the child-tid
+// pointer so the kernel can clear it (CLONE_CHILD_CLEARTID) once the thread has
+// fully left its stack — the join handshake. `tls` is the child's thread pointer
+// (`%fs` base), installed by the kernel via CLONE_SETTLS before the child runs a
+// single instruction, so the child's first allocation/`#[thread_local]` access
+// already has a valid TCB.
+//   rdi=entry, rsi=stack_top, rdx=flags, rcx=arg, r8=ctid, r9=tls
+core::arch::global_asm!(
+    ".text",
+    ".globl __fullrust_clone",
+    ".hidden __fullrust_clone",
+    "__fullrust_clone:",
+    "  and rsi, -16",
+    "  sub rsi, 16",
+    "  mov [rsi], rdi",   // save entry on child stack
+    "  mov [rsi+8], rcx", // save arg
+    "  mov r10, r8",      // child_tid = ctid
+    "  mov r8, r9",       // tls = thread pointer (for CLONE_SETTLS)
+    "  mov rdi, rdx",     // clone arg1 = flags (rsi already = child stack)
+    "  xor edx, edx",     // parent_tid = 0
+    "  mov eax, 56",      // SYS_clone
+    "  syscall",
+    "  test rax, rax",
+    "  jnz 1f",           // parent: return tid
+    "  xor ebp, ebp",     // child: end the call-frame chain
+    "  pop rax",          // rax = entry
+    "  pop rdi",          // rdi = arg
+    "  call rax",         // entry(arg); never returns
+    "  mov eax, 60",      // SYS_exit (fallback)
+    "  xor edi, edi",
+    "  syscall",
+    "1:",
+    "  ret",
+);
+
+unsafe extern "C" {
+    fn __fullrust_clone(
+        entry: extern "C" fn(*mut u8) -> !,
+        stack_top: *mut u8,
+        flags: usize,
+        arg: *mut u8,
+        ctid: *mut u32,
+        tls: *mut u8,
+    ) -> isize;
+}
+
+// Shared VM/fds/signals, same thread group — a thread, not a process.
+const CLONE_VM: usize = 0x00000100;
+const CLONE_FS: usize = 0x00000200;
+const CLONE_FILES: usize = 0x00000400;
+const CLONE_SIGHAND: usize = 0x00000800;
+const CLONE_THREAD: usize = 0x00010000;
+const CLONE_SYSVSEM: usize = 0x00040000;
+const CLONE_SETTLS: usize = 0x00080000;
+const CLONE_CHILD_CLEARTID: usize = 0x00200000;
+
+struct Inner {
+    /// The child-tid futex word: nonzero while the thread exists, cleared to 0
+    /// (and futex-woken) by the kernel once the thread has terminated and is no
+    /// longer using its stack.
+    ctid: AtomicU32,
+}
+
+pub struct Thread {
+    inner: Arc<Inner>,
+    stack_base: *mut u8,
+    stack_size: usize,
+    /// The thread's native-TLS mapping (`%fs` block), freed alongside the stack
+    /// once the kernel reports the thread gone. Null if it had no TLS block.
+    tls_base: *mut u8,
+    tls_size: usize,
+}
+
+// The handle is moved between threads; the stack pointer is only used (munmap)
+// after the kernel reports the thread gone.
+unsafe impl Send for Thread {}
+unsafe impl Sync for Thread {}
+
+type Payload = (Box<ThreadInit>, Arc<Inner>, (usize, usize));
+
+extern "C" fn thread_start(arg: *mut u8) -> ! {
+    // SAFETY: `arg` is the `Payload` box leaked in `Thread::new`.
+    let payload = unsafe { Box::from_raw(arg as *mut Payload) };
+    let (init, inner, guard) = *payload;
+    // Initialize the 'current thread' mechanism and set the OS thread name
+    // (prctl operates on the calling thread, so this must happen here in the
+    // child, before the closure runs). `init()` returns the Rust entry point.
+    let f = init.init();
+    // Record this thread's stack guard and install its alternate signal stack so
+    // a stack overflow reports "thread '...' has overflowed its stack".
+    let altstack = unsafe { stack_overflow::setup_thread(guard) };
+    f();
+    unsafe { stack_overflow::teardown_thread(altstack) };
+    // Run this thread's `#[thread_local]` destructors and the runtime's
+    // per-thread cleanup before we leave — `%fs` is still valid here, so native
+    // TLS access works. (`guard::enable` is a no-op for fullrust; std relies on
+    // us calling these explicitly, as hermit/xous do.)
+    unsafe {
+        crate::sys::thread_local::destructors::run();
+    }
+    crate::rt::thread_cleanup();
+    // Tear down this thread's allocator heap last, once nothing else will
+    // allocate: return its empty segments to the OS and abandon any still
+    // holding blocks freed (or to be freed) by other threads.
+    unsafe {
+        heap::thread_exit();
+    }
+    // Keep `Inner` (and thus the `ctid` word) alive past our exit: the kernel
+    // writes 0 to it *after* this thread is gone. The joiner owns the other Arc
+    // ref and frees `Inner` once it has observed the clear.
+    core::mem::forget(inner);
+    unsafe { exit_thread() }
+}
+
+unsafe fn exit_thread() -> ! {
+    unsafe {
+        sysc::syscall1(60, 0); // SYS_exit — this thread only
+    }
+    loop {
+        core::hint::spin_loop();
+    }
+}
+
+impl Thread {
+    // unsafe: see thread::Builder::spawn_unchecked for safety requirements
+    pub unsafe fn new(stack: usize, init: Box<ThreadInit>) -> io::Result<Thread> {
+        // ctid starts nonzero; the kernel clears it on thread exit.
+        let inner = Arc::new(Inner { ctid: AtomicU32::new(1) });
+
+        let size = stack.max(DEFAULT_MIN_STACK_SIZE);
+        let base = mmap_stack(size);
+        if base.is_null() {
+            return Err(io::Error::from_raw_os_error(12)); // ENOMEM
+        }
+        // Guard the low page of the stack so an overflow faults into the
+        // stack-overflow handler (which reports it) instead of corrupting memory.
+        let guard = unsafe { stack_overflow::protect_stack(base) };
+
+        // The child runs `init.init()` first (sets the current-thread handle and
+        // the OS thread name via `set_name`), then the returned closure.
+        let payload: Box<Payload> = Box::new((init, inner.clone(), guard));
+        let arg = Box::into_raw(payload) as *mut u8;
+
+        // Build the child's native-TLS block (`%fs` data + TCB) here in the
+        // parent and hand its thread pointer to clone via CLONE_SETTLS, so the
+        // kernel installs `%fs` before the child's first instruction runs.
+        let (tp, tls_base, tls_size) = tls::build_thread_block();
+        if tp.is_null() {
+            drop(unsafe { Box::from_raw(arg as *mut Payload) });
+            unsafe {
+                munmap(base as usize, size);
+            }
+            return Err(io::Error::from_raw_os_error(12)); // ENOMEM
+        }
+
+        let stack_top = unsafe { base.add(size) };
+        let ctid = inner.ctid.as_ptr();
+        let flags = CLONE_VM
+            | CLONE_FS
+            | CLONE_FILES
+            | CLONE_SIGHAND
+            | CLONE_THREAD
+            | CLONE_SYSVSEM
+            | CLONE_SETTLS
+            | CLONE_CHILD_CLEARTID;
+        let r = unsafe { __fullrust_clone(thread_start, stack_top, flags, arg, ctid, tp as *mut u8) };
+        if r <= 0 {
+            drop(unsafe { Box::from_raw(arg as *mut Payload) });
+            unsafe {
+                munmap(base as usize, size);
+                if !tls_base.is_null() {
+                    munmap(tls_base as usize, tls_size);
+                }
+            }
+            return Err(io::Error::from_raw_os_error(if r < 0 { -r as i32 } else { 11 }));
+        }
+
+        Ok(Thread { inner, stack_base: base, stack_size: size, tls_base, tls_size })
+    }
+
+    pub fn join(self) {
+        // Wait for the kernel to clear the child-tid word (thread fully gone).
+        // CLONE_CHILD_CLEARTID's exit wake is a *non-private* FUTEX_WAKE, so we
+        // must wait with a non-private FUTEX_WAIT (not the private one used by
+        // the sync primitives) or the wake lands in a different hash bucket.
+        const FUTEX_WAIT: usize = 0; // shared (no FUTEX_PRIVATE_FLAG)
+        let ptr = self.inner.ctid.as_ptr() as usize;
+        loop {
+            let v = self.inner.ctid.load(Ordering::Acquire);
+            if v == 0 {
+                break;
+            }
+            unsafe {
+                // futex(uaddr, FUTEX_WAIT, v, NULL)
+                sysc::syscall6(202, ptr, FUTEX_WAIT, v as usize, 0, 0, 0);
+            }
+        }
+        // Safe now: the thread is no longer executing on its stack, and the
+        // kernel has finished writing the TLS exit handshake, so its `%fs` block
+        // is dead too. Free both.
+        unsafe {
+            munmap(self.stack_base as usize, self.stack_size);
+            if !self.tls_base.is_null() {
+                munmap(self.tls_base as usize, self.tls_size);
+            }
+        }
+    }
+}
+
+pub fn yield_now() {
+    unsafe {
+        sysc::syscall1(sysc::SCHED_YIELD, 0);
+    }
+}
+
+pub fn set_name(name: &CStr) {
+    // prctl(PR_SET_NAME, name): the kernel copies up to 16 bytes (incl. NUL)
+    // into the thread's `comm`, so an over-long name is simply truncated.
+    const PR_SET_NAME: usize = 15;
+    unsafe {
+        sysc::syscall2(sysc::PRCTL, PR_SET_NAME, name.as_ptr() as usize);
+    }
+}
+
+pub fn sleep(dur: Duration) {
+    let ts = [dur.as_secs() as i64, dur.subsec_nanos() as i64];
+    unsafe {
+        sysc::syscall2(sysc::NANOSLEEP, ts.as_ptr() as usize, 0);
+    }
+}
+
+pub fn current_os_id() -> Option<u64> {
+    // gettid(2) — the kernel thread id, matching what debuggers/`top` display.
+    const GETTID: usize = 186;
+    let id = unsafe { sysc::syscall1(GETTID, 0) };
+    Some(id as u64)
+}
+
+pub fn available_parallelism() -> io::Result<NonZero<usize>> {
+    // sched_getaffinity(0, sizeof(set), &set) then count the set CPU bits.
+    let mut set = [0u64; 16]; // up to 1024 CPUs
+    let r =
+        unsafe { sysc::syscall3(204, 0, core::mem::size_of_val(&set), set.as_mut_ptr() as usize) };
+    match sysc::ret(r) {
+        Ok(_) => {
+            let n: u32 = set.iter().map(|w| w.count_ones()).sum();
+            Ok(NonZero::new(n.max(1) as usize).unwrap())
+        }
+        Err(_) => Ok(NonZero::new(1).unwrap()),
+    }
+}
