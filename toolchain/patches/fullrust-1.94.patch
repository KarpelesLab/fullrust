+// UdpSocket
+// ---------------------------------------------------------------------------
+
+pub struct UdpSocket {
+    inner: Socket,
+}
+
+impl UdpSocket {
+    pub fn bind<A: ToSocketAddrs>(addr: A) -> io::Result<UdpSocket> {
+        return each_addr(addr, inner);
+
+        fn inner(addr: &SocketAddr) -> io::Result<UdpSocket> {
+            let sock = Socket::new(addr, SOCK_DGRAM)?;
+            let mut raw = [0u8; 28];
+            let len = addr_to_raw(addr, &mut raw);
+            cvt(unsafe {
+                sysc::syscall3(sysc::BIND, sock.raw(), raw.as_ptr() as usize, len)
+            })?;
+            Ok(UdpSocket { inner: sock })
+        }
+    }
+
+    pub fn peer_addr(&self) -> io::Result<SocketAddr> {
+        self.inner.sockname(sysc::GETPEERNAME)
+    }
+    pub fn socket_addr(&self) -> io::Result<SocketAddr> {
+        self.inner.sockname(sysc::GETSOCKNAME)
+    }
+    pub fn recv_from(&self, buf: &mut [u8]) -> io::Result<(usize, SocketAddr)> {
+        self.inner.recv_from_with_flags(buf, 0)
+    }
+    pub fn peek_from(&self, buf: &mut [u8]) -> io::Result<(usize, SocketAddr)> {
+        self.inner.recv_from_with_flags(buf, MSG_PEEK)
+    }
+    pub fn send_to(&self, buf: &[u8], addr: &SocketAddr) -> io::Result<usize> {
+        self.inner.send_to(buf, addr)
+    }
+    pub fn duplicate(&self) -> io::Result<UdpSocket> {
+        Ok(UdpSocket { inner: self.inner.duplicate()? })
+    }
+    pub fn set_read_timeout(&self, t: Option<Duration>) -> io::Result<()> {
+        self.inner.set_timeout(t, SO_RCVTIMEO)
+    }
+    pub fn set_write_timeout(&self, t: Option<Duration>) -> io::Result<()> {
+        self.inner.set_timeout(t, SO_SNDTIMEO)
+    }
+    pub fn read_timeout(&self) -> io::Result<Option<Duration>> {
+        self.inner.timeout(SO_RCVTIMEO)
+    }
+    pub fn write_timeout(&self) -> io::Result<Option<Duration>> {
+        self.inner.timeout(SO_SNDTIMEO)
+    }
+    pub fn set_broadcast(&self, broadcast: bool) -> io::Result<()> {
+        self.inner.setsockopt(SOL_SOCKET, SO_BROADCAST, broadcast as i32)
+    }
+    pub fn broadcast(&self) -> io::Result<bool> {
+        let v: i32 = self.inner.getsockopt(SOL_SOCKET, SO_BROADCAST)?;
+        Ok(v != 0)
+    }
+    pub fn set_multicast_loop_v4(&self, on: bool) -> io::Result<()> {
+        self.inner.setsockopt(IPPROTO_IP, IP_MULTICAST_LOOP, on as i32)
+    }
+    pub fn multicast_loop_v4(&self) -> io::Result<bool> {
+        let v: i32 = self.inner.getsockopt(IPPROTO_IP, IP_MULTICAST_LOOP)?;
+        Ok(v != 0)
+    }
+    pub fn set_multicast_ttl_v4(&self, ttl: u32) -> io::Result<()> {
+        self.inner.setsockopt(IPPROTO_IP, IP_MULTICAST_TTL, ttl as i32)
+    }
+    pub fn multicast_ttl_v4(&self) -> io::Result<u32> {
+        let v: i32 = self.inner.getsockopt(IPPROTO_IP, IP_MULTICAST_TTL)?;
+        Ok(v as u32)
+    }
+    pub fn set_multicast_loop_v6(&self, on: bool) -> io::Result<()> {
+        self.inner.setsockopt(IPPROTO_IPV6, IPV6_MULTICAST_LOOP, on as i32)
+    }
+    pub fn multicast_loop_v6(&self) -> io::Result<bool> {
+        let v: i32 = self.inner.getsockopt(IPPROTO_IPV6, IPV6_MULTICAST_LOOP)?;
+        Ok(v != 0)
+    }
+    pub fn join_multicast_v4(&self, multiaddr: &Ipv4Addr, interface: &Ipv4Addr) -> io::Result<()> {
+        // struct ip_mreq { in_addr imr_multiaddr; in_addr imr_interface; }
+        let mut mreq = [0u8; 8];
+        mreq[0..4].copy_from_slice(&multiaddr.octets());
+        mreq[4..8].copy_from_slice(&interface.octets());
+        self.inner.setsockopt(IPPROTO_IP, IP_ADD_MEMBERSHIP, mreq)
+    }
+    pub fn leave_multicast_v4(&self, multiaddr: &Ipv4Addr, interface: &Ipv4Addr) -> io::Result<()> {
+        let mut mreq = [0u8; 8];
+        mreq[0..4].copy_from_slice(&multiaddr.octets());
+        mreq[4..8].copy_from_slice(&interface.octets());
+        self.inner.setsockopt(IPPROTO_IP, IP_DROP_MEMBERSHIP, mreq)
+    }
+    pub fn join_multicast_v6(&self, multiaddr: &Ipv6Addr, interface: u32) -> io::Result<()> {
+        // struct ipv6_mreq { in6_addr ipv6mr_multiaddr; u32 ipv6mr_interface; }
+        let mut mreq = [0u8; 20];
+        mreq[0..16].copy_from_slice(&multiaddr.octets());
+        mreq[16..20].copy_from_slice(&interface.to_ne_bytes());
+        self.inner.setsockopt(IPPROTO_IPV6, IPV6_ADD_MEMBERSHIP, mreq)
+    }
+    pub fn leave_multicast_v6(&self, multiaddr: &Ipv6Addr, interface: u32) -> io::Result<()> {
+        let mut mreq = [0u8; 20];
+        mreq[0..16].copy_from_slice(&multiaddr.octets());
+        mreq[16..20].copy_from_slice(&interface.to_ne_bytes());
+        self.inner.setsockopt(IPPROTO_IPV6, IPV6_DROP_MEMBERSHIP, mreq)
+    }
+    pub fn set_ttl(&self, ttl: u32) -> io::Result<()> {
+        self.inner.setsockopt(IPPROTO_IP, IP_TTL, ttl as i32)
+    }
+    pub fn ttl(&self) -> io::Result<u32> {
+        let v: i32 = self.inner.getsockopt(IPPROTO_IP, IP_TTL)?;
+        Ok(v as u32)
+    }
+    pub fn take_error(&self) -> io::Result<Option<io::Error>> {
+        self.inner.take_error()
+    }
+    pub fn set_nonblocking(&self, nonblocking: bool) -> io::Result<()> {
+        self.inner.set_nonblocking(nonblocking)
+    }
+    pub fn recv(&self, buf: &mut [u8]) -> io::Result<usize> {
+        self.inner.read(buf)
+    }
+    pub fn peek(&self, buf: &mut [u8]) -> io::Result<usize> {
+        self.inner.peek(buf)
+    }
+    pub fn send(&self, buf: &[u8]) -> io::Result<usize> {
+        self.inner.write(buf)
+    }
+    pub fn connect<A: ToSocketAddrs>(&self, addr: A) -> io::Result<()> {
+        each_addr(addr, |addr| self.inner.connect(addr))
+    }
+}
+
+impl UdpSocket {
+    #[inline]
+    pub fn socket(&self) -> &Socket {
+        &self.inner
+    }
+
+    #[inline]
+    pub fn into_socket(self) -> Socket {
+        self.inner
+    }
+}
+
+impl AsInner<Socket> for UdpSocket {
+    #[inline]
+    fn as_inner(&self) -> &Socket {
+        &self.inner
+    }
+}
+
+impl FromInner<Socket> for UdpSocket {
+    #[inline]
+    fn from_inner(socket: Socket) -> UdpSocket {
+        UdpSocket { inner: socket }
+    }
+}
+
+impl fmt::Debug for UdpSocket {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        f.debug_struct("UdpSocket").field("fd", &self.inner.0.raw()).finish()
+    }
+}
+
+// ---------------------------------------------------------------------------
+// Name resolution (LookupHost)
+// ---------------------------------------------------------------------------
+
+pub struct LookupHost {
+    iter: crate::vec::IntoIter<SocketAddr>,
+}
+
+/// Free-function entry point used by `crate::net::socket_addr` (since 1.92 the
+/// shared code calls `crate::sys::net::lookup_host` directly instead of the
+/// `TryFrom` impls, and no longer re-applies the port — `resolve` already bakes
+/// it into every `SocketAddr`).
+pub fn lookup_host(host: &str, port: u16) -> io::Result<LookupHost> {
+    (host, port).try_into()
+}
+
+impl Iterator for LookupHost {
+    type Item = SocketAddr;
+    fn next(&mut self) -> Option<SocketAddr> {
+        self.iter.next()
+    }
+}
+
+impl TryFrom<&str> for LookupHost {
+    type Error = io::Error;
+
+    fn try_from(v: &str) -> io::Result<LookupHost> {
+        // Split "host:port" from the right (host may itself contain ':' for v6,
+        // but those forms are caught as IP literals before reaching here).
+        let (host, port_str) = v
+            .rsplit_once(':')
+            .ok_or_else(|| io::const_error!(io::ErrorKind::InvalidInput, "invalid socket address"))?;
+        let port: u16 = port_str
+            .parse()
+            .map_err(|_| io::const_error!(io::ErrorKind::InvalidInput, "invalid port value"))?;
+        (host, port).try_into()
+    }
+}
+
+impl TryFrom<(&str, u16)> for LookupHost {
+    type Error = io::Error;
+
+    fn try_from((host, port): (&str, u16)) -> io::Result<LookupHost> {
+        let addrs = resolve(host, port)?;
+        Ok(LookupHost { iter: addrs.into_iter() })
+    }
+}
+
+/// Resolve `host` to a set of `SocketAddr`s: IP literals directly, `localhost`
+/// and `/etc/hosts` entries locally, everything else via DNS.
+fn resolve(host: &str, port: u16) -> io::Result<Vec<SocketAddr>> {
+    if let Ok(ip) = host.parse::<IpAddr>() {
+        return Ok(vec![SocketAddr::new(ip, port)]);
+    }
+    if host.eq_ignore_ascii_case("localhost") {
+        return Ok(vec![
+            SocketAddr::new(IpAddr::V4(Ipv4Addr::LOCALHOST), port),
+            SocketAddr::new(IpAddr::V6(Ipv6Addr::LOCALHOST), port),
+        ]);
+    }
+    if let Some(addrs) = hosts_lookup(host, port) {
+        if !addrs.is_empty() {
+            return Ok(addrs);
+        }
+    }
+
+    let mut addrs = Vec::new();
+    if let Some(server) = resolv_conf_nameserver() {
+        // Prefer IPv4 (A) but include IPv6 (AAAA) when present.
+        for &qtype in &[1u16, 28u16] {
+            if let Ok(ips) = dns_query(&server, host, qtype) {
+                for ip in ips {
+                    addrs.push(SocketAddr::new(ip, port));
+                }
+            }
+        }
+    }
+    if addrs.is_empty() {
+        Err(io::const_error!(io::ErrorKind::Uncategorized, "failed to resolve host"))
+    } else {
+        Ok(addrs)
+    }
+}
+
+/// Scan `/etc/hosts` for `host`, returning any matching addresses.
+fn hosts_lookup(host: &str, port: u16) -> Option<Vec<SocketAddr>> {
+    let text = crate::fs::read_to_string("/etc/hosts").ok()?;
+    let mut out = Vec::new();
+    for line in text.lines() {
+        let line = line.split('#').next().unwrap_or("");
+        let mut fields = line.split_whitespace();
+        let Some(ip_str) = fields.next() else { continue };
+        let Ok(ip) = ip_str.parse::<IpAddr>() else { continue };
+        if fields.any(|name| name.eq_ignore_ascii_case(host)) {
+            out.push(SocketAddr::new(ip, port));
+        }
+    }
+    Some(out)
+}
+
+/// Read the first `nameserver` from `/etc/resolv.conf`.
+fn resolv_conf_nameserver() -> Option<SocketAddr> {
+    let text = crate::fs::read_to_string("/etc/resolv.conf").ok()?;
+    for line in text.lines() {
+        let line = line.trim();
+        if let Some(rest) = line.strip_prefix("nameserver") {
+            if let Ok(ip) = rest.trim().parse::<IpAddr>() {
+                return Some(SocketAddr::new(ip, 53));
+            }
+        }
+    }
+    None
+}
+
+/// Issue one DNS query (`qtype` = 1 for A, 28 for AAAA) over UDP and return the
+/// addresses in the answer section.
+fn dns_query(server: &SocketAddr, host: &str, qtype: u16) -> io::Result<Vec<IpAddr>> {
+    let mut q: Vec<u8> = Vec::with_capacity(host.len() + 32);
+    q.extend_from_slice(&0x4652u16.to_be_bytes()); // id ("FR")
+    q.extend_from_slice(&[0x01, 0x00]); // flags: recursion desired
+    q.extend_from_slice(&1u16.to_be_bytes()); // qdcount
+    q.extend_from_slice(&[0, 0, 0, 0, 0, 0]); // an/ns/ar counts
+    for label in host.split('.') {
+        if label.is_empty() {
+            continue;
+        }
+        if label.len() > 63 {
+            return Err(io::const_error!(io::ErrorKind::InvalidInput, "dns label too long"));
+        }
+        q.push(label.len() as u8);
+        q.extend_from_slice(label.as_bytes());
+    }
+    q.push(0); // root label
+    q.extend_from_slice(&qtype.to_be_bytes());
+    q.extend_from_slice(&1u16.to_be_bytes()); // class IN
+
+    let bind: SocketAddr = match server {
+        SocketAddr::V4(..) => SocketAddr::new(IpAddr::V4(Ipv4Addr::UNSPECIFIED), 0),
+        SocketAddr::V6(..) => SocketAddr::new(IpAddr::V6(Ipv6Addr::UNSPECIFIED), 0),
+    };
+    let sock = UdpSocket::bind(&bind)?;
+    sock.set_read_timeout(Some(Duration::from_secs(5)))?;
+    sock.send_to(&q, server)?;
+
+    let mut resp = [0u8; 1500];
+    let (n, _) = sock.recv_from(&mut resp)?;
+    parse_dns_answers(&resp[..n], qtype)
+}
+
+/// Advance past a (possibly compressed) DNS name, returning the offset just
+/// after it in the record stream.
+fn skip_name(buf: &[u8], mut pos: usize) -> Option<usize> {
+    loop {
+        let len = *buf.get(pos)?;
+        if len & 0xc0 == 0xc0 {
+            // Compression pointer: two bytes, name ends here.
+            return Some(pos + 2);
+        }
+        if len == 0 {
+            return Some(pos + 1);
+        }
+        pos += 1 + len as usize;
+    }
+}
+
+fn parse_dns_answers(buf: &[u8], qtype: u16) -> io::Result<Vec<IpAddr>> {
+    let bad = || io::const_error!(io::ErrorKind::InvalidData, "malformed DNS response");
+    if buf.len() < 12 {
+        return Err(bad());
+    }
+    let qdcount = u16::from_be_bytes([buf[4], buf[5]]);
+    let ancount = u16::from_be_bytes([buf[6], buf[7]]);
+    let mut pos = 12;
+    // Skip the questions.
+    for _ in 0..qdcount {
+        pos = skip_name(buf, pos).ok_or_else(bad)?;
+        pos += 4; // qtype + qclass
+    }
+    let mut out = Vec::new();
+    for _ in 0..ancount {
+        pos = skip_name(buf, pos).ok_or_else(bad)?;
+        if pos + 10 > buf.len() {
+            return Err(bad());
+        }
+        let rtype = u16::from_be_bytes([buf[pos], buf[pos + 1]]);
+        let rdlen = u16::from_be_bytes([buf[pos + 8], buf[pos + 9]]) as usize;
+        pos += 10;
+        if pos + rdlen > buf.len() {
+            return Err(bad());
+        }
+        if rtype == qtype {
+            if qtype == 1 && rdlen == 4 {
+                out.push(IpAddr::V4(Ipv4Addr::new(
+                    buf[pos],
+                    buf[pos + 1],
+                    buf[pos + 2],
+                    buf[pos + 3],
+                )));
+            } else if qtype == 28 && rdlen == 16 {
+                let mut o = [0u8; 16];
+                o.copy_from_slice(&buf[pos..pos + 16]);
+                out.push(IpAddr::V6(o.into()));
+            }
+        }
+        pos += rdlen;
+    }
+    Ok(out)
+}
