+// `fullrust` is not in the unix family, so it lacks `os::unix::ffi::OsStrExt`,
+// but its `OsStr` encoding *is* the raw bytes — provide the same two methods on
+// top of the stable byte-exact `OsStr` API.
+#[cfg(target_os = "fullrust")]
+trait OsStrExt {
+    fn from_bytes(slice: &[u8]) -> &OsStr;
+    fn as_bytes(&self) -> &[u8];
+}
+#[cfg(target_os = "fullrust")]
+impl OsStrExt for OsStr {
+    fn from_bytes(slice: &[u8]) -> &OsStr {
+        // SAFETY: every byte sequence is valid `OsStr` content on this target.
+        unsafe { OsStr::from_encoded_bytes_unchecked(slice) }
+    }
+    fn as_bytes(&self) -> &[u8] {
+        self.as_encoded_bytes()
+    }
+}
