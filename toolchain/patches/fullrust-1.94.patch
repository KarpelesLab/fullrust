+    pub const MKDIRAT: usize = 258;
+    pub const UNLINKAT: usize = 263;
+    pub const RENAMEAT: usize = 264;
+    pub const LINKAT: usize = 265;
+    pub const SYMLINKAT: usize = 266;
+    pub const READLINKAT: usize = 267;
+    pub const FCHMODAT: usize = 268;
+    pub const UTIMENSAT: usize = 280;
+    pub const STATX: usize = 332;
+    pub const EXIT_GROUP: usize = 231;
+    pub const CLOCK_GETTIME: usize = 228;
+    pub const GETRANDOM: usize = 318;
+    pub const SCHED_YIELD: usize = 24;
+    pub const NANOSLEEP: usize = 35;
+    pub const MMAP: usize = 9;
+    pub const MUNMAP: usize = 11;
+    pub const MADVISE: usize = 28;
+
+    pub const PROT_READ: usize = 0x1;
+    pub const PROT_WRITE: usize = 0x2;
+    pub const MAP_PRIVATE: usize = 0x2;
+    pub const MAP_ANONYMOUS: usize = 0x20;
+
+    // madvise(2) advice values.
+    #[allow(dead_code)]
+    pub const MADV_DONTNEED: usize = 4;
+    pub const MADV_FREE: usize = 8;
+
+    /// Interpret a raw return as `Result<usize, i32>` (Err is the errno).
+    #[inline]
+    pub fn ret(r: usize) -> Result<usize, i32> {
+        let s = r as isize;
+        if (-4095..0).contains(&s) { Err(-s as i32) } else { Ok(r) }
+    }
+}
+
+// ---------------------------------------------------------------------------
+// Low-level helpers shared across the pal. Kept dependency-free (no allocation,
+// no `io::Error`) so even the allocator (`heap`) can use them.
+// ---------------------------------------------------------------------------
+
+/// `mmap` an anonymous, private, read-write region. Returns null on failure.
+#[inline]
+pub(crate) fn mmap_anon(len: usize) -> *mut u8 {
+    let r = unsafe {
+        sysc::syscall6(
+            sysc::MMAP,
+            0,
+            len,
+            sysc::PROT_READ | sysc::PROT_WRITE,
+            sysc::MAP_PRIVATE | sysc::MAP_ANONYMOUS,
+            usize::MAX, // fd = -1
+            0,
+        )
+    };
+    match sysc::ret(r) {
+        Ok(p) => core::ptr::with_exposed_provenance_mut(p),
+        Err(_) => core::ptr::null_mut(),
+    }
+}
+
+/// `munmap` a region.
+#[inline]
+pub(crate) unsafe fn munmap(addr: usize, len: usize) {
+    unsafe {
+        sysc::syscall2(sysc::MUNMAP, addr, len);
+    }
+}
+
+/// `madvise` a region (e.g. `MADV_FREE`/`MADV_DONTNEED`).
+#[inline]
+pub(crate) unsafe fn madvise(addr: usize, len: usize, advice: usize) {
+    unsafe {
+        sysc::syscall3(sysc::MADVISE, addr, len, advice);
+    }
+}
+
+/// Read a `u32`/`u64` from an integer address (program headers, TLS image, …).
+///
+/// # Safety
+/// `addr` must point at a valid, correctly-aligned value for the read length.
+#[inline]
+pub(crate) unsafe fn rd_u32(addr: usize) -> u32 {
+    unsafe { *core::ptr::with_exposed_provenance::<u32>(addr) }
+}
+#[inline]
+pub(crate) unsafe fn rd_u64(addr: usize) -> u64 {
+    unsafe { *core::ptr::with_exposed_provenance::<u64>(addr) }
+}
+
+// ---------------------------------------------------------------------------
+// Process entry point. The kernel jumps here with rsp at argc; there is no
+// return address and no C runtime. We call the compiler-emitted C `main`, which
+// drives `lang_start` -> `rt::init` (capturing argc/argv) -> user `fn main`.
+// When it returns, exit_group with its code.
+// ---------------------------------------------------------------------------
+unsafe extern "C" {
+    // The C `main` shim the compiler emits for `fn main`: it calls
+    // `lang_start(user_main, argc, argv, sigpipe)`.
+    fn main(argc: core::ffi::c_int, argv: *const *const u8) -> core::ffi::c_int;
+}
+
+#[unsafe(naked)]
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn _start() -> ! {
+    core::arch::naked_asm!(
+        "xor rbp, rbp",
+        "mov rdi, rsp", // pointer to argc
+        "and rsp, -16", // ABI stack alignment
+        "call {start}",
+        start = sym rust_start,
+    )
+}
+
+unsafe extern "C" fn rust_start(stack: *const usize) -> ! {
+    // [argc][argv0..argv(argc-1)][NULL][envp0..][NULL][auxv...]
+    // Install native `%fs` thread-local storage for the main thread *first*:
+    // it parses the auxv that follows envp, and everything below (the allocator,
+    // any `#[thread_local]`) depends on `%fs` already pointing at a valid TCB.
+    unsafe { tls::init_main(stack) };
+    // Register the unwinder's FDE finder now that the program headers are known
+    // (it needs `tls::program_headers()`), before any panic can unwind.
+    #[cfg(feature = "panic-unwind")]
+    eh_frame::init();
+    let argc = unsafe { *stack } as core::ffi::c_int;
+    let argv = unsafe { stack.add(1) } as *const *const u8;
+    let code = unsafe { main(argc, argv) };
+    // Run the main thread's `#[thread_local]` destructors and per-thread runtime
+    // cleanup before exiting (fullrust's `guard::enable` is a no-op, so std
+    // relies on the pal to invoke these — same as hermit's entry).
+    unsafe {
+        crate::sys::thread_local::destructors::run();
+    }
+    crate::rt::thread_cleanup();
+    os::exit(code as i32)
+}
+
+// ---------------------------------------------------------------------------
+// Symbols the toolchain expects from the environment that neither libc (absent)
+// nor compiler_builtins provide. `compiler-builtins-mem` supplies the `mem*`
+// intrinsics; `strlen` is not among them, and core's `CStr::from_ptr` (used to
+// decode argv/envp) calls it.
+// ---------------------------------------------------------------------------
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn strlen(s: *const core::ffi::c_char) -> usize {
+    let mut n = 0;
+    // SAFETY: `s` points to a NUL-terminated C string (caller contract).
+    unsafe {
+        while *s.add(n) != 0 {
+            n += 1;
+        }
+    }
+    n
+}
diff --git a/library/std/src/sys/pal/fullrust/os.rs b/library/std/src/sys/pal/fullrust/os.rs
new file mode 100644
index 00000000..5ecc9e6b
--- /dev/null
+++ b/library/std/src/sys/pal/fullrust/os.rs
@@ -0,0 +1,220 @@
+use super::sysc;
+use crate::error::Error as StdError;
+use crate::ffi::{CString, OsStr, OsString};
+use crate::path::{self, PathBuf};
+use crate::{fmt, io};
+
+pub fn errno() -> i32 {
+    0
+}
+
+/// A human-readable message for a Linux errno. Without libc there is no
+/// `strerror`, so we carry a table of the common values; anything else falls
+/// back to the numeric form (matching `strerror`'s "Unknown error" spirit).
+pub fn error_string(errno: i32) -> String {
+    let msg = match errno {
+        1 => "Operation not permitted",
+        2 => "No such file or directory",
+        3 => "No such process",
+        4 => "Interrupted system call",
+        5 => "Input/output error",
+        6 => "No such device or address",
+        7 => "Argument list too long",
+        8 => "Exec format error",
+        9 => "Bad file descriptor",
+        10 => "No child processes",
+        11 => "Resource temporarily unavailable",
+        12 => "Cannot allocate memory",
+        13 => "Permission denied",
+        14 => "Bad address",
+        16 => "Device or resource busy",
+        17 => "File exists",
+        18 => "Invalid cross-device link",
+        19 => "No such device",
+        20 => "Not a directory",
+        21 => "Is a directory",
+        22 => "Invalid argument",
+        23 => "Too many open files in system",
+        24 => "Too many open files",
+        25 => "Inappropriate ioctl for device",
+        27 => "File too large",
+        28 => "No space left on device",
+        29 => "Illegal seek",
+        30 => "Read-only file system",
+        31 => "Too many links",
+        32 => "Broken pipe",
+        34 => "Numerical result out of range",
+        36 => "File name too long",
+        38 => "Function not implemented",
+        39 => "Directory not empty",
+        40 => "Too many levels of symbolic links",
+        61 => "No data available",
+        62 => "Timer expired",
+        88 => "Socket operation on non-socket",
+        90 => "Message too long",
+        91 => "Protocol wrong type for socket",
+        92 => "Protocol not available",
+        93 => "Protocol not supported",
+        95 => "Operation not supported",
+        97 => "Address family not supported by protocol",
+        98 => "Address already in use",
+        99 => "Cannot assign requested address",
+        100 => "Network is down",
+        101 => "Network is unreachable",
+        103 => "Software caused connection abort",
+        104 => "Connection reset by peer",
+        105 => "No buffer space available",
+        106 => "Transport endpoint is already connected",
+        107 => "Transport endpoint is not connected",
+        110 => "Connection timed out",
+        111 => "Connection refused",
+        113 => "No route to host",
+        114 => "Operation already in progress",
+        115 => "Operation now in progress",
+        _ => return format!("Unknown error {errno}"),
+    };
+    msg.to_string()
+}
+
+/// Build a NUL-terminated C string from a path's raw bytes. On the fullrust
+/// target `OsStr` is the byte representation, so the encoded bytes are the path
+/// bytes verbatim.
+pub(crate) fn cstr(path: &path::Path) -> io::Result<CString> {
+    CString::new(path.as_os_str().as_encoded_bytes())
+        .map_err(|_| io::const_error!(io::ErrorKind::InvalidInput, "path contains a NUL byte"))
+}
+
+/// Materialize an `OsString` from raw path bytes (byte-exact, no lossy decode).
+pub(crate) fn os_string_from_bytes(b: &[u8]) -> OsString {
+    // SAFETY: on this target the `OsStr` encoding *is* the raw byte sequence, so
+    // any byte slice is valid encoded content.
+    unsafe { OsStr::from_encoded_bytes_unchecked(b).to_os_string() }
+}
+
+pub fn getcwd() -> io::Result<PathBuf> {
+    let mut buf = [0u8; 4096];
+    let r = unsafe { sysc::syscall2(sysc::GETCWD, buf.as_mut_ptr() as usize, buf.len()) };
+    match sysc::ret(r) {
+        // getcwd writes the path plus a trailing NUL and returns the total length.
+        Ok(len) => {
+            let n = len.min(buf.len()).saturating_sub(1);
+            Ok(PathBuf::from(os_string_from_bytes(&buf[..n])))
+        }
+        Err(e) => Err(io::Error::from_raw_os_error(e)),
+    }
+}
+
+pub fn chdir(path: &path::Path) -> io::Result<()> {
+    let p = cstr(path)?;
+    let r = unsafe { sysc::syscall1(sysc::CHDIR, p.as_ptr() as usize) };
+    sysc::ret(r).map(|_| ()).map_err(io::Error::from_raw_os_error)
+}
+
+/// The `PATH`-style separator on this (Unix-semantics) target.
+const PATH_SEPARATOR: u8 = b':';
+
+pub struct SplitPaths<'a> {
+    iter: crate::iter::Map<
+        crate::slice::Split<'a, u8, fn(&u8) -> bool>,
+        fn(&[u8]) -> PathBuf,
+    >,
+}
+
+pub fn split_paths(unparsed: &OsStr) -> SplitPaths<'_> {
+    fn bytes_to_path(b: &[u8]) -> PathBuf {
+        PathBuf::from(os_string_from_bytes(b))
+    }
+    fn is_separator(b: &u8) -> bool {
+        *b == PATH_SEPARATOR
+    }
+    SplitPaths {
+        iter: unparsed
+            .as_encoded_bytes()
+            .split(is_separator as fn(&u8) -> bool)
+            .map(bytes_to_path as fn(&[u8]) -> PathBuf),
+    }
+}
+
+impl<'a> Iterator for SplitPaths<'a> {
+    type Item = PathBuf;
+    fn next(&mut self) -> Option<PathBuf> {
+        self.iter.next()
+    }
+    fn size_hint(&self) -> (usize, Option<usize>) {
+        self.iter.size_hint()
+    }
+}
+
+#[derive(Debug)]
+pub struct JoinPathsError;
+
+pub fn join_paths<I, T>(paths: I) -> Result<OsString, JoinPathsError>
+where
+    I: Iterator<Item = T>,
+    T: AsRef<OsStr>,
+{
+    let mut joined = Vec::new();
+    for (i, path) in paths.enumerate() {
+        let path = path.as_ref().as_encoded_bytes();
+        if i > 0 {
+            joined.push(PATH_SEPARATOR);
+        }
+        if path.contains(&PATH_SEPARATOR) {
+            return Err(JoinPathsError);
+        }
+        joined.extend_from_slice(path);
+    }
+    Ok(os_string_from_bytes(&joined))
+}
+
+impl fmt::Display for JoinPathsError {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        "path segment contains separator `:`".fmt(f)
+    }
+}
+
+impl StdError for JoinPathsError {
+    #[allow(deprecated)]
+    fn description(&self) -> &str {
+        "failed to join paths"
+    }
+}
+
+pub fn current_exe() -> io::Result<PathBuf> {
+    let link = c"/proc/self/exe";
+    let mut buf = [0u8; 4096];
+    let r = unsafe {
+        sysc::syscall3(
+            sysc::READLINK,
+            link.as_ptr() as usize,
+            buf.as_mut_ptr() as usize,
+            buf.len(),
+        )
+    };
+    match sysc::ret(r) {
+        // readlink returns the byte count written and does not NUL-terminate.
+        Ok(n) => Ok(PathBuf::from(os_string_from_bytes(&buf[..n.min(buf.len())]))),
+        Err(e) => Err(io::Error::from_raw_os_error(e)),
+    }
+}
+
+pub fn temp_dir() -> PathBuf {
+    PathBuf::from("/tmp")
+}
+
+pub fn home_dir() -> Option<PathBuf> {
+    // No libc/NSS to fall back on, so `$HOME` is authoritative here.
+    crate::env::var_os("HOME").filter(|s| !s.is_empty()).map(PathBuf::from)
+}
+
+pub fn exit(code: i32) -> ! {
+    unsafe {
+        sysc::syscall1(sysc::EXIT_GROUP, code as usize);
+    }
+    // exit_group never returns; satisfy the `!` return type if it ever did.
+    crate::intrinsics::abort()
+}
+
+pub fn getpid() -> u32 {
+    unsafe { sysc::syscall1(sysc::GETPID, 0) as u32 }
+}
diff --git a/library/std/src/sys/pal/fullrust/pipe.rs b/library/std/src/sys/pal/fullrust/pipe.rs
new file mode 100644
index 00000000..5df518e6
--- /dev/null
+++ b/library/std/src/sys/pal/fullrust/pipe.rs
@@ -0,0 +1,137 @@
+//! Anonymous pipes for the fullrust target, on raw Linux syscalls.
+//!
+//! `AnonPipe` owns one end of a kernel pipe (an fd) and closes it on drop. Pipes
+//! are created `O_CLOEXEC` so they don't leak across an `execve`; the child end
+//! is explicitly `dup2`'d onto a stdio slot (which clears cloexec) by the process
+//! spawner. `read2` drains two pipes concurrently via `poll` so capturing both a
+//! child's stdout and stderr can't deadlock.
+
+use super::fd::{cvt, FileDesc};
+use super::sysc;
+use crate::fmt;
+use crate::io::{self, BorrowedCursor, IoSlice, IoSliceMut};
+use crate::sys::IntoInner;
+
+// pipe2(2) flag / poll(2) events.
+const O_CLOEXEC: usize = 0o2000000;
+const POLLIN: i16 = 0x1;
+
+/// One end of a kernel pipe. Read/write/dup/close come from the shared
+/// [`FileDesc`]; this type adds only pipe-specific helpers (`read_to_end`,
+/// `read2`).
+pub struct AnonPipe(FileDesc);
+
+impl AnonPipe {
+    pub(crate) fn from_fd(fd: i32) -> AnonPipe {
+        AnonPipe(FileDesc::from_raw(fd))
+    }
+
+    pub(crate) fn as_raw_fd(&self) -> i32 {
+        self.0.raw()
+    }
+
+    pub fn read(&self, buf: &mut [u8]) -> io::Result<usize> {
+        self.0.read(buf)
+    }
+
+    pub fn read_buf(&self, cursor: BorrowedCursor<'_>) -> io::Result<()> {
+        self.0.read_buf(cursor)
+    }
+
+    pub fn read_vectored(&self, bufs: &mut [IoSliceMut<'_>]) -> io::Result<usize> {
+        self.0.read_vectored(bufs)
+    }
+
+    pub fn is_read_vectored(&self) -> bool {
+        true
+    }
+
+    pub fn read_to_end(&self, buf: &mut Vec<u8>) -> io::Result<usize> {
+        self.0.read_to_end(buf)
+    }
+
+    pub fn write(&self, buf: &[u8]) -> io::Result<usize> {
+        self.0.write(buf)
+    }
+
+    pub fn write_vectored(&self, bufs: &[IoSlice<'_>]) -> io::Result<usize> {
+        self.0.write_vectored(bufs)
+    }
+
+    pub fn is_write_vectored(&self) -> bool {
+        true
+    }
+}
+
+impl fmt::Debug for AnonPipe {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        f.debug_struct("AnonPipe").field("fd", &self.0.raw()).finish()
+    }
+}
+
+/// Unwrap to the owning [`FileDesc`]. This is how `sys::pipe` (the
+/// `std::io::pipe` surface) turns a pipe end into an `os::fd`-capable handle.
+impl IntoInner<FileDesc> for AnonPipe {
+    #[inline]
+    fn into_inner(self) -> FileDesc {
+        self.0
+    }
+}
+
+/// Create a `(read, write)` pair of pipe ends, both close-on-exec.
+pub fn pipe() -> io::Result<(AnonPipe, AnonPipe)> {
+    let mut fds = [0i32; 2];
+    cvt(unsafe { sysc::syscall2(sysc::PIPE2, fds.as_mut_ptr() as usize, O_CLOEXEC) })?;
+    Ok((AnonPipe::from_fd(fds[0]), AnonPipe::from_fd(fds[1])))
+}
+
+#[repr(C)]
+struct PollFd {
+    fd: i32,
+    events: i16,
+    revents: i16,
+}
+
+/// Drain one pipe into `v` until it would block; returns `true` at end-of-file.
+fn drain(p: &AnonPipe, v: &mut Vec<u8>) -> io::Result<bool> {
+    let mut tmp = [0u8; 8192];
+    loop {
+        match p.read(&mut tmp) {
+            Ok(0) => return Ok(true),
+            Ok(n) => v.extend_from_slice(&tmp[..n]),
+            Err(ref e) if e.kind() == io::ErrorKind::WouldBlock => return Ok(false),
+            Err(ref e) if e.kind() == io::ErrorKind::Interrupted => continue,
+            Err(e) => return Err(e),
+        }
+    }
+}
+
+/// Read two pipes to EOF concurrently, so a child that fills one stream while we
+/// drain the other cannot deadlock.
+pub fn read2(p1: AnonPipe, v1: &mut Vec<u8>, p2: AnonPipe, v2: &mut Vec<u8>) -> io::Result<()> {
+    p1.0.set_nonblocking(true)?;
+    p2.0.set_nonblocking(true)?;
+    let (fd1, fd2) = (p1.0.raw(), p2.0.raw());
+    let mut done = [false, false];
+    while !(done[0] && done[1]) {
+        let mut fds = [
+            PollFd { fd: if done[0] { -1 } else { fd1 }, events: POLLIN, revents: 0 },
+            PollFd { fd: if done[1] { -1 } else { fd2 }, events: POLLIN, revents: 0 },
+        ];
+        // poll(fds, 2, -1): wait indefinitely until at least one is readable.
+        match sysc::ret(unsafe {
+            sysc::syscall3(sysc::POLL, fds.as_mut_ptr() as usize, 2, (-1isize) as usize)
+        }) {
+            Ok(_) => {}
+            Err(4) => continue, // EINTR
+            Err(e) => return Err(io::Error::from_raw_os_error(e)),
+        }
+        if !done[0] && fds[0].revents != 0 && drain(&p1, v1)? {
+            done[0] = true;
+        }
+        if !done[1] && fds[1].revents != 0 && drain(&p2, v2)? {
+            done[1] = true;
+        }
+    }
+    Ok(())
+}
diff --git a/library/std/src/sys/pal/fullrust/stack_overflow.rs b/library/std/src/sys/pal/fullrust/stack_overflow.rs
new file mode 100644
index 00000000..683fc99a
--- /dev/null
+++ b/library/std/src/sys/pal/fullrust/stack_overflow.rs
@@ -0,0 +1,165 @@
+//! Stack-overflow detection for the fullrust target, on raw Linux syscalls.
+//!
+//! A process-wide `SIGSEGV`/`SIGBUS` handler runs on a per-thread *alternate*
+//! signal stack (so it can execute even when the normal stack is exhausted).
+//! When the faulting address lies in a thread's recorded guard region, it prints
+//! `thread '<name>' has overflowed its stack` and aborts — instead of leaving a
+//! bare, misleading segfault. Any other fault is passed through: the handler
+//! reverts that signal to its default action and returns so it re-raises.
+//!
+//! Guard regions: a spawned thread's stack (mapped by `thread.rs`) gets an
+//! `mprotect(PROT_NONE)` guard page at its low end; the main thread has no
+//! self-mapped stack, so its guard is derived from `RLIMIT_STACK` and the
+//! `[stack]` mapping in `/proc/self/maps` (the kernel enforces the real guard).
+
+use super::sysc;
+use super::{mmap_anon, munmap};
+use crate::cell::Cell;
+
+const PAGE: usize = 4096;
+const ALTSTACK_SIZE: usize = 1 << 15; // 32 KiB
+
+const SIGSEGV: usize = 11;
+const SIGBUS: usize = 7;
+const SA_SIGINFO: usize = 0x0000_0004;
+const SA_ONSTACK: usize = 0x0800_0000;
+const SA_RESTORER: usize = 0x0400_0000;
+const SIG_DFL: usize = 0;
+const SS_DISABLE: usize = 2;
+const PROT_NONE: usize = 0;
+const RLIMIT_STACK: usize = 3;
+
+// Per-thread guard region `[start, end)`; a fault here is a stack overflow. We
+// write it before the handler could ever fire, so reading it in signal context
+// (native `%fs` TLS, valid in a handler) is safe in practice — same rationale as
+// the unix pal.
+thread_local! {
+    static GUARD: Cell<(usize, usize)> = const { Cell::new((0, 0)) };
+}
+
+/// Signal restorer. On x86-64 the kernel has no default sigreturn trampoline, so
+/// a real handler MUST supply `sa_restorer` (with `SA_RESTORER`); it invokes
+/// `rt_sigreturn` (15) to resume the interrupted context.
+#[unsafe(naked)]
+unsafe extern "C" fn restorer() {
+    core::arch::naked_asm!("mov rax, 15", "syscall");
+}
+
+/// `SIGSEGV`/`SIGBUS` handler in `SA_SIGINFO` form. Rust never calls this; the
+/// kernel does, with `(signum, *siginfo, *ucontext)`.
+extern "C" fn handler(signum: i32, info: *mut u8, _ctx: *mut u8) {
+    // `siginfo_t` on x86-64: `si_addr` (the fault address, for SIGSEGV/SIGBUS)
+    // is at byte offset 16, past `si_signo`/`si_errno`/`si_code`.
+    let addr = unsafe { *(info.add(16) as *const usize) };
+    let (start, end) = GUARD.with(|g| g.get());
+    if start != 0 && start <= addr && addr < end {
+        crate::thread::with_current_name(|name| {
+            let name = name.unwrap_or("<unknown>");
+            rtprintpanic!("\nthread '{name}' has overflowed its stack\n");
+        });
+        rtabort!("stack overflow");
+    }
+    // Not an overflow: revert this signal to its default action and return, so
+    // the faulting instruction re-raises it (normal crash for a genuine bug).
+    unsafe { set_handler(signum as usize, SIG_DFL, 0) };
+}
+
+/// `rt_sigaction(sig, {handler, flags, restorer, mask=0}, null, sigsetsize=8)`.
+unsafe fn set_handler(sig: usize, handler_addr: usize, flags: usize) {
+    // struct kernel_sigaction { sa_handler; sa_flags; sa_restorer; sa_mask[1]; }
+    let act: [usize; 4] = if handler_addr == SIG_DFL {
+        [SIG_DFL, 0, 0, 0]
+    } else {
+        [handler_addr, flags | SA_RESTORER, restorer as *const () as usize, 0]
+    };
+    unsafe {
+        sysc::syscall4(sysc::RT_SIGACTION, sig, act.as_ptr() as usize, 0, 8);
+    }
+}
+
+/// Install this thread's alternate signal stack. Returns its base (to free at
+/// thread exit), or null if the mapping failed.
+unsafe fn install_altstack() -> *mut u8 {
+    let base = mmap_anon(ALTSTACK_SIZE);
+    if base.is_null() {
+        return base;
+    }
+    // struct sigaltstack { void* ss_sp; int ss_flags; size_t ss_size; }
+    let ss: [usize; 3] = [base as usize, 0, ALTSTACK_SIZE];
+    unsafe {
+        sysc::syscall2(sysc::SIGALTSTACK, ss.as_ptr() as usize, 0);
+    }
+    base
+}
+
+/// `mprotect(PROT_NONE)` the low page of a spawned thread's stack as a guard, and
+/// return its `[start, end)` range. Called by `thread.rs` in the parent.
+pub unsafe fn protect_stack(base: *mut u8) -> (usize, usize) {
+    unsafe {
+        sysc::syscall3(sysc::MPROTECT, base as usize, PAGE, PROT_NONE);
+    }
+    (base as usize, base as usize + PAGE)
+}
+
+/// Record a spawned thread's guard region and install its alternate signal
+/// stack. Returns the altstack base for later teardown. Called at thread start.
+pub unsafe fn setup_thread(guard: (usize, usize)) -> *mut u8 {
+    GUARD.with(|g| g.set(guard));
+    unsafe { install_altstack() }
+}
+
+/// Tear down a spawned thread's alternate signal stack at thread exit.
+pub unsafe fn teardown_thread(altstack: *mut u8) {
+    if altstack.is_null() {
+        return;
+    }
+    let ss: [usize; 3] = [0, SS_DISABLE, 0];
+    unsafe {
+        sysc::syscall2(sysc::SIGALTSTACK, ss.as_ptr() as usize, 0);
+        munmap(altstack as usize, ALTSTACK_SIZE);
+    }
+}
+
+/// Read the top (high address) of the main thread's `[stack]` mapping.
+fn main_stack_top() -> Option<usize> {
+    let maps = crate::fs::read_to_string("/proc/self/maps").ok()?;
+    for line in maps.lines() {
+        if line.ends_with("[stack]") {
+            // "LOW-HIGH perms offset dev inode   pathname"
+            let hi = line.split_whitespace().next()?.split('-').nth(1)?;
+            return usize::from_str_radix(hi, 16).ok();
+        }
+    }
+    None
+}
+
+/// Guard region for the main thread: the kernel grows the stack down to
+/// `top - RLIMIT_STACK` and faults there, so classify a fault around that
+/// boundary as overflow.
+fn main_guard() -> (usize, usize) {
+    let mut rl = [0u64; 2]; // { rlim_cur, rlim_max }
+    let r =
+        unsafe { sysc::syscall4(sysc::PRLIMIT64, 0, RLIMIT_STACK, 0, rl.as_mut_ptr() as usize) };
+    let limit = match sysc::ret(r) {
+        Ok(_) => rl[0] as usize,
+        Err(_) => 8 << 20, // 8 MiB default
+    };
+    let top = main_stack_top().unwrap_or(0);
+    if top == 0 || limit == 0 || limit == usize::MAX || limit >= top {
+        return (0, 0);
+    }
+    let low = (top - limit) & !(PAGE - 1);
+    (low.saturating_sub(PAGE), low + PAGE)
+}
+
+/// Install the main thread's guard, alternate signal stack, and the process-wide
+/// `SIGSEGV`/`SIGBUS` handler. Called once from `common::init`.
+pub unsafe fn init() {
+    GUARD.with(|g| g.set(main_guard()));
+    // The main thread's altstack lives for the whole process; intentionally leak.
+    let _ = unsafe { install_altstack() };
+    unsafe {
+        set_handler(SIGSEGV, handler as *const () as usize, SA_SIGINFO | SA_ONSTACK);
+        set_handler(SIGBUS, handler as *const () as usize, SA_SIGINFO | SA_ONSTACK);
+    }
+}
diff --git a/library/std/src/sys/pal/fullrust/time.rs b/library/std/src/sys/pal/fullrust/time.rs
new file mode 100644
index 00000000..8e4c583c
--- /dev/null
+++ b/library/std/src/sys/pal/fullrust/time.rs
@@ -0,0 +1,72 @@
+use super::sysc;
+use crate::time::Duration;
+
+#[derive(Copy, Clone, PartialEq, Eq, PartialOrd, Ord, Debug, Hash)]
+pub struct Instant(Duration);
+
+#[derive(Copy, Clone, PartialEq, Eq, PartialOrd, Ord, Debug, Hash)]
+pub struct SystemTime(Duration);
+
+pub const UNIX_EPOCH: SystemTime = SystemTime(Duration::from_secs(0));
+
+fn clock(id: usize) -> Duration {
+    // struct timespec { i64 tv_sec; i64 tv_nsec; }
+    let mut ts = [0i64; 2];
+    unsafe {
+        sysc::syscall2(sysc::CLOCK_GETTIME, id, ts.as_mut_ptr() as usize);
+    }
+    Duration::new(ts[0] as u64, ts[1] as u32)
+}
+
+impl Instant {
+    pub fn now() -> Instant {
+        Instant(clock(1)) // CLOCK_MONOTONIC
+    }
+
+    pub fn checked_sub_instant(&self, other: &Instant) -> Option<Duration> {
+        self.0.checked_sub(other.0)
+    }
+
+    pub fn checked_add_duration(&self, other: &Duration) -> Option<Instant> {
+        Some(Instant(self.0.checked_add(*other)?))
+    }
+
+    pub fn checked_sub_duration(&self, other: &Duration) -> Option<Instant> {
+        Some(Instant(self.0.checked_sub(*other)?))
+    }
+}
+
+impl SystemTime {
+    // `fullrust` represents `SystemTime` as an unsigned offset from `UNIX_EPOCH`
+    // (pre-epoch instants clamp to the epoch), so the minimum is the epoch itself.
+    pub const MAX: SystemTime = SystemTime(Duration::MAX);
+    pub const MIN: SystemTime = SystemTime(Duration::ZERO);
+
+    pub fn now() -> SystemTime {
+        SystemTime(clock(0)) // CLOCK_REALTIME
+    }
+
+    /// Build a `SystemTime` from a `(seconds, nanoseconds)` pair measured against
+    /// the Unix epoch (e.g. a `statx`/`timespec` field). This target represents
+    /// `SystemTime` as an unsigned offset from `UNIX_EPOCH`, so pre-epoch instants
+    /// (negative seconds) cannot be represented and clamp to the epoch.
+    pub(crate) fn new(secs: i64, nsecs: u32) -> SystemTime {
+        if secs >= 0 {
+            SystemTime(Duration::new(secs as u64, nsecs))
+        } else {
+            SystemTime(Duration::ZERO)
+        }
+    }
+
+    pub fn sub_time(&self, other: &SystemTime) -> Result<Duration, Duration> {
+        self.0.checked_sub(other.0).ok_or_else(|| other.0 - self.0)
+    }
+
+    pub fn checked_add_duration(&self, other: &Duration) -> Option<SystemTime> {
+        Some(SystemTime(self.0.checked_add(*other)?))
+    }
+
+    pub fn checked_sub_duration(&self, other: &Duration) -> Option<SystemTime> {
+        Some(SystemTime(self.0.checked_sub(*other)?))
+    }
+}
diff --git a/library/std/src/sys/pal/fullrust/tls.rs b/library/std/src/sys/pal/fullrust/tls.rs
new file mode 100644
index 00000000..66486ebd
--- /dev/null
+++ b/library/std/src/sys/pal/fullrust/tls.rs
@@ -0,0 +1,267 @@
+//! Native ELF thread-local storage (`%fs`-based, variant II) for the fullrust
+//! target — the libc-free equivalent of glibc/musl's `__init_tls`/`__copy_tls`.
+//!
+//! x86-64 uses TLS **variant 2**: the thread pointer (`%fs` base) points at the
+//! Thread Control Block (TCB); the static TLS data block sits *immediately
+//! below* it, so a `#[thread_local]` at segment offset `s` is read as
+//! `%fs:(s - tls_size)` — a single instruction with a link-time-fixed offset
+//! (the *local-exec* model, which a static non-PIE executable always uses).
+//!
+//! We own the TCB. Word 0 is the psABI-mandated self-pointer (`%fs:0` == TP);
+//! the rest carries runtime state that must be reachable without ever calling
+//! the allocator — most importantly the per-thread allocator heap pointer, so
+//! the allocator fast path is a couple of loads off `%fs` with no lock and no
+//! syscall.
+//!
+//! The TLS image (`.tdata` init bytes + `.tbss` size + alignment) is discovered
+//! once, from the `PT_TLS` program header found via the auxiliary vector at
+//! process entry, and cached for every thread spawned afterwards.
+
+use super::sysc;
+use crate::ptr;
+use crate::sync::atomic::{AtomicU8, AtomicUsize, Ordering};
+
+const PAGE: usize = 4096;
+
+// arch_prctl(2)
+const ARCH_PRCTL: usize = 158;
+const ARCH_SET_FS: usize = 0x1002;
+
+// Auxiliary-vector entry types we care about.
+const AT_NULL: u64 = 0;
+const AT_PHDR: u64 = 3;
+const AT_PHENT: u64 = 4;
+const AT_PHNUM: u64 = 5;
+
+// Elf64_Phdr field offsets (the struct is 56 bytes).
+const PT_TLS: u32 = 7;
+const PH_TYPE: usize = 0; // u32
+const PH_VADDR: usize = 16; // u64
+const PH_FILESZ: usize = 32; // u64
+const PH_MEMSZ: usize = 40; // u64
+const PH_ALIGN: usize = 48; // u64
+
+/// Per-thread control block. `%fs` (the thread pointer) points here. The layout
+/// of the first word is fixed by the x86-64 psABI; the rest is ours.
+#[repr(C)]
+pub struct Tcb {
+    /// `%fs:0` — self-pointer (TP). Required by the ABI; some TLS access models
+    /// and a stray stack-canary read expect a sane value here.
+    self_ptr: *mut Tcb,
+    /// `%fs:8` — the current thread's allocator heap, or null until first use.
+    /// Read on every allocation, so it lives one load off the thread pointer.
+    pub heap: *mut u8,
+    /// `%fs:16` — head of this thread's `#[thread_local]` destructor list, run
+    /// at thread exit (see `thread_local`'s native dtor registration).
+    pub dtors: *mut u8,
+    /// Padding so the TCB spans the canary slot (`%fs:0x28`) and stays a clean
+    /// 64-byte, 16-aligned block.
+    _reserved: [usize; 5],
+}
+
+/// The discovered static-TLS image, captured once on the main thread and reused
+/// to build every spawned thread's block. Written before any thread is created,
+/// then only read — so plain atomics (no lock) are enough.
+static TLS_IMAGE: AtomicUsize = AtomicUsize::new(0); // *const u8 (.tdata source), or 0
+static TLS_FILESZ: AtomicUsize = AtomicUsize::new(0);
+static TLS_MEMSZ: AtomicUsize = AtomicUsize::new(0);
+static TLS_ALIGN: AtomicUsize = AtomicUsize::new(16);
+static TLS_READY: AtomicU8 = AtomicU8::new(0);
+
+// The process program-header table, captured from the auxv (`AT_PHDR`/`AT_PHENT`/
+// `AT_PHNUM`). The unwinder's FDE finder reads these to locate `.eh_frame_hdr`
+// (`PT_GNU_EH_FRAME`) and the text segment. See `super::eh_frame`.
+static PHDR: AtomicUsize = AtomicUsize::new(0);
+static PHENT: AtomicUsize = AtomicUsize::new(0);
+static PHNUM: AtomicUsize = AtomicUsize::new(0);
+
+/// The program-header table `(addr, entry_size, count)` from the auxv, or
+/// `(0, _, 0)` if it was unavailable.
+pub fn program_headers() -> (usize, usize, usize) {
+    (
+        PHDR.load(Ordering::Relaxed),
+        PHENT.load(Ordering::Relaxed),
+        PHNUM.load(Ordering::Relaxed),
+    )
+}
+
+const TCB_SIZE: usize = core::mem::size_of::<Tcb>();
+
+#[inline]
+fn round_up(v: usize, to: usize) -> usize {
+    (v + to - 1) & !(to - 1)
+}
+
+// The program headers and the TLS init image live in the process's own loaded
+// image, at addresses the kernel reported via the auxv (not memory we allocated),
+// so they are read through exposed provenance via the shared `rd_u32`/`rd_u64`.
+use super::{mmap_anon as mmap, rd_u32, rd_u64};
+
+/// Read the current thread's TCB via the `%fs:0` self-pointer. The thread
+/// pointer is constant for the life of a thread, so this is `pure`/`readonly`.
+#[inline]
+pub fn tcb() -> *mut Tcb {
+    let p: *mut Tcb;
+    // SAFETY: `%fs` was set by `init_main`/`init_thread` before any Rust code on
+    // this thread ran; `%fs:0` holds the self-pointer we stored there.
+    unsafe {
+        core::arch::asm!(
+            "mov {}, fs:[0]",
+            out(reg) p,
+            options(nostack, preserves_flags, readonly, pure),
+        );
+    }
+    p
+}
+
+/// The current thread's allocator heap pointer (null until first allocation).
+#[inline]
+pub fn heap() -> *mut u8 {
+    // SAFETY: `tcb()` returns this thread's valid TCB.
+    unsafe { (*tcb()).heap }
+}
+
+/// Install this thread's allocator heap pointer.
+#[inline]
+pub fn set_heap(h: *mut u8) {
+    // SAFETY: as above; the field is only ever touched by the owning thread.
+    unsafe { (*tcb()).heap = h };
+}
+
+#[inline]
+unsafe fn set_fs(tp: *mut Tcb) {
+    unsafe {
+        sysc::syscall2(ARCH_PRCTL, ARCH_SET_FS, tp as usize);
+    }
+}
+
+/// Build a fresh TLS block (TLS data below the TCB) from the captured image and
+/// return its thread pointer plus the mapping to free at thread exit.
+///
+/// Returns `(tp, block_base, block_len)`. `block_base`/`block_len` describe the
+/// whole mapping for `munmap`; `tp` is what goes into `%fs`.
+fn build_block() -> (*mut Tcb, *mut u8, usize) {
+    let memsz = TLS_MEMSZ.load(Ordering::Relaxed);
+    let filesz = TLS_FILESZ.load(Ordering::Relaxed);
+    // `p_align` is the PT_TLS alignment as the LINKER saw it: variant-II offsets
+    // are `sym_off - round_up(memsz, p_align)`, so `tls_size` must round by the
+    // same value or every #[thread_local] is shifted. `tp_align` over-aligns the
+    // TCB/TP for general x86-64 safety without perturbing those offsets.
+    let p_align = TLS_ALIGN.load(Ordering::Relaxed).max(1);
+    let tp_align = p_align.max(16);
+    let image_addr = TLS_IMAGE.load(Ordering::Relaxed);
+    let image = ptr::with_exposed_provenance::<u8>(image_addr);
+
+    // TLS data occupies `tls_size` bytes just below TP; the TCB sits at TP.
+    let tls_size = round_up(memsz, p_align);
+    let total = tls_size + TCB_SIZE;
+    let map_len = round_up(total + tp_align, PAGE);
+    let raw = mmap(map_len);
+    if raw.is_null() {
+        return (ptr::null_mut(), ptr::null_mut(), 0);
+    }
+
+    // Put TP at a `tp_align`-aligned address at least `tls_size` into the mapping;
+    // the block base = TP - tls_size is then p_align-aligned (tls_size is a
+    // p_align multiple), so each thread-local lands exactly where the linker
+    // placed it. Deriving base from TP (not TP from a rounded base) is what keeps
+    // `tls_size` equal to the linker's `round_up(memsz, p_align)`.
+    let tp_addr = round_up(raw.expose_provenance() + tls_size, tp_align);
+    let base = ptr::with_exposed_provenance_mut::<u8>(tp_addr - tls_size);
+    // SAFETY: `base + tls_size + TCB_SIZE <= raw + map_len` by construction.
+    let tp = ptr::with_exposed_provenance_mut::<u8>(tp_addr) as *mut Tcb;
+
+    // Copy the `.tdata` init image into [base, base+filesz); the rest of the
+    // block (`.tbss` and rounding pad) is already zero from the fresh mapping.
+    if !image.is_null() && filesz > 0 {
+        // SAFETY: `image..image+filesz` is the loaded PT_TLS file image; `base`
+        // has room for `tls_size >= memsz >= filesz` bytes.
+        unsafe { ptr::copy_nonoverlapping(image, base, filesz) };
+    }
+
+    // Initialize the TCB: self-pointer first (ABI), the rest is already zeroed.
+    // SAFETY: `tp` points at TCB_SIZE writable, fresh bytes.
+    unsafe {
+        (*tp).self_ptr = tp;
+        (*tp).heap = ptr::null_mut();
+        (*tp).dtors = ptr::null_mut();
+    }
+    (tp, raw, map_len)
+}
+
+/// Walk the process stack image to the auxiliary vector, find `PT_TLS`, and
+/// capture the static-TLS template. Then build the main thread's TLS block and
+/// install it in `%fs`. Must run before any allocation or thread-local access.
+///
+/// `stack` points at `argc`, as the kernel left it for `_start`.
+pub unsafe fn init_main(stack: *const usize) {
+    // Layout: [argc][argv...][NULL][envp...][NULL][auxv pairs...][AT_NULL].
+    let argc = unsafe { *stack } as usize;
+    // Step past argv (argc entries + NULL) to envp.
+    let mut p = unsafe { stack.add(1 + argc + 1) };
+    // Step past envp to the auxv.
+    while unsafe { *p } != 0 {
+        p = unsafe { p.add(1) };
+    }
+    let mut aux = unsafe { p.add(1) } as *const u64;
+
+    let (mut phdr, mut phent, mut phnum) = (0usize, 56usize, 0usize);
+    loop {
+        let a_type = unsafe { *aux };
+        let a_val = unsafe { *aux.add(1) };
+        match a_type {
+            AT_NULL => break,
+            AT_PHDR => phdr = a_val as usize,
+            AT_PHENT => phent = a_val as usize,
+            AT_PHNUM => phnum = a_val as usize,
+            _ => {}
+        }
+        aux = unsafe { aux.add(2) };
+    }
+    // Publish the program-header table for the unwinder's FDE finder.
+    PHDR.store(phdr, Ordering::Relaxed);
+    PHENT.store(phent, Ordering::Relaxed);
+    PHNUM.store(phnum, Ordering::Relaxed);
+
+    // Scan the program headers for PT_TLS. Non-PIE → load bias 0, so p_vaddr is
+    // already the absolute address of the init image.
+    if phdr != 0 {
+        for i in 0..phnum {
+            let ph = phdr + i * phent;
+            let ty = unsafe { rd_u32(ph + PH_TYPE) };
+            if ty == PT_TLS {
+                let vaddr = unsafe { rd_u64(ph + PH_VADDR) } as usize;
+                let filesz = unsafe { rd_u64(ph + PH_FILESZ) } as usize;
+                let memsz = unsafe { rd_u64(ph + PH_MEMSZ) } as usize;
+                let align = unsafe { rd_u64(ph + PH_ALIGN) } as usize;
+                TLS_IMAGE.store(vaddr, Ordering::Relaxed);
+                TLS_FILESZ.store(filesz, Ordering::Relaxed);
+                TLS_MEMSZ.store(memsz, Ordering::Relaxed);
+                // Keep the REAL PT_TLS alignment — the linker computes variant-II
+                // thread-local offsets against `round_up(memsz, p_align)`, so the
+                // runtime must round by the same value (build_block over-aligns TP
+                // separately). Forcing 16 here shifts every #[thread_local] by 8
+                // whenever memsz isn't a multiple of 16 (e.g. Rust 1.90's 104).
+                TLS_ALIGN.store(align.max(1), Ordering::Relaxed);
+                break;
+            }
+        }
+    }
+    TLS_READY.store(1, Ordering::Release);
+
+    let (tp, _, _) = build_block();
+    if !tp.is_null() {
+        unsafe { set_fs(tp) };
+    }
+}
+
+/// Build a spawned thread's TLS block for the *parent* to hand to `clone` via
+/// `CLONE_SETTLS`, so the kernel installs `%fs` before the child runs a single
+/// instruction (the child trampoline allocates immediately, which reads `%fs`).
+///
+/// Returns `(tp, block_base, block_len)`: `tp` is the `CLONE_SETTLS` argument;
+/// `block_base`/`block_len` are the mapping the joiner `munmap`s once the thread
+/// has exited. All-null on allocation failure.
+pub fn build_thread_block() -> (*mut Tcb, *mut u8, usize) {
+    build_block()
+}
