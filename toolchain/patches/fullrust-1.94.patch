@@ -0,0 +1,28 @@
+//! Platform-specific extensions to `std` for the `fullrust` target.
+//!
+//! `fullrust` is a libc-free, fully static Linux-ABI target that is
+//! deliberately *not* a member of the `unix` target family (so `cfg(unix)` is
+//! false and std selects its own raw-syscall platform layer). It nonetheless
+//! speaks the ordinary Unix file-descriptor ABI, so — exactly like the other
+//! non-unix fd targets (`hermit`, `wasi`) — it re-exports [`std::os::fd`] here
+//! under `std::os::fullrust::io`, giving crates the usual
+//! `AsFd`/`AsRawFd`/`OwnedFd` interop without pulling in the `unix` module.
+//!
+//! [`std::os::fd`]: crate::os::fd
+
+#![stable(feature = "rust1", since = "1.0.0")]
+#![deny(unsafe_op_in_unsafe_fn)]
+
+pub mod ffi;
+pub mod io;
+
+/// A prelude for conveniently writing platform-specific code.
+#[stable(feature = "rust1", since = "1.0.0")]
+pub mod prelude {
+    #[doc(no_inline)]
+    #[stable(feature = "rust1", since = "1.0.0")]
+    pub use super::ffi::{OsStrExt, OsStringExt};
+    #[doc(no_inline)]
+    #[stable(feature = "rust1", since = "1.0.0")]
+    pub use super::io::{AsFd, AsRawFd, BorrowedFd, FromRawFd, IntoRawFd, OwnedFd, RawFd};
+}
