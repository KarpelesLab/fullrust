--- /dev/null
+++ b/library/backtrace/src/backtrace/frameptr.rs
@@ -0,0 +1,78 @@
+//! Frame-pointer stack unwinding, for targets with no unwinder or DWARF
+//! `.eh_frame` (e.g. the libc-free `fullrust` target: `panic = abort`, no
+//! libunwind). The target forces frame pointers on (`frame_pointer: Always`),
+//! and its entry points zero the base pointer at the outermost frame, so the
+//! saved-frame-pointer chain is walkable and terminates cleanly.
+
+use core::ffi::c_void;
+
+// Addresses are stored as `usize` (not raw pointers) so a captured `Frame` is
+// `Send + Sync`, which `std::backtrace::Backtrace` requires of stored frames.
+#[derive(Clone)]
+pub struct Frame {
+    ip: usize,
+    sp: usize,
+}
+
+impl Frame {
+    pub fn ip(&self) -> *mut c_void {
+        self.ip as *mut c_void
+    }
+
+    pub fn sp(&self) -> *mut c_void {
+        self.sp as *mut c_void
+    }
+
+    pub fn symbol_address(&self) -> *mut c_void {
+        self.ip as *mut c_void
+    }
+
+    pub fn module_base_address(&self) -> Option<*mut c_void> {
+        None
+    }
+}
+
+/// Walk the saved-frame-pointer chain, invoking `cb` for each return address.
+///
+/// SAFETY: reads the frame-record chain rooted at the current frame pointer.
+/// This is sound only because the target guarantees frame pointers and a
+/// null-terminated chain; the alignment / monotonicity / depth guards below
+/// stop the walk before it can dereference a bogus pointer.
+#[inline(never)]
+pub unsafe fn trace(cb: &mut dyn FnMut(&super::Frame) -> bool) {
+    const WORD: usize = core::mem::size_of::<usize>();
+
+    let mut fp: usize;
+    #[cfg(target_arch = "x86_64")]
+    unsafe {
+        core::arch::asm!("mov {}, rbp", out(reg) fp, options(nomem, nostack, preserves_flags));
+    }
+    #[cfg(target_arch = "aarch64")]
+    unsafe {
+        core::arch::asm!("mov {}, x29", out(reg) fp, options(nomem, nostack, preserves_flags));
+    }
+    #[cfg(not(any(target_arch = "x86_64", target_arch = "aarch64")))]
+    {
+        let _ = cb;
+        return;
+    }
+
+    // A standard frame record is `[fp] = caller fp`, `[fp + WORD] = return addr`.
+    // The chain must strictly increase (stacks grow down) and stay word-aligned;
+    // both `_start` and the thread trampoline zero the base pointer at the top.
+    let mut prev = 0usize;
+    let mut depth = 0usize;
+    while fp != 0 && fp & (WORD - 1) == 0 && fp > prev && depth < 256 {
+        let ret = unsafe { ((fp + WORD) as *const usize).read() };
+        if ret == 0 {
+            break;
+        }
+        let frame = super::Frame { inner: Frame { ip: ret, sp: fp + 2 * WORD } };
+        if !cb(&frame) {
+            break;
+        }
+        prev = fp;
+        fp = unsafe { (fp as *const usize).read() };
+        depth += 1;
+    }
+}
