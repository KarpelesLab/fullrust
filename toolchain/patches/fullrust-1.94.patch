index 00000000..0f4de215
--- /dev/null
+++ b/library/std/src/sys/pal/fullrust/eh_frame.rs
@@ -0,0 +1,80 @@
+//! Runtime `.eh_frame` discovery for the pure-Rust `unwinding` backend.
+//!
+//! The unwinder (via `library/unwind`, `fde-custom` feature) needs to be told
+//! where the DWARF unwind tables live. On a normal glibc target this comes from
+//! `dl_iterate_phdr`; here there is no libc, so we read the process program
+//! headers (captured from the auxv by [`super::tls::init_main`]) to find the
+//! `PT_GNU_EH_FRAME` segment (`.eh_frame_hdr`) and the text `PT_LOAD` — exactly
+//! what the `unwinding` crate's `fde-phdr-aux` path does, without libc.
+
+use super::{rd_u32, rd_u64, tls};
+use crate::ops::Range;
+
+// Elf64_Phdr field offsets.
+const PH_TYPE: usize = 0; // u32
+const PH_VADDR: usize = 16; // u64
+const PH_MEMSZ: usize = 40; // u64
+
+const PT_LOAD: u32 = 1;
+const PT_PHDR: u32 = 6;
+const PT_GNU_EH_FRAME: u32 = 0x6474_e550;
+
+struct PhdrFinder;
+static FINDER: PhdrFinder = PhdrFinder;
+
+// SAFETY: `find` only reads the process's own immutable program-header table and
+// returns addresses within the loaded image.
+unsafe impl unwind::EhFrameFinder for PhdrFinder {
+    fn find(&self, pc: usize) -> Option<unwind::FrameInfo> {
+        let (phdr, phent, phnum) = tls::program_headers();
+        if phdr == 0 || phnum == 0 {
+            return None;
+        }
+
+        // Recover the load bias from the known runtime address of the header
+        // table and the `PT_PHDR` stated vaddr (0 for a non-PIE static binary,
+        // but this also handles a PIE).
+        let mut base = 0usize;
+        for i in 0..phnum {
+            let ph = phdr + i * phent;
+            if unsafe { rd_u32(ph + PH_TYPE) } == PT_PHDR {
+                base = phdr.wrapping_sub(unsafe { rd_u64(ph + PH_VADDR) } as usize);
+                break;
+            }
+        }
+
+        // Locate the text segment containing `pc` and the `.eh_frame_hdr`.
+        let mut text: Option<Range<usize>> = None;
+        let mut eh_frame_hdr = 0usize;
+        for i in 0..phnum {
+            let ph = phdr + i * phent;
+            let ty = unsafe { rd_u32(ph + PH_TYPE) };
+            let start = base + unsafe { rd_u64(ph + PH_VADDR) } as usize;
+            match ty {
+                PT_LOAD => {
+                    let end = start + unsafe { rd_u64(ph + PH_MEMSZ) } as usize;
+                    if (start..end).contains(&pc) {
+                        text = Some(start..end);
+                    }
+                }
+                PT_GNU_EH_FRAME => eh_frame_hdr = start,
+                _ => {}
+            }
+        }
+
+        let text = text?;
+        if eh_frame_hdr == 0 {
+            return None;
+        }
+        Some(unwind::FrameInfo {
+            text_base: Some(text.start),
+            kind: unwind::FrameInfoKind::EhFrameHdr(eh_frame_hdr),
+        })
+    }
+}
+
+/// Register the FDE finder with the unwinder. Called once at startup, before any
+/// unwinding can occur.
+pub fn init() {
+    let _ = unwind::set_custom_eh_frame_finder(&FINDER);
+}
diff --git a/library/std/src/sys/pal/fullrust/fd.rs b/library/std/src/sys/pal/fullrust/fd.rs
new file mode 100644
index 00000000..ef068525
--- /dev/null
+++ b/library/std/src/sys/pal/fullrust/fd.rs
@@ -0,0 +1,224 @@
+//! An owned file descriptor and the operations common to everything backed by
+//! one — `File`, `AnonPipe`, and the socket layer. Each of those wraps a
+//! `FileDesc` instead of re-implementing read/write/vectored I/O, `dup`, and
+//! close, so the raw-syscall plumbing lives in exactly one place.
+//!
+//! `FileDesc` is a thin wrapper over [`OwnedFd`]: ownership, the close-on-drop,
+//! and the fd-safety guarantees all come from `OwnedFd`, and the whole
+//! `std::os::fd` interop surface (`AsFd`, `AsRawFd`, `OwnedFd` round-tripping)
+//! is wired up here by implementing the same trait web the `unix`/`hermit`
+//! `FileDesc`s do. That is what lets `File`/`TcpStream`/`PipeReader`/… expose
+//! `as_fd()`/`as_raw_fd()` on the fullrust target.
+
+use super::sysc;
+use crate::fmt;
+use crate::io::{self, BorrowedCursor, IoSlice, IoSliceMut};
+use crate::os::fullrust::io::{AsFd, AsRawFd, BorrowedFd, FromRawFd, IntoRawFd, OwnedFd, RawFd};
+use crate::sys::{AsInner, FromInner, IntoInner};
+
+// fcntl(2) commands / flags used here.
+const F_GETFL: usize = 3;
+const F_SETFL: usize = 4;
+const F_DUPFD_CLOEXEC: usize = 1030;
+const O_NONBLOCK: usize = 0o4000;
+// Maximum iovec count the kernel accepts in one readv/writev (UIO_MAXIOV).
+const IOV_MAX: usize = 1024;
+
+/// Interpret a raw syscall return as `io::Result<usize>` (an `Err` is the errno).
+/// The one place this mapping lives; every fullrust `sys` module routes through it.
+#[inline]
+pub(crate) fn cvt(r: usize) -> io::Result<usize> {
+    sysc::ret(r).map_err(io::Error::from_raw_os_error)
+}
+
+/// `fcntl(fd, F_DUPFD_CLOEXEC, min)`: duplicate `fd` onto the lowest free
+/// descriptor `>= min`, close-on-exec, returning the new raw fd. Shared by
+/// [`FileDesc::duplicate`] and `BorrowedFd::try_clone_to_owned`.
+pub(crate) fn fcntl_dupfd_cloexec(fd: i32, min: i32) -> io::Result<i32> {
+    let new =
+        cvt(unsafe { sysc::syscall3(sysc::FCNTL, fd as usize, F_DUPFD_CLOEXEC, min as usize) })?;
+    Ok(new as i32)
+}
+
+/// `close(fd)`, ignoring the result. This is where an [`OwnedFd`] is actually
+/// released (see its `Drop`), so it lives here next to the other fd syscalls.
+///
+/// # Safety
+///
+/// `fd` must be an owned descriptor that nothing else will use afterwards
+/// (exactly the `OwnedFd`-drop contract).
+pub(crate) unsafe fn close_raw(fd: i32) {
+    unsafe {
+        sysc::syscall1(sysc::CLOSE, fd as usize);
+    }
+}
+
+/// An owned file descriptor: a newtype over [`OwnedFd`] that adds the raw
+/// read/write/dup syscalls shared by every fd-backed std type.
+pub struct FileDesc(OwnedFd);
+
+impl FileDesc {
+    /// Take ownership of a raw descriptor. The fd must be open and owned by the
+    /// caller (it will be closed when the `FileDesc` is dropped).
+    #[inline]
+    pub fn from_raw(fd: i32) -> FileDesc {
+        // SAFETY: every caller passes a freshly-obtained, owned descriptor.
+        unsafe { FileDesc(OwnedFd::from_raw_fd(fd)) }
+    }
+
+    #[inline]
+    pub fn raw(&self) -> i32 {
+        self.0.as_raw_fd()
+    }
+
+    /// Consume without closing, returning the raw descriptor.
+    #[inline]
+    pub fn into_raw(self) -> i32 {
+        self.0.into_raw_fd()
+    }
+
+    pub fn read(&self, buf: &mut [u8]) -> io::Result<usize> {
+        cvt(unsafe {
+            sysc::syscall3(sysc::READ, self.raw() as usize, buf.as_mut_ptr() as usize, buf.len())
+        })
+    }
+
+    pub fn read_buf(&self, mut cursor: BorrowedCursor<'_>) -> io::Result<()> {
+        let n = cvt(unsafe {
+            let dst = cursor.as_mut().as_mut_ptr() as usize;
+            sysc::syscall3(sysc::READ, self.raw() as usize, dst, cursor.capacity())
+        })?;
+        // SAFETY: the kernel initialized the first `n` bytes of the cursor.
+        unsafe { cursor.advance_unchecked(n) };
+        Ok(())
+    }
+
+    pub fn read_vectored(&self, bufs: &mut [IoSliceMut<'_>]) -> io::Result<usize> {
+        // `IoSliceMut` is `repr(transparent)` over `iovec`, so the slice is a
+        // ready-made iovec array; cap the count at IOV_MAX.
+        let n = bufs.len().min(IOV_MAX);
+        cvt(unsafe {
+            sysc::syscall3(sysc::READV, self.raw() as usize, bufs.as_mut_ptr() as usize, n)
+        })
+    }
+
+    pub fn write(&self, buf: &[u8]) -> io::Result<usize> {
+        cvt(unsafe {
+            sysc::syscall3(sysc::WRITE, self.raw() as usize, buf.as_ptr() as usize, buf.len())
+        })
+    }
+
+    pub fn write_vectored(&self, bufs: &[IoSlice<'_>]) -> io::Result<usize> {
+        let n = bufs.len().min(IOV_MAX);
+        cvt(unsafe { sysc::syscall3(sysc::WRITEV, self.raw() as usize, bufs.as_ptr() as usize, n) })
+    }
+
+    /// Duplicate the descriptor, close-on-exec (`F_DUPFD_CLOEXEC`).
+    pub fn duplicate(&self) -> io::Result<FileDesc> {
+        Ok(FileDesc::from_raw(fcntl_dupfd_cloexec(self.raw(), 0)?))
+    }
+
+    /// Alias of [`duplicate`](Self::duplicate); the name `io::Pipe*` expects.
+    #[inline]
+    pub fn try_clone(&self) -> io::Result<FileDesc> {
+        self.duplicate()
+    }
+
+    #[inline]
+    pub fn is_read_vectored(&self) -> bool {
+        true
+    }
+
+    #[inline]
+    pub fn is_write_vectored(&self) -> bool {
+        true
+    }
+
+    /// Read to EOF, appending into `buf`. Retries on `EINTR`.
+    pub fn read_to_end(&self, buf: &mut Vec<u8>) -> io::Result<usize> {
+        let mut total = 0;
+        let mut tmp = [0u8; 8192];
+        loop {
+            match self.read(&mut tmp) {
+                Ok(0) => break,
+                Ok(n) => {
+                    buf.extend_from_slice(&tmp[..n]);
+                    total += n;
+                }
+                Err(ref e) if e.kind() == io::ErrorKind::Interrupted => continue,
+                Err(e) => return Err(e),
+            }
+        }
+        Ok(total)
+    }
+
+    pub fn set_nonblocking(&self, nonblocking: bool) -> io::Result<()> {
+        let flags = cvt(unsafe { sysc::syscall3(sysc::FCNTL, self.raw() as usize, F_GETFL, 0) })?;
+        let new = if nonblocking { flags | O_NONBLOCK } else { flags & !O_NONBLOCK };
+        cvt(unsafe { sysc::syscall3(sysc::FCNTL, self.raw() as usize, F_SETFL, new) })?;
+        Ok(())
+    }
+}
+
+impl fmt::Debug for FileDesc {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        f.debug_struct("FileDesc").field("fd", &self.raw()).finish()
+    }
+}
+
+// --- `std::os::fd` interop -------------------------------------------------
+//
+// The owning fd type is `OwnedFd`; these impls chain `FileDesc` into the shared
+// `os::fd` machinery exactly as `sys/fd/unix.rs` and `sys/fd/hermit.rs` do, so
+// `File`/`Socket`/`AnonPipe` (which each wrap a `FileDesc`) get the full
+// `AsFd`/`AsRawFd`/`OwnedFd` surface for free.
+
+impl AsInner<OwnedFd> for FileDesc {
+    #[inline]
+    fn as_inner(&self) -> &OwnedFd {
+        &self.0
+    }
+}
+
+impl IntoInner<OwnedFd> for FileDesc {
+    #[inline]
+    fn into_inner(self) -> OwnedFd {
+        self.0
+    }
+}
+
+impl FromInner<OwnedFd> for FileDesc {
+    #[inline]
+    fn from_inner(owned: OwnedFd) -> Self {
+        FileDesc(owned)
+    }
+}
+
+impl AsFd for FileDesc {
+    #[inline]
+    fn as_fd(&self) -> BorrowedFd<'_> {
+        self.0.as_fd()
+    }
+}
+
+impl AsRawFd for FileDesc {
+    #[inline]
+    fn as_raw_fd(&self) -> RawFd {
+        self.0.as_raw_fd()
+    }
+}
+
+impl IntoRawFd for FileDesc {
+    #[inline]
+    fn into_raw_fd(self) -> RawFd {
+        self.0.into_raw_fd()
+    }
+}
+
+impl FromRawFd for FileDesc {
+    #[inline]
+    unsafe fn from_raw_fd(fd: RawFd) -> Self {
+        // SAFETY: guaranteed by the caller of the (unsafe) `FromRawFd` trait.
+        FileDesc(unsafe { OwnedFd::from_raw_fd(fd) })
+    }
+}
diff --git a/library/std/src/sys/pal/fullrust/futex.rs b/library/std/src/sys/pal/fullrust/futex.rs
new file mode 100644
index 00000000..47cf7101
--- /dev/null
+++ b/library/std/src/sys/pal/fullrust/futex.rs
@@ -0,0 +1,62 @@
+//! Futex primitives on the raw Linux `futex(2)` syscall (private futexes).
+//!
+//! This is the interface std's futex-based Mutex/Condvar/RwLock/Once/Parker are
+//! written against. Mirrors `pal::unix::futex` but calls the syscall directly.
+
+use super::sysc;
+use crate::sync::atomic::Atomic;
+use crate::sync::atomic::Ordering::Relaxed;
+use crate::time::Duration;
+
+/// An atomic for use as a futex that is at least 32-bits but may be larger.
+pub type Futex = Atomic<Primitive>;
+/// Must be the underlying type of Futex.
+pub type Primitive = u32;
+
+/// An atomic for use as a futex that is at least 8-bits but may be larger.
+pub type SmallFutex = Atomic<SmallPrimitive>;
+/// Must be the underlying type of SmallFutex.
+pub type SmallPrimitive = u32;
+
+const SYS_FUTEX: usize = 202;
+const FUTEX_WAIT_PRIVATE: usize = 0 | 128; // FUTEX_WAIT | FUTEX_PRIVATE_FLAG
+const FUTEX_WAKE_PRIVATE: usize = 1 | 128; // FUTEX_WAKE | FUTEX_PRIVATE_FLAG
+
+/// Waits for a `futex_wake` operation to wake us, returning early if the futex
+/// no longer holds `expected`. Returns false on timeout, true otherwise.
+pub fn futex_wait(futex: &Atomic<u32>, expected: u32, timeout: Option<Duration>) -> bool {
+    let ptr = futex as *const Atomic<u32> as usize;
+    // `FUTEX_WAIT` takes a *relative* timeout (timespec), or NULL for forever.
+    let ts = timeout.map(|d| [d.as_secs() as i64, d.subsec_nanos() as i64]);
+    loop {
+        // No need to wait if the value already changed.
+        if futex.load(Relaxed) != expected {
+            return true;
+        }
+        let ts_ptr = ts.as_ref().map_or(0usize, |t| t.as_ptr() as usize);
+        let r = unsafe {
+            sysc::syscall6(SYS_FUTEX, ptr, FUTEX_WAIT_PRIVATE, expected as usize, ts_ptr, 0, 0)
+        };
+        match sysc::ret(r) {
+            Err(110) => return false, // ETIMEDOUT
+            Err(4) => continue,       // EINTR
+            _ => return true,         // woken, or EAGAIN (value changed)
+        }
+    }
+}
+
+/// Wakes one thread blocked on `futex_wait` on this futex. Returns whether a
+/// thread was actually woken.
+pub fn futex_wake(futex: &Atomic<u32>) -> bool {
+    let ptr = futex as *const Atomic<u32> as usize;
+    let r = unsafe { sysc::syscall3(SYS_FUTEX, ptr, FUTEX_WAKE_PRIVATE, 1) };
+    sysc::ret(r).map(|n| n > 0).unwrap_or(false)
+}
+
+/// Wakes all threads blocked on `futex_wait` on this futex.
+pub fn futex_wake_all(futex: &Atomic<u32>) {
+    let ptr = futex as *const Atomic<u32> as usize;
+    unsafe {
+        sysc::syscall3(SYS_FUTEX, ptr, FUTEX_WAKE_PRIVATE, i32::MAX as usize);
+    }
+}
diff --git a/library/std/src/sys/pal/fullrust/heap.rs b/library/std/src/sys/pal/fullrust/heap.rs
new file mode 100644
index 00000000..da8bd67d
--- /dev/null
+++ b/library/std/src/sys/pal/fullrust/heap.rs
@@ -0,0 +1,1201 @@
+//! A mimalloc-class global allocator for the fullrust target.
+//!
+//! The design follows mimalloc's "free-list sharding" model, adapted to a
+//! libc-free Linux target on raw syscalls:
+//!
+//!   * **Per-thread heaps.** Each thread owns a `Heap`, reached in one load off
+//!     the `%fs` TCB (see [`super::tls`]). The hot alloc/free path touches only
+//!     the owning thread's data — no lock, no atomics, no syscall.
+//!
+//!   * **Segments, pages, and tiers.** Memory comes from 4 MiB, 4 MiB-aligned
+//!     segments (`mmap`). A segment belongs to one *kind* and is sliced into
+//!     equal *pages*, each serving one size class:
+//!       - **Small** — 64 KiB pages (page 0 is the header; 63 data pages),
+//!         objects `<= 8 KiB`.
+//!       - **Medium** — 512 KiB pages (8 per segment; page 0 also carries the
+//!         header), objects `8 KiB .. 128 KiB`.
+//!       - **Large** — the whole 4 MiB is one page (also header-bearing),
+//!         objects `128 KiB .. 512 KiB` (several blocks per page).
+//!     Because segments are 4 MiB-aligned, a block's segment (and its `kind`,
+//!     stored in the header) is recovered from any block pointer by masking — so
+//!     there is **no per-allocation header** and free routes with no size lookup.
+//!     Objects above 512 KiB, or over-aligned requests that don't fit a tier,
+//!     take a dedicated page-rounded `mmap`; page-aligned huge mappings are kept
+//!     in a small per-thread reuse cache (`MADV_DONTNEED`'d, so they hold no RSS
+//!     yet re-fault as zero) so repeated large-buffer churn avoids syscalls.
+//!
+//!   * **Sharded free lists.** A page has a `free` list owned exclusively by the
+//!     allocating thread (popped/pushed with no atomics) and an atomic
+//!     `thread_free` list onto which *other* threads push when they free a block
+//!     they don't own. The owner folds `thread_free` into `free` only when its
+//!     local list runs dry — so cross-thread frees never contend the fast path.
+//!     Medium and large blocks live on the exact same sharded lists as small
+//!     ones; the tier machinery is a single code path parameterized by `kind`.
+//!
+//!   * **Size classes.** 36 small classes (8 B, then 16 B-spaced, then geometric
+//!     to 8 KiB), 16 medium (2 KiB-spaced to 128 KiB), 8 large (32 KiB-spaced to
+//!     512 KiB). Every class above 8 B is a multiple of 16, so an allocation with
+//!     `align <= 16` is served by class selection alone. An **over-aligned**
+//!     request (`align > 16`) is routed to the smallest power-of-two class `>=`
+//!     its rounded need: a power-of-two class is a multiple of the (power-of-two)
+//!     alignment, and page bases are `>= 512 KiB`-aligned, so every block is
+//!     correctly aligned with no per-object fixup.
+//!
+//! Memory is returned to the OS when a page empties (`madvise(MADV_FREE)`, taking
+//! care never to advise the segment header) and a fully-empty *owned* segment is
+//! `munmap`ped, so for a single thread resident size tracks live bytes. A segment
+//! *abandoned* by an exited thread whose blocks are later freed cross-thread is
+//! reclaimed either on demand (the next thread to reclaim that kind, via
+//! `reclaim_segment`) or when any thread exits (`scavenge_abandoned` folds and
+//! unmaps emptied abandoned segments). Only in the absence of any further thread
+//! exits *and* any further allocation of that kind can such a segment linger
+//! (bounded by the peak number abandoned) — matching mimalloc's demand-driven
+//! abandoned-segment reclamation.
+
+use super::sysc;
+use super::tls;
+use crate::ptr;
+use crate::sync::atomic::{AtomicBool, AtomicPtr, Ordering};
+
+// --- geometry -------------------------------------------------------------
+
+const SEGMENT_SHIFT: usize = 22;
+const SEGMENT_SIZE: usize = 1 << SEGMENT_SHIFT; // 4 MiB
+const SEGMENT_MASK: usize = SEGMENT_SIZE - 1;
+
+const SMALL_SHIFT: usize = 16; // 64 KiB pages
+const MED_SHIFT: usize = 19; //   512 KiB pages
+const LARGE_SHIFT: usize = 22; // 4 MiB page (whole segment)
+
+/// Max pages in a segment (small kind: 64; page 0 is the header slot).
+const MAX_PAGES: usize = SEGMENT_SIZE / (1 << SMALL_SHIFT); // 64
+
+const OS_PAGE: usize = 4096;
+
+// Tier size boundaries (all recomputable from a `Layout`, so free stays
+// header-free). `need = round_up(max(size,1), max(align,1))`.
+const MAX_SMALL: usize = 8192; //   <= this  -> small
+const MED_MAX: usize = 131072; //   <= this  -> medium (128 KiB)
+const LARGE_MAX: usize = 524288; //  <= this -> large  (512 KiB); above -> huge
+
+/// The three segment kinds. `Kind as usize` indexes the per-kind arrays.
+#[derive(Copy, Clone, PartialEq, Eq)]
+enum Kind {
+    Small = 0,
+    Medium = 1,
+    Large = 2,
+}
+const NUM_KINDS: usize = 3;
+
+impl Kind {
+    #[inline]
+    fn shift(self) -> usize {
+        match self {
+            Kind::Small => SMALL_SHIFT,
+            Kind::Medium => MED_SHIFT,
+            Kind::Large => LARGE_SHIFT,
+        }
+    }
+    /// First usable page slot: small keeps page 0 as a pure header, medium/large
+    /// use page 0 too (skipping the header region within it).
+    #[inline]
+    fn first_page(self) -> usize {
+        match self {
+            Kind::Small => 1,
+            _ => 0,
+        }
+    }
+    /// Number of page slots in a segment of this kind (64 / 8 / 1).
+    #[inline]
+    fn pages(self) -> usize {
+        SEGMENT_SIZE >> self.shift()
+    }
+    #[inline]
+    fn idx(self) -> usize {
+        self as usize
+    }
+    #[inline]
+    fn from_u8(v: u8) -> Kind {
+        match v {
+            0 => Kind::Small,
+            1 => Kind::Medium,
+            _ => Kind::Large,
+        }
+    }
+}
+
+// --- size classes ---------------------------------------------------------
+
+/// Small classes (bytes). All but the first are multiples of 16.
+const SMALL_CLASSES: [u32; 36] = [
+    8, 16, 24, 32, 40, 48, 56, 64, 80, 96, 112, 128, 160, 192, 224, 256, 320, 384, 448, 512, 640,
+    768, 896, 1024, 1280, 1536, 1792, 2048, 2560, 3072, 3584, 4096, 5120, 6144, 7168, 8192,
+];
+/// Medium classes (bytes): multiples of 2 KiB up to 128 KiB. Includes the
+/// powers of two 16/32/64/128 KiB used to satisfy over-aligned requests.
+const MED_CLASSES: [u32; 16] = [
+    10240, 12288, 14336, 16384, 20480, 24576, 28672, 32768, 40960, 49152, 57344, 65536, 81920,
+    98304, 114688, 131072,
+];
+/// Large classes (bytes): multiples of 32 KiB up to 512 KiB. Includes 256/512
+/// KiB for over-aligned requests.
+const LARGE_CLASSES: [u32; 8] =
+    [163840, 196608, 229376, 262144, 327680, 393216, 458752, 524288];
+
+const N_SMALL: usize = SMALL_CLASSES.len(); // 36
+const N_MED: usize = MED_CLASSES.len(); // 16
+const N_LARGE: usize = LARGE_CLASSES.len(); // 8
+/// Unified class index space: `0..36` small, `36..52` medium, `52..60` large.
+const NUM_CLASSES: usize = N_SMALL + N_MED + N_LARGE; // 60
+
+const IDX_LEN: usize = MAX_SMALL / 8; // 1024
+
+/// `IDX[(need - 1) >> 3]` is the small class index for `1 <= need <= MAX_SMALL`.
+const IDX: [u8; IDX_LEN] = build_idx();
+
+const fn build_idx() -> [u8; IDX_LEN] {
+    let mut t = [0u8; IDX_LEN];
+    let mut b = 0;
+    while b < IDX_LEN {
+        let target = (b + 1) * 8;
+        let mut i = 0;
+        while i < N_SMALL {
+            if SMALL_CLASSES[i] as usize >= target {
+                break;
+            }
+            i += 1;
+        }
+        t[b] = i as u8;
+        b += 1;
+    }
+    t
+}
+
+#[inline]
+fn class_size(class: usize) -> u32 {
+    if class < N_SMALL {
+        SMALL_CLASSES[class]
+    } else if class < N_SMALL + N_MED {
+        MED_CLASSES[class - N_SMALL]
+    } else {
+        LARGE_CLASSES[class - N_SMALL - N_MED]
+    }
+}
+
+#[inline]
+fn small_class_of(need: usize) -> usize {
+    IDX[(need - 1) >> 3] as usize
+}
+
+/// Smallest medium class `>= v` (unified index). `v` is in `(MAX_SMALL, MED_MAX]`.
+#[inline]
+fn med_class_of(v: usize) -> usize {
+    let mut i = 0;
+    while i < N_MED {
+        if MED_CLASSES[i] as usize >= v {
+            break;
+        }
+        i += 1;
+    }
+    N_SMALL + i
+}
+
+/// Smallest large class `>= v` (unified index). `v` is in `(MED_MAX, LARGE_MAX]`.
+#[inline]
+fn large_class_of(v: usize) -> usize {
+    let mut i = 0;
+    while i < N_LARGE {
+        if LARGE_CLASSES[i] as usize >= v {
+            break;
+        }
+        i += 1;
+    }
+    N_SMALL + N_MED + i
+}
+
+#[inline]
+fn round_up(v: usize, to: usize) -> usize {
+    (v + to - 1) & !(to - 1)
+}
+
+/// The single routing oracle: map a `Layout` to a paged tier+class or the huge
+/// path. `alloc`, `alloc_zeroed`, `dealloc`, and `realloc` all call this, so
+/// alloc and free never disagree about where a pointer lives.
+enum Route {
+    Paged(Kind, usize),
+    Huge,
+}
+
+#[inline]
+fn route(size: usize, align: usize) -> Route {
+    let need = round_up(size.max(1), align.max(1));
+    if align <= 16 {
+        if need <= MAX_SMALL {
+            Route::Paged(Kind::Small, small_class_of(need))
+        } else if need <= MED_MAX {
+            Route::Paged(Kind::Medium, med_class_of(need))
+        } else if need <= LARGE_MAX {
+            Route::Paged(Kind::Large, large_class_of(need))
+        } else {
+            Route::Huge
+        }
+    } else {
+        // Over-aligned: a power-of-two class is a multiple of the power-of-two
+        // alignment, and page bases are >= 512 KiB-aligned, so the block is
+        // aligned with no fixup. Tiny (<= 8 KiB) and giant (> 512 KiB)
+        // over-aligned requests fall to the huge path.
+        let c = need.next_power_of_two();
+        if c > MAX_SMALL && c <= MED_MAX {
+            Route::Paged(Kind::Medium, med_class_of(c))
+        } else if c > MED_MAX && c <= LARGE_MAX {
+            Route::Paged(Kind::Large, large_class_of(c))
+        } else {
+            Route::Huge
+        }
+    }
+}
+
+// --- raw OS memory --------------------------------------------------------
+// The plain anonymous-mmap helpers live in the pal root (shared with thread
+// stacks, the signal alt-stack, and TLS); the allocator's `os_alloc_segment`
+// below adds the 4 MiB alignment on top.
+use super::{madvise as os_madvise, mmap_anon as os_mmap, munmap as os_munmap};
+
+/// Map a fresh 4 MiB segment aligned to its size (over-map by one segment, then
+/// trim the head and tail). Returns the aligned base, or null.
+fn os_alloc_segment() -> *mut u8 {
+    let over = SEGMENT_SIZE * 2;
+    let raw = os_mmap(over);
+    if raw.is_null() {
+        return ptr::null_mut();
+    }
+    let raw_addr = raw.addr();
+    let base_addr = round_up(raw_addr, SEGMENT_SIZE);
+    if base_addr > raw_addr {
+        unsafe { os_munmap(raw_addr, base_addr - raw_addr) };
+    }
+    let tail = base_addr + SEGMENT_SIZE;
+    let end = raw_addr + over;
+    if end > tail {
+        unsafe { os_munmap(tail, end - tail) };
+    }
+    ptr::with_exposed_provenance_mut(base_addr)
+}
+
+// --- data structures ------------------------------------------------------
+
+/// A free block: when on a free list, its first word is the next pointer.
+#[repr(C)]
+struct Block {
+    next: *mut Block,
+}
+
+/// Per-page metadata, stored in the owning segment's header (never in the page's
+/// own data area, which stays fully usable).
+#[repr(C)]
+struct Page {
+    /// Owner-thread free list (no atomics).
+    free: *mut Block,
+    /// Cross-thread free list: other threads push here atomically.
+    thread_free: AtomicPtr<Block>,
+    /// Bump pointer for never-yet-allocated blocks in this page.
+    bump: *mut u8,
+    /// End of this page's data area.
+    bump_end: *mut u8,
+    /// Outstanding blocks (handed out, not yet freed/collected). `0` ⟹ empty.
+    used: u32,
+    /// Size class in bytes, or `0` for an unused page slot.
+    block_size: u32,
+    /// Unified class index (avoids re-deriving from `block_size`).
+    class: u16,
+    /// Links within the owning heap's per-class page list.
+    next: *mut Page,
+    prev: *mut Page,
+}
+
+/// A 4 MiB segment header (at the segment base). `pages[0]`'s data area holds
+/// this header; which page slots are usable depends on `kind`.
+#[repr(C)]
+struct Segment {
+    /// Owning heap, or null while abandoned. Atomic so a cross-thread freer can
+    /// read it while the owner publishes/abandons.
+    owner: AtomicPtr<Heap>,
+    /// This segment's kind (`Kind as u8`), so any code holding a segment pointer
+    /// — including a cross-thread freer that masked a block pointer — recovers
+    /// the page geometry without consulting the caller's `Layout`.
+    kind: u8,
+    /// Pages with `used > 0`. When this hits 0 the segment is fully free.
+    used_pages: u32,
+    /// Link in the owning heap's per-kind segment list.
+    next: *mut Segment,
+    prev: *mut Segment,
+    /// Link in the global per-kind abandoned-segment stack.
+    abandoned_next: *mut Segment,
+    pages: [Page; MAX_PAGES],
+}
+
+/// Bytes at the front of a segment reserved for its header. No block is ever
+/// placed here; computed once at compile time and rounded to an OS page so the
+/// `MADV_FREE` on page 0 can start cleanly past it.
+const HEADER_SIZE: usize = round_up_const(core::mem::size_of::<Segment>(), OS_PAGE);
+
+const fn round_up_const(v: usize, to: usize) -> usize {
+    (v + to - 1) & !(to - 1)
+}
+
+/// A per-thread heap: per-class active page lists, plus the owned segments split
+/// by kind. Created lazily on first allocation and reached via `%fs`.
+#[repr(C)]
+struct Heap {
+    /// Head page per unified size class (allocation tries this first).
+    active: [*mut Page; NUM_CLASSES],
+    /// Owned segments, one doubly linked list per kind.
+    segments: [*mut Segment; NUM_KINDS],
+    /// A small cache of fully-empty, still-committed segments per kind, kept for
+    /// immediate reuse so a single-object alloc/free churn doesn't `munmap` and
+    /// re-`mmap` its segment every cycle. Singly linked via `Segment::next`.
+    free_segs: [*mut Segment; NUM_KINDS],
+    free_count: [u32; NUM_KINDS],
+    /// A small cache of freed huge (`> LARGE_MAX`, page-aligned) mappings, kept
+    /// for reuse so repeated large-buffer churn avoids an `mmap`/`munmap` pair
+    /// each cycle. Each entry is `(base_addr, len)`; `len == 0` marks a free
+    /// slot. Cached mappings are `MADV_DONTNEED`'d, so they hold no RSS and
+    /// re-fault as zero (keeping `alloc_zeroed` correct).
+    huge_cache: [(usize, usize); HUGE_CACHE_N],
+    /// Total bytes currently parked in `huge_cache` (bounds retention).
+    huge_bytes: usize,
+}
+
+/// Number of cached huge mappings retained per thread.
+const HUGE_CACHE_N: usize = 16;
+/// Cap on total virtual bytes parked in a thread's huge cache.
+const HUGE_VA_MAX: usize = 32 << 20; // 32 MiB
+
+/// Empty-segment cache depth per kind. Small keeps its historical immediate-
+/// `munmap` behavior (0); medium/large retain a couple for churn. The bound is
+/// `cap * 4 MiB * kinds` of committed VA per thread (worst case 16 MiB here).
+const FREE_SEG_CAP: [u32; NUM_KINDS] = [0, 2, 2];
+
+// --- segment / page helpers ----------------------------------------------
+
+#[inline]
+fn segment_of(block: *mut u8) -> *mut Segment {
+    ptr::with_exposed_provenance_mut(block.addr() & !SEGMENT_MASK)
+}
+
+/// Data-area base and block count of page `i` in a `kind` segment, accounting
+/// for the header that lives at the front of page 0.
+#[inline]
+fn page_layout(seg: *mut Segment, i: usize, kind: Kind, bsize: usize) -> (usize, usize) {
+    let page_size = 1usize << kind.shift();
+    let base = (seg as *mut u8).addr() + i * page_size;
+    if i == 0 {
+        // Page 0 carries the Segment header: place the first block on the
+        // size-class grid just past it, so no block ever aliases the header.
+        let k0 = (HEADER_SIZE + bsize - 1) / bsize;
+        (base + k0 * bsize, page_size / bsize - k0)
+    } else {
+        (base, page_size / bsize)
+    }
+}
+
+// --- the global allocator -------------------------------------------------
+
+/// Spinlock guarding the global abandoned-segment stacks (touched only on thread
+/// exit and segment reclaim, both rare).
+static ABANDON_LOCK: AtomicBool = AtomicBool::new(false);
+/// One abandoned-segment stack per kind, so a thread reclaiming e.g. a medium
+/// segment never adopts a large one (their page geometry differs).
+static ABANDONED: [AtomicPtr<Segment>; NUM_KINDS] =
+    [const { AtomicPtr::new(ptr::null_mut()) }; NUM_KINDS];
+
+#[inline]
+fn lock_abandon() {
+    while ABANDON_LOCK
+        .compare_exchange_weak(false, true, Ordering::Acquire, Ordering::Relaxed)
+        .is_err()
+    {
+        core::hint::spin_loop();
+    }
+}
+#[inline]
+fn unlock_abandon() {
+    ABANDON_LOCK.store(false, Ordering::Release);
+}
+
+/// Return this thread's heap, creating it (from raw `mmap`, never the global
+/// allocator) on first use.
+#[inline]
+fn heap() -> *mut Heap {
+    let h = tls::heap() as *mut Heap;
+    if !h.is_null() { h } else { heap_init() }
+}
+
+#[cold]
+fn heap_init() -> *mut Heap {
+    // One or more OS pages hold the Heap struct; it is zero from a fresh mapping,
+    // so all `active` heads and `segments` start null.
+    let mem = os_mmap(round_up(core::mem::size_of::<Heap>(), OS_PAGE));
+    if mem.is_null() {
+        return ptr::null_mut();
+    }
+    let h = mem as *mut Heap;
+    tls::set_heap(h as *mut u8);
+    h
+}
+
+/// Pop one block from a page, folding in cross-thread frees and bumping a fresh
+/// block as needed. Returns null if the page is full.
+#[inline]
+unsafe fn page_alloc(p: *mut Page) -> *mut u8 {
+    let page = unsafe { &mut *p };
+    // Fast path: local free list.
+    let b = page.free;
+    if !b.is_null() {
+        page.free = unsafe { (*b).next };
+        page.used += 1;
+        return b as *mut u8;
+    }
+    // Local list empty: adopt any cross-thread frees.
+    let tf = page.thread_free.swap(ptr::null_mut(), Ordering::Acquire);
+    if !tf.is_null() {
+        // Count the adopted chain so `used` stays exact (those blocks were
+        // handed out but their frees haven't been subtracted yet).
+        let mut n: u32 = 0;
+        let mut node = tf;
+        while !node.is_null() {
+            n += 1;
+            node = unsafe { (*node).next };
+        }
+        page.used -= n;
+        let head = tf;
+        page.free = unsafe { (*head).next };
+        page.used += 1;
+        return head as *mut u8;
+    }
+    // Nothing freed: hand out a never-used block.
+    if page.bump.addr() < page.bump_end.addr() {
+        let b = page.bump;
+        page.bump = unsafe { page.bump.add(page.block_size as usize) };
+        page.used += 1;
+        return b;
+    }
+    ptr::null_mut()
+}
+
+/// Find a usable page slot in `h`'s `kind` segments (or a reclaimed/new segment)
+/// and initialize it for `class`, linking it as the head of the class list.
+#[cold]
+unsafe fn heap_alloc_page(h: *mut Heap, kind: Kind, class: usize) -> *mut Page {
+    let heap = unsafe { &mut *h };
+    let bsize = class_size(class);
+    let first = kind.first_page();
+    let per = kind.pages();
+
+    loop {
+        // Look for a free page slot (block_size == 0) in an owned segment. A
+        // reclaimed segment may have *live* pages re-queued at any slot, so we
+        // must take a genuinely free slot rather than assuming a fixed one.
+        let mut seg = heap.segments[kind.idx()];
+        while !seg.is_null() {
+            let s = unsafe { &mut *seg };
+            let mut i = first;
+            while i < per {
+                if s.pages[i].block_size == 0 {
+                    return unsafe { init_page(seg, i, kind, class, bsize, h) };
+                }
+                i += 1;
+            }
+            seg = s.next;
+        }
+
+        // No free slot in a live segment: reuse a cached empty segment (still
+        // committed — no syscall) before touching the OS.
+        let ki = kind.idx();
+        let cached = heap.free_segs[ki];
+        if !cached.is_null() {
+            let s = unsafe { &mut *cached };
+            heap.free_segs[ki] = s.next;
+            heap.free_count[ki] -= 1;
+            // Relink into the active segment list; all its pages are free.
+            s.prev = ptr::null_mut();
+            s.next = heap.segments[ki];
+            if !s.next.is_null() {
+                unsafe { (*s.next).prev = cached };
+            }
+            heap.segments[ki] = cached;
+            continue; // rescan will find its free slots
+        }
+
+        // Otherwise adopt an abandoned segment, else map a new one. Both link the
+        // segment into `heap.segments[kind]`; loop back to claim a slot (a
+        // reclaimed segment can be full, in which case we try again).
+        let seg = unsafe { reclaim_segment(h, kind) };
+        if seg.is_null() {
+            let seg = unsafe { new_segment(h, kind) };
+            if seg.is_null() {
+                return ptr::null_mut();
+            }
+        }
+    }
+}
+
+/// Initialize page slot `i` of `seg` for `class` and push it to the head of the
+/// owning heap's class list.
+#[inline]
+unsafe fn init_page(
+    seg: *mut Segment,
+    i: usize,
+    kind: Kind,
+    class: usize,
+    bsize: u32,
+    h: *mut Heap,
+) -> *mut Page {
+    let s = unsafe { &mut *seg };
+    let (data_addr, blocks) = page_layout(seg, i, kind, bsize as usize);
+    let pg = &mut s.pages[i] as *mut Page;
+    let page = unsafe { &mut *pg };
+    page.free = ptr::null_mut();
+    page.thread_free = AtomicPtr::new(ptr::null_mut());
+    page.bump = ptr::with_exposed_provenance_mut(data_addr);
+    page.bump_end = ptr::with_exposed_provenance_mut(data_addr + blocks * bsize as usize);
+    page.used = 0;
+    page.block_size = bsize;
+    page.class = class as u16;
+    s.used_pages += 1;
+
+    // Push to the head of the class list.
+    let heap = unsafe { &mut *h };
+    page.prev = ptr::null_mut();
+    page.next = heap.active[class];
+    if !page.next.is_null() {
+        unsafe { (*page.next).prev = pg };
+    }
+    heap.active[class] = pg;
+    pg
+}
+
+/// Map and register a new `kind` segment owned by `h`.
+#[cold]
+unsafe fn new_segment(h: *mut Heap, kind: Kind) -> *mut Segment {
+    let base = os_alloc_segment();
+    if base.is_null() {
+        return ptr::null_mut();
+    }
+    // Fresh mapping is zero: all Page fields, used_pages, links start cleared.
+    let seg = base as *mut Segment;
+    let s = unsafe { &mut *seg };
+    s.owner = AtomicPtr::new(h);
+    s.kind = kind as u8;
+    s.used_pages = 0;
+    s.abandoned_next = ptr::null_mut();
+    // Link into the heap's per-kind segment list.
+    let heap = unsafe { &mut *h };
+    let ki = kind.idx();
+    s.prev = ptr::null_mut();
+    s.next = heap.segments[ki];
+    if !s.next.is_null() {
+        unsafe { (*s.next).prev = seg };
+    }
+    heap.segments[ki] = seg;
+    seg
+}
+
+/// Try to take an abandoned `kind` segment off the global stack and adopt it
+/// into `h`: re-own it, re-queue its live pages, and fold in cross-thread frees.
+#[cold]
+unsafe fn reclaim_segment(h: *mut Heap, kind: Kind) -> *mut Segment {
+    let ki = kind.idx();
+    lock_abandon();
+    let seg = ABANDONED[ki].load(Ordering::Acquire);
+    if seg.is_null() {
+        unlock_abandon();
+        return ptr::null_mut();
+    }
+    let s = unsafe { &mut *seg };
+    ABANDONED[ki].store(s.abandoned_next, Ordering::Release);
+    unlock_abandon();
+
+    s.abandoned_next = ptr::null_mut();
+    s.owner.store(h, Ordering::Release);
+
+    // Re-queue every live page into this heap's class lists and recount.
+    let heap = unsafe { &mut *h };
+    s.used_pages = 0;
+    let first = kind.first_page();
+    let per = kind.pages();
+    let mut i = first;
+    while i < per {
+        let pg = &mut s.pages[i] as *mut Page;
+        let page = unsafe { &mut *pg };
+        if page.block_size != 0 {
+            // Fold cross-thread frees collected while abandoned.
+            let tf = page.thread_free.swap(ptr::null_mut(), Ordering::Acquire);
+            if !tf.is_null() {
+                let mut n: u32 = 0;
+                let mut node = tf;
+                let mut last = tf;
+                while !node.is_null() {
+                    n += 1;
+                    last = node;
+                    node = unsafe { (*node).next };
+                }
+                page.used -= n;
+                unsafe { (*last).next = page.free };
+                page.free = tf;
+            }
+            if page.used == 0 {
+                // Became fully free while abandoned: reset to an empty slot.
+                page.block_size = 0;
+                page.free = ptr::null_mut();
+            } else {
+                s.used_pages += 1;
+                let class = page.class as usize;
+                page.prev = ptr::null_mut();
+                page.next = heap.active[class];
+                if !page.next.is_null() {
+                    unsafe { (*page.next).prev = pg };
+                }
+                heap.active[class] = pg;
+            }
+        }
+        i += 1;
+    }
+
+    // Link the segment into the heap.
+    s.prev = ptr::null_mut();
+    s.next = heap.segments[ki];
+    if !s.next.is_null() {
+        unsafe { (*s.next).prev = seg };
+    }
+    heap.segments[ki] = seg;
+    seg
+}
+
+/// Walk the abandoned stack for `kind`, folding each segment's pending
+/// cross-thread frees, and `munmap` any segment that has become fully empty
+/// (splicing it out of the stack). Called at thread exit so that segments
+/// abandoned by earlier-exited threads, whose blocks have since been freed
+/// cross-thread, are returned to the OS instead of waiting for a future
+/// same-kind allocation to reclaim them.
+///
+/// # Safety
+/// All mutation of abandoned segments happens under `ABANDON_LOCK`, serialized
+/// with `reclaim_segment`. A segment is only unmapped once its recomputed
+/// `used_pages` is 0 — which, by the `used` accounting, means every outstanding
+/// block has been folded, so no concurrent cross-thread freer is still touching
+/// it (an in-flight free keeps its page's `used > 0` until its block is folded).
+#[cold]
+unsafe fn scavenge_abandoned(kind: Kind) {
+    let ki = kind.idx();
+    let first = kind.first_page();
+    let per = kind.pages();
+    lock_abandon();
+    let mut prev: *mut Segment = ptr::null_mut();
+    let mut cur = ABANDONED[ki].load(Ordering::Acquire);
+    while !cur.is_null() {
+        let s = unsafe { &mut *cur };
+        let next = s.abandoned_next;
+
+        // Fold every live page's cross-thread frees and recount.
+        let mut live = 0u32;
+        let mut i = first;
+        while i < per {
+            let pg = &mut s.pages[i];
+            if pg.block_size != 0 {
+                let tf = pg.thread_free.swap(ptr::null_mut(), Ordering::Acquire);
+                if !tf.is_null() {
+                    let mut n: u32 = 0;
+                    let mut node = tf;
+                    let mut last = tf;
+                    while !node.is_null() {
+                        n += 1;
+                        last = node;
+                        node = unsafe { (*node).next };
+                    }
+                    pg.used -= n;
+                    unsafe { (*last).next = pg.free };
+                    pg.free = tf;
+                }
+                if pg.used == 0 {
+                    pg.block_size = 0;
+                } else {
+                    live += 1;
+                }
+            }
+            i += 1;
+        }
+        s.used_pages = live;
+
+        if live == 0 {
+            // Splice out of the abandoned stack and return to the OS.
+            if prev.is_null() {
+                ABANDONED[ki].store(next, Ordering::Release);
+            } else {
+                unsafe { (*prev).abandoned_next = next };
+            }
+            unsafe { os_munmap((cur as *mut u8).addr(), SEGMENT_SIZE) };
+        } else {
+            prev = cur;
+        }
+        cur = next;
+    }
+    unlock_abandon();
+}
+
+/// Paged allocation for `kind`/`class`.
+#[inline]
+unsafe fn alloc_paged(kind: Kind, class: usize) -> *mut u8 {
+    let h = heap();
+    if h.is_null() {
+        return ptr::null_mut();
+    }
+    let heap = unsafe { &mut *h };
+
+    // Try the active page for this class.
+    let head = heap.active[class];
+    if !head.is_null() {
+        let b = unsafe { page_alloc(head) };
+        if !b.is_null() {
+            return b;
+        }
+        // Active page full: scan the class list for one with space (folding in
+        // cross-thread frees), and promote it to the head.
+        let mut p = unsafe { (*head).next };
+        while !p.is_null() {
+            let b = unsafe { page_alloc(p) };
+            if !b.is_null() {
+                unsafe { promote(heap, class, p) };
+                return b;
+            }
+            p = unsafe { (*p).next };
+        }
+    }
+
+    // No page with space: get a fresh one.
+    let pg = unsafe { heap_alloc_page(h, kind, class) };
+    if pg.is_null() {
+        return ptr::null_mut();
+    }
+    unsafe { page_alloc(pg) }
+}
+
+/// Move page `p` to the head of its class list.
+#[inline]
+unsafe fn promote(heap: &mut Heap, class: usize, p: *mut Page) {
+    if heap.active[class] == p {
+        return;
+    }
+    let page = unsafe { &mut *p };
+    if !page.prev.is_null() {
+        unsafe { (*page.prev).next = page.next };
+    }
+    if !page.next.is_null() {
+        unsafe { (*page.next).prev = page.prev };
+    }
+    page.prev = ptr::null_mut();
+    page.next = heap.active[class];
+    if !page.next.is_null() {
+        unsafe { (*page.next).prev = p };
+    }
+    heap.active[class] = p;
+}
+
+/// Free a paged block back to its page. The block's segment (and thus its kind
+/// and page geometry) is recovered by masking — no `Layout` needed here.
+#[inline]
+unsafe fn free_paged(block: *mut u8) {
+    let seg = segment_of(block);
+    let s = unsafe { &mut *seg };
+    let kind = Kind::from_u8(s.kind);
+    let shift = kind.shift();
+    let i = (block.addr() - (seg as *mut u8).addr()) >> shift;
+    let pg = &mut s.pages[i] as *mut Page;
+
+    // Integrity check (debug only, zero release cost): the freed pointer must
+    // land on its page's current size-class grid. A miss means a double free, a
+    // free of a foreign/stale pointer, or a use-after-free — fail loudly here
+    // rather than corrupt the heap.
+    #[cfg(debug_assertions)]
+    {
+        let page = unsafe { &*pg };
+        let page_base = (seg as *mut u8).addr() + i * (1usize << shift);
+        let off = block.addr().wrapping_sub(page_base);
+        debug_assert!(
+            page.block_size != 0
+                && off < (1usize << shift)
+                && off % page.block_size as usize == 0,
+            "invalid free: pointer not on its page's size-class grid",
+        );
+    }
+
+    let owner = s.owner.load(Ordering::Relaxed);
+    let me = tls::heap() as *mut Heap;
+    if owner == me && !owner.is_null() {
+        // Owner-thread free: push to the local free list, no atomics.
+        let page = unsafe { &mut *pg };
+        let b = block as *mut Block;
+        unsafe { (*b).next = page.free };
+        page.free = b;
+        page.used -= 1;
+        if page.used == 0 {
+            unsafe { retire_page(seg, i) };
+        }
+    } else {
+        // Cross-thread (or abandoned-segment) free: push atomically.
+        let page = unsafe { &*pg };
+        let b = block as *mut Block;
+        let mut head = page.thread_free.load(Ordering::Relaxed);
+        loop {
+            unsafe { (*b).next = head };
+            match page.thread_free.compare_exchange_weak(
+                head,
+                b,
+                Ordering::Release,
+                Ordering::Relaxed,
+            ) {
+                Ok(_) => break,
+                Err(h) => head = h,
+            }
+        }
+    }
+}
+
+/// A page just emptied (owner thread): drop its physical pages and mark the slot
+/// reusable; if its segment is now fully empty, return the whole segment.
+#[cold]
+unsafe fn retire_page(seg: *mut Segment, i: usize) {
+    let s = unsafe { &mut *seg };
+    let kind = Kind::from_u8(s.kind);
+    let pg = &mut s.pages[i];
+    let class = pg.class as usize;
+
+    // Unlink from the class list.
+    let me = s.owner.load(Ordering::Relaxed);
+    if !me.is_null() {
+        let heap = unsafe { &mut *me };
+        if heap.active[class] == (pg as *mut Page) {
+            heap.active[class] = pg.next;
+        }
+        if !pg.prev.is_null() {
+            unsafe { (*pg.prev).next = pg.next };
+        }
+        if !pg.next.is_null() {
+            unsafe { (*pg.next).prev = pg.prev };
+        }
+    }
+    pg.next = ptr::null_mut();
+    pg.prev = ptr::null_mut();
+    pg.free = ptr::null_mut();
+    pg.block_size = 0;
+
+    s.used_pages -= 1;
+    if s.used_pages > 0 {
+        // Segment still alive: drop just this page's physical memory; the virtual
+        // range stays mapped for reuse. For the header-bearing page (0) start
+        // past the header, never advising it.
+        let seg_addr = (seg as *mut u8).addr();
+        let page_size = 1usize << kind.shift();
+        let (madv_addr, madv_len) = if i == 0 {
+            let start = round_up(seg_addr + HEADER_SIZE, OS_PAGE);
+            (start, (seg_addr + page_size) - start)
+        } else {
+            (seg_addr + i * page_size, page_size)
+        };
+        unsafe { os_madvise(madv_addr, madv_len, sysc::MADV_FREE) };
+    } else {
+        // Whole segment empty: cache it (kept committed for fast reuse) or, past
+        // the cache cap, return it to the OS.
+        unsafe { release_segment(seg) };
+    }
+}
+
+/// Unlink a fully-empty segment from its heap; keep it in the per-kind empty
+/// cache (committed, for immediate reuse) up to the cap, else `munmap` it.
+#[cold]
+unsafe fn release_segment(seg: *mut Segment) {
+    let s = unsafe { &mut *seg };
+    let owner = s.owner.load(Ordering::Relaxed);
+    if !owner.is_null() {
+        let heap = unsafe { &mut *owner };
+        let ki = Kind::from_u8(s.kind).idx();
+        if heap.segments[ki] == seg {
+            heap.segments[ki] = s.next;
+        }
+        if !s.prev.is_null() {
+            unsafe { (*s.prev).next = s.next };
+        }
+        if !s.next.is_null() {
+            unsafe { (*s.next).prev = s.prev };
+        }
+        if heap.free_count[ki] < FREE_SEG_CAP[ki] {
+            // Cache for reuse. Owner stays set; no other thread can reference a
+            // fully-empty segment, so this is safe until thread exit / reuse.
+            s.prev = ptr::null_mut();
+            s.next = heap.free_segs[ki];
+            heap.free_segs[ki] = seg;
+            heap.free_count[ki] += 1;
+            return;
+        }
+    }
+    unsafe { os_munmap((seg as *mut u8).addr(), SEGMENT_SIZE) };
+}
+
+// --- huge (dedicated mmap, with a per-thread reuse cache) -----------------
+
+/// Length of the dedicated mapping backing a huge/over-aligned allocation of
+/// `size`. Recomputable from the `Layout` alone, so free needs no header.
+#[inline]
+fn huge_len(size: usize) -> usize {
+    round_up(size.max(1), OS_PAGE)
+}
+
+/// Take a cached huge mapping of exactly `len` bytes, or null. Cached mappings
+/// are page-aligned (from `mmap`) and `MADV_DONTNEED`'d, so they satisfy any
+/// `align <= OS_PAGE` and re-fault as zero.
+#[inline]
+unsafe fn huge_cache_pop(h: *mut Heap, len: usize) -> *mut u8 {
+    let heap = unsafe { &mut *h };
+    let mut i = 0;
+    while i < HUGE_CACHE_N {
+        if heap.huge_cache[i].1 == len {
+            let addr = heap.huge_cache[i].0;
+            heap.huge_cache[i] = (0, 0);
+            heap.huge_bytes -= len;
+            return ptr::with_exposed_provenance_mut(addr);
+        }
+        i += 1;
+    }
+    ptr::null_mut()
+}
+
+/// Park a page-aligned huge mapping for reuse. Returns `true` if cached (the
+/// caller must not `munmap` it); `false` if the cache is full or over budget.
+#[inline]
+unsafe fn huge_cache_push(h: *mut Heap, ptr: *mut u8, len: usize) -> bool {
+    let heap = unsafe { &mut *h };
+    if heap.huge_bytes + len > HUGE_VA_MAX {
+        return false;
+    }
+    let mut i = 0;
+    while i < HUGE_CACHE_N {
+        if heap.huge_cache[i].1 == 0 {
+            // Drop the physical pages (RSS) but keep the VA; the mapping will
+            // re-fault as zero on reuse. If the advice fails, don't cache.
+            if sysc::ret(unsafe { sysc::syscall3(sysc::MADVISE, ptr.addr(), len, sysc::MADV_DONTNEED) })
+                .is_err()
+            {
+                return false;
+            }
+            heap.huge_cache[i] = (ptr.addr(), len);
+            heap.huge_bytes += len;
+            return true;
+        }
+        i += 1;
+    }
+    false
+}
+
+#[inline]
+unsafe fn alloc_huge(size: usize, align: usize) -> *mut u8 {
+    let len = huge_len(size);
+    if align <= OS_PAGE {
+        // Reuse a cached mapping of this exact length before touching the OS.
+        let h = heap();
+        if !h.is_null() {
+            let p = unsafe { huge_cache_pop(h, len) };
+            if !p.is_null() {
+                return p;
+            }
+        }
+        os_mmap(len)
+    } else {
+        // Over-map and trim to an `align`-aligned region of exactly `len`.
+        let over = len + align;
+        let raw = os_mmap(over);
+        if raw.is_null() {
+            return ptr::null_mut();
+        }
+        let raw_addr = raw.addr();
+        let base = round_up(raw_addr, align);
+        if base > raw_addr {
+            unsafe { os_munmap(raw_addr, base - raw_addr) };
+        }
+        let end = raw_addr + over;
+        let tail = base + len;
+        if end > tail {
+            unsafe { os_munmap(tail, end - tail) };
+        }
+        ptr::with_exposed_provenance_mut(base)
+    }
+}
+
+#[inline]
+unsafe fn free_huge(ptr: *mut u8, size: usize, align: usize) {
+    let len = huge_len(size);
+    // Only page-aligned mappings are fungible enough to cache; over-aligned ones
+    // (trimmed to a specific base) go straight back to the OS.
+    if align <= OS_PAGE {
+        let h = heap();
+        if !h.is_null() && unsafe { huge_cache_push(h, ptr, len) } {
+            return;
+        }
+    }
+    unsafe { os_munmap(ptr.addr(), len) };
+}
+
+// --- public entry points (called by the GlobalAlloc impl) -----------------
+
+#[inline]
+pub unsafe fn alloc(size: usize, align: usize) -> *mut u8 {
+    match route(size, align) {
+        Route::Paged(kind, class) => unsafe { alloc_paged(kind, class) },
+        Route::Huge => unsafe { alloc_huge(size, align) },
+    }
+}
+
+#[inline]
+pub unsafe fn alloc_zeroed(size: usize, align: usize) -> *mut u8 {
+    match route(size, align) {
+        Route::Paged(kind, class) => {
+            // Paged memory may be reused/`MADV_FREE`d and is not guaranteed zero.
+            let p = unsafe { alloc_paged(kind, class) };
+            if !p.is_null() {
+                unsafe { ptr::write_bytes(p, 0, size) };
+            }
+            p
+        }
+        // The huge path is a fresh mmap, already zero.
+        Route::Huge => unsafe { alloc_huge(size, align) },
+    }
+}
+
+#[inline]
+pub unsafe fn dealloc(ptr: *mut u8, size: usize, align: usize) {
+    if ptr.is_null() {
+        return;
+    }
+    match route(size, align) {
+        Route::Paged(..) => unsafe { free_paged(ptr) },
+        Route::Huge => unsafe { free_huge(ptr, size, align) },
+    }
+}
+
+#[inline]
+pub unsafe fn realloc(ptr: *mut u8, old_size: usize, align: usize, new_size: usize) -> *mut u8 {
+    // In-place when old and new map to the same paged class, or to a huge
+    // mapping of the same page-rounded length.
+    match (route(old_size, align), route(new_size, align)) {
+        (Route::Paged(_, co), Route::Paged(_, cn)) if co == cn => return ptr,
+        (Route::Huge, Route::Huge) if huge_len(old_size) == huge_len(new_size) => return ptr,
+        _ => {}
+    }
+    let new = unsafe { alloc(new_size, align) };
+    if new.is_null() {
+        return ptr::null_mut();
+    }
+    let n = if old_size < new_size { old_size } else { new_size };
+    unsafe { ptr::copy_nonoverlapping(ptr, new, n) };
+    unsafe { dealloc(ptr, old_size, align) };
+    new
+}
+
+/// Tear down the calling thread's heap at thread exit: fold pending cross-thread
+/// frees, return fully-empty segments to the OS, and abandon the rest for other
+/// threads to reclaim. The `Heap` struct itself is then unmapped.
+pub unsafe fn thread_exit() {
+    // Reclaim segments abandoned by earlier-exited threads that have since been
+    // emptied by cross-thread frees. Done unconditionally (even for a thread that
+    // never allocated but freed others' blocks) so abandoned retention is bounded
+    // by any thread exit, not only exits of threads that allocated.
+    for ki in 0..NUM_KINDS {
+        unsafe { scavenge_abandoned(Kind::from_u8(ki as u8)) };
+    }
+
+    let h = tls::heap() as *mut Heap;
+    if h.is_null() {
+        return;
+    }
+    let heap = unsafe { &mut *h };
+
+    for ki in 0..NUM_KINDS {
+        let kind = Kind::from_u8(ki as u8);
+        let first = kind.first_page();
+        let per = kind.pages();
+        let mut seg = heap.segments[ki];
+        while !seg.is_null() {
+            let s = unsafe { &mut *seg };
+            let next = s.next;
+
+            // Recount live pages after folding in cross-thread frees.
+            let mut live = 0u32;
+            let mut i = first;
+            while i < per {
+                let pg = &mut s.pages[i];
+                if pg.block_size != 0 {
+                    let tf = pg.thread_free.swap(ptr::null_mut(), Ordering::Acquire);
+                    if !tf.is_null() {
+                        let mut n: u32 = 0;
+                        let mut node = tf;
+                        let mut last = tf;
+                        while !node.is_null() {
+                            n += 1;
+                            last = node;
+                            node = unsafe { (*node).next };
+                        }
+                        pg.used -= n;
+                        unsafe { (*last).next = pg.free };
+                        pg.free = tf;
+                    }
+                    if pg.used == 0 {
+                        pg.block_size = 0;
+                    } else {
+                        live += 1;
+                    }
+                }
+                i += 1;
+            }
+            s.used_pages = live;
+
+            if live == 0 {
+                unsafe { os_munmap((seg as *mut u8).addr(), SEGMENT_SIZE) };
+            } else {
+                // Abandon: clear owner, push onto the global per-kind stack.
+                s.owner.store(ptr::null_mut(), Ordering::Release);
+                s.next = ptr::null_mut();
+                s.prev = ptr::null_mut();
+                lock_abandon();
+                s.abandoned_next = ABANDONED[ki].load(Ordering::Acquire);
+                ABANDONED[ki].store(seg, Ordering::Release);
+                unlock_abandon();
+            }
+            seg = next;
+        }
+        heap.segments[ki] = ptr::null_mut();
+
+        // Return the empty-segment cache to the OS (thread-private, so no other
+        // thread can hold a pointer into these).
+        let mut c = heap.free_segs[ki];
+        while !c.is_null() {
+            let next = unsafe { (*c).next };
+            unsafe { os_munmap((c as *mut u8).addr(), SEGMENT_SIZE) };
+            c = next;
+        }
+        heap.free_segs[ki] = ptr::null_mut();
+        heap.free_count[ki] = 0;
+    }
+
+    // Return the cached huge mappings to the OS (thread-private).
+    for i in 0..HUGE_CACHE_N {
+        let (addr, len) = heap.huge_cache[i];
+        if len != 0 {
+            unsafe { os_munmap(addr, len) };
+            heap.huge_cache[i] = (0, 0);
+        }
+    }
+    heap.huge_bytes = 0;
+
+    // Free the Heap struct and clear the TLS slot.
+    unsafe { os_munmap(h.addr(), round_up(core::mem::size_of::<Heap>(), OS_PAGE)) };
+    tls::set_heap(ptr::null_mut());
+}
