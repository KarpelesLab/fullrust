diff --git a/library/std/src/sys/pal/fullrust/common.rs b/library/std/src/sys/pal/fullrust/common.rs
new file mode 100644
index 00000000..b3c920de
--- /dev/null
+++ b/library/std/src/sys/pal/fullrust/common.rs
@@ -0,0 +1,124 @@
+use crate::io as std_io;
+use crate::sync::atomic::{AtomicBool, Ordering};
+
+// Called once by `rt::init` via `sys::init`, with the real argc/argv that the
+// compiler-emitted `main` passed to `lang_start`. We hand them to the args
+// machinery so `std::env::args()` works, and derive `envp` (which follows the
+// NULL-terminated `argv` on the stack) for `std::env::var()`.
+//
+// SAFETY: must be called only once during runtime initialization.
+pub unsafe fn init(argc: isize, argv: *const *const u8, sigpipe: u8) {
+    unsafe { crate::sys::args::init(argc, argv) };
+    // Stack layout: [argv0..argv(argc-1)][NULL][envp0..][NULL]. So `envp` begins
+    // one past the argv NULL terminator, i.e. at `argv[argc + 1]`.
+    if !argv.is_null() && argc >= 0 {
+        let envp = unsafe { argv.add(argc as usize + 1) } as *const *const core::ffi::c_char;
+        unsafe { crate::sys::env::init(envp) };
+    }
+    unsafe { reset_sigpipe(sigpipe) };
+    // Install the stack-overflow guard/handler for the main thread (prints a
+    // clear message instead of a bare SIGSEGV on overflow). Spawned threads set
+    // up their own guard + alt-stack in `thread.rs`.
+    unsafe { super::stack_overflow::init() };
+}
+
+// SIGPIPE handling. The `sigpipe` byte is the disposition the compiler derived
+// from `-Zon-broken-pipe` / `#[unix_sigpipe = "…"]`; these constants mirror
+// `compiler/rustc_session/src/config/sigpipe.rs` (keep them in sync).
+mod sigpipe {
+    pub const DEFAULT: u8 = 0;
+    pub const INHERIT: u8 = 1;
+    pub const SIG_IGN: u8 = 2;
+    pub const SIG_DFL: u8 = 3;
+}
+
+const SIGPIPE: usize = 13;
+const SIG_DFL: usize = 0;
+const SIG_IGN: usize = 1;
+
+/// Set true when the program explicitly chose a SIGPIPE disposition via the
+/// `-Zon-broken-pipe` flag / attribute. The process spawner reads this to decide
+/// whether to restore `SIG_DFL` in children (see [`on_broken_pipe_flag_used`]).
+static ON_BROKEN_PIPE_FLAG_USED: AtomicBool = AtomicBool::new(false);
+
+pub(crate) fn on_broken_pipe_flag_used() -> bool {
+    ON_BROKEN_PIPE_FLAG_USED.load(Ordering::Relaxed)
+}
+
+/// Honor the compiler's SIGPIPE directive, exactly as the unix pal does. The
+/// Rust default (`DEFAULT`) is `SIG_IGN` so a write to a closed peer yields
+/// `EPIPE` rather than killing us; an explicit `sig_dfl`/`inherit`/`sig_ign`
+/// overrides that and marks the "flag used" state.
+unsafe fn reset_sigpipe(sigpipe: u8) {
+    let (attr_specified, disposition) = match sigpipe {
+        sigpipe::DEFAULT => (false, Some(SIG_IGN)),
+        sigpipe::INHERIT => (true, None),
+        sigpipe::SIG_IGN => (true, Some(SIG_IGN)),
+        sigpipe::SIG_DFL => (true, Some(SIG_DFL)),
+        // Be lenient about unknown encodings: keep the safe default.
+        _ => (false, Some(SIG_IGN)),
+    };
+    if attr_specified {
+        ON_BROKEN_PIPE_FLAG_USED.store(true, Ordering::Relaxed);
+    }
+    if let Some(disposition) = disposition {
+        unsafe { set_sigpipe(disposition) };
+    }
+}
+
+/// `rt_sigaction(SIGPIPE, disposition)` via the raw kernel ABI, where
+/// `disposition` is `SIG_DFL` or `SIG_IGN` (never a real handler, so no
+/// `sa_restorer` is required).
+unsafe fn set_sigpipe(disposition: usize) {
+    use super::sysc;
+    // struct kernel_sigaction { sa_handler; sa_flags; sa_restorer; sa_mask[1]; }
+    let act: [usize; 4] = [disposition, 0, 0, 0];
+    unsafe {
+        // Final arg is the sigset size in bytes (8 for the 64-bit kernel mask).
+        sysc::syscall4(sysc::RT_SIGACTION, SIGPIPE, act.as_ptr() as usize, 0, 8);
+    }
+}
+
+// SAFETY: must be called only once during runtime cleanup.
+pub unsafe fn cleanup() {}
+
+// Retained for parity with other pals and any subsystem not yet ported to raw
+// syscalls; the ported fs/process/net paths no longer reach for it.
+#[allow(dead_code)]
+pub fn unsupported<T>() -> std_io::Result<T> {
+    Err(unsupported_err())
+}
+
+#[allow(dead_code)]
+pub fn unsupported_err() -> std_io::Error {
+    std_io::Error::UNSUPPORTED_PLATFORM
+}
+
+pub fn is_interrupted(code: i32) -> bool {
+    code == 4 // EINTR
+}
+
+pub fn decode_error_kind(code: i32) -> crate::io::ErrorKind {
+    use crate::io::ErrorKind::*;
+    match code {
+        1 | 13 => PermissionDenied,  // EPERM / EACCES
+        2 => NotFound,               // ENOENT
+        4 => Interrupted,            // EINTR
+        11 => WouldBlock,            // EAGAIN
+        17 => AlreadyExists,         // EEXIST
+        21 => IsADirectory,          // EISDIR
+        22 => InvalidInput,          // EINVAL
+        28 => StorageFull,           // ENOSPC
+        32 => BrokenPipe,            // EPIPE
+        110 => TimedOut,             // ETIMEDOUT
+        111 => ConnectionRefused,    // ECONNREFUSED
+        _ => Uncategorized,
+    }
+}
+
+pub fn abort_internal() -> ! {
+    unsafe {
+        super::sysc::syscall1(super::sysc::EXIT_GROUP, 134);
+    }
+    core::intrinsics::abort()
+}
