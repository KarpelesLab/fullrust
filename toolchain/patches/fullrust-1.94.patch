diff --git a/library/std/src/sys/fs/fullrust.rs b/library/std/src/sys/fs/fullrust.rs
new file mode 100644
index 00000000..b3657a3d
--- /dev/null
+++ b/library/std/src/sys/fs/fullrust.rs
@@ -0,0 +1,830 @@
+//! Filesystem for the fullrust target, on raw Linux syscalls (no libc).
+//!
+//! `File` is a thin owner of a raw kernel fd. Metadata comes from `statx(2)`
+//! (which uniquely also yields btime/creation time); directory iteration from
+//! `getdents64(2)`; everything else from the `*at` family rooted at `AT_FDCWD`.
+//! Paths are byte-exact: the `fullrust` `OsStr` encoding *is* the raw path bytes,
+//! so we round-trip through `CString` with no lossy decode (see `os::cstr`).
+
+#![allow(dead_code)]
+
+pub use super::common::{Dir, copy, exists, remove_dir_all};
+use crate::ffi::{CStr, OsString};
+use crate::fmt;
+use crate::fs::TryLockError;
+use crate::io::{self, BorrowedCursor, IoSlice, IoSliceMut, SeekFrom};
+use crate::os::fullrust::io::{AsFd, AsRawFd, BorrowedFd, FromRawFd, IntoRawFd, RawFd};
+use crate::path::{Path, PathBuf};
+use crate::sync::Arc;
+use crate::sys::pal::fd::{cvt, FileDesc};
+use crate::sys::pal::os;
+use crate::sys::pal::sysc;
+use crate::sys::time::SystemTime;
+use crate::sys::{AsInner, FromInner, IntoInner};
+
+// `AT_FDCWD` as the raw kernel value (-100), passed in a register as `usize`.
+const AT_FDCWD: usize = (-100isize) as usize;
+const AT_SYMLINK_NOFOLLOW: usize = 0x100;
+const AT_EMPTY_PATH: usize = 0x1000;
+const AT_REMOVEDIR: usize = 0x200;
+
+// open(2) flags.
+const O_RDONLY: i32 = 0;
+const O_WRONLY: i32 = 1;
+const O_RDWR: i32 = 2;
+const O_CREAT: i32 = 0o100;
+const O_EXCL: i32 = 0o200;
+const O_TRUNC: i32 = 0o1000;
+const O_APPEND: i32 = 0o2000;
+const O_DIRECTORY: i32 = 0o200000;
+const O_CLOEXEC: i32 = 0o2000000;
+const O_PATH: i32 = 0o10000000;
+
+// lseek(2) whence.
+const SEEK_SET: usize = 0;
+const SEEK_CUR: usize = 1;
+const SEEK_END: usize = 2;
+
+// flock(2) operations.
+const LOCK_SH: usize = 1;
+const LOCK_EX: usize = 2;
+const LOCK_NB: usize = 4;
+const LOCK_UN: usize = 8;
+
+// fcntl(2) command.
+
+// st_mode type bits.
+const S_IFMT: u16 = 0o170000;
+const S_IFDIR: u16 = 0o040000;
+const S_IFREG: u16 = 0o100000;
+const S_IFLNK: u16 = 0o120000;
+
+// statx(2) request mask and the btime-present bit.
+const STATX_BASIC_STATS: usize = 0x7ff;
+const STATX_BTIME: u32 = 0x800;
+const STATX_MASK: usize = STATX_BASIC_STATS | (STATX_BTIME as usize);
+const STATX_SIZE: usize = 256;
+
+// getdents64 d_type values.
+const DT_UNKNOWN: u8 = 0;
+const DT_DIR: u8 = 4;
+const DT_REG: u8 = 8;
+const DT_LNK: u8 = 10;
+
+// utimensat(2) sentinel nanoseconds.
+const UTIME_OMIT: i64 = (1 << 30) - 2;
+
+
+// ---------------------------------------------------------------------------
+// File
+// ---------------------------------------------------------------------------
+
+/// An open file. Read/write/vectored I/O, `dup`, and close come from the shared
+/// [`FileDesc`]; the methods here are the file-specific syscalls (`statx`,
+/// `fsync`, `flock`, `lseek`, `ftruncate`, `fchmod`, `utimensat`).
+pub struct File(FileDesc);
+
+impl File {
+    #[inline]
+    fn raw(&self) -> usize {
+        self.0.raw() as usize
+    }
+
+    pub fn open(path: &Path, opts: &OpenOptions) -> io::Result<File> {
+        let c = os::cstr(path)?;
+        let mut flags = opts.get_access_mode()?;
+        flags |= opts.get_creation_mode()?;
+        flags |= O_CLOEXEC;
+        let mode = if flags & O_CREAT != 0 { opts.mode } else { 0 };
+        let fd = cvt(unsafe {
+            sysc::syscall4(
+                sysc::OPENAT,
+                AT_FDCWD,
+                c.as_ptr() as usize,
+                flags as usize,
+                mode as usize,
+            )
+        })?;
+        Ok(File(FileDesc::from_raw(fd as i32)))
+    }
+
+    pub fn file_attr(&self) -> io::Result<FileAttr> {
+        do_statx(self.raw(), c"", AT_EMPTY_PATH)
+    }
+
+    /// A size hint for `read_to_end` pre-allocation. `0` (e.g. a `/proc` file)
+    /// falls back to the generic path. (1.89+ sys::fs::File interface.)
+    pub fn size(&self) -> Option<io::Result<u64>> {
+        match self.file_attr().map(|attr| attr.size()) {
+            Ok(0) => None,
+            result => Some(result),
+        }
+    }
+
+    pub fn fsync(&self) -> io::Result<()> {
+        cvt(unsafe { sysc::syscall1(sysc::FSYNC, self.raw()) }).map(drop)
+    }
+
+    pub fn datasync(&self) -> io::Result<()> {
+        cvt(unsafe { sysc::syscall1(sysc::FDATASYNC, self.raw()) }).map(drop)
+    }
+
+    fn flock(&self, op: usize) -> io::Result<()> {
+        cvt(unsafe { sysc::syscall2(sysc::FLOCK, self.raw(), op) }).map(drop)
+    }
+
+    pub fn lock(&self) -> io::Result<()> {
+        self.flock(LOCK_EX)
+    }
+
+    pub fn lock_shared(&self) -> io::Result<()> {
+        self.flock(LOCK_SH)
+    }
+
+    fn try_flock(&self, op: usize) -> Result<(), TryLockError> {
+        match sysc::ret(unsafe { sysc::syscall2(sysc::FLOCK, self.raw(), op | LOCK_NB) }) {
+            Ok(_) => Ok(()),
+            // flock(LOCK_NB) reports contention as EWOULDBLOCK (== EAGAIN, 11).
+            Err(11) => Err(TryLockError::WouldBlock),
+            Err(e) => Err(TryLockError::Error(io::Error::from_raw_os_error(e))),
+        }
+    }
+
+    pub fn try_lock(&self) -> Result<(), TryLockError> {
+        self.try_flock(LOCK_EX)
+    }
+
+    pub fn try_lock_shared(&self) -> Result<(), TryLockError> {
+        self.try_flock(LOCK_SH)
+    }
+
+    pub fn unlock(&self) -> io::Result<()> {
+        self.flock(LOCK_UN)
+    }
+
+    pub fn truncate(&self, size: u64) -> io::Result<()> {
+        cvt(unsafe { sysc::syscall2(sysc::FTRUNCATE, self.raw(), size as usize) }).map(drop)
+    }
+
+    pub fn read(&self, buf: &mut [u8]) -> io::Result<usize> {
+        self.0.read(buf)
+    }
+
+    pub fn read_vectored(&self, bufs: &mut [IoSliceMut<'_>]) -> io::Result<usize> {
+        self.0.read_vectored(bufs)
+    }
+
+    #[inline]
+    pub fn is_read_vectored(&self) -> bool {
+        true
+    }
+
+    pub fn read_buf(&self, cursor: BorrowedCursor<'_>) -> io::Result<()> {
+        self.0.read_buf(cursor)
+    }
+
+    pub fn write(&self, buf: &[u8]) -> io::Result<usize> {
+        self.0.write(buf)
+    }
+
+    pub fn write_vectored(&self, bufs: &[IoSlice<'_>]) -> io::Result<usize> {
+        self.0.write_vectored(bufs)
+    }
+
+    #[inline]
+    pub fn is_write_vectored(&self) -> bool {
+        true
+    }
+
+    #[inline]
+    pub fn flush(&self) -> io::Result<()> {
+        Ok(())
+    }
+
+    pub fn seek(&self, pos: SeekFrom) -> io::Result<u64> {
+        let (whence, off) = match pos {
+            SeekFrom::Start(n) => (SEEK_SET, n as i64),
+            SeekFrom::End(n) => (SEEK_END, n),
+            SeekFrom::Current(n) => (SEEK_CUR, n),
+        };
+        cvt(unsafe { sysc::syscall3(sysc::LSEEK, self.raw(), off as usize, whence) })
+            .map(|n| n as u64)
+    }
+
+    pub fn tell(&self) -> io::Result<u64> {
+        self.seek(SeekFrom::Current(0))
+    }
+
+    pub fn duplicate(&self) -> io::Result<File> {
+        Ok(File(self.0.duplicate()?))
+    }
+
+    pub fn set_permissions(&self, perm: FilePermissions) -> io::Result<()> {
+        cvt(unsafe { sysc::syscall2(sysc::FCHMOD, self.raw(), perm.mode as usize) }).map(drop)
+    }
+
+    pub fn set_times(&self, times: FileTimes) -> io::Result<()> {
+        let ts = [to_timespec(times.accessed), to_timespec(times.modified)];
+        cvt(unsafe { sysc::syscall4(sysc::UTIMENSAT, self.raw(), 0, ts.as_ptr() as usize, 0) })
+            .map(drop)
+    }
+
+    pub(crate) fn as_raw_fd(&self) -> i32 {
+        self.0.raw()
+    }
+
+    pub(crate) fn into_raw_fd(self) -> i32 {
+        self.0.into_raw()
+    }
+
+    pub(crate) unsafe fn from_raw_fd(fd: i32) -> File {
+        File(FileDesc::from_raw(fd))
+    }
+}
+
+impl fmt::Debug for File {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        f.debug_struct("File").field("fd", &self.0.raw()).finish()
+    }
+}
+
+// `std::os::fd` interop: chain `File` → `FileDesc` → `OwnedFd` so `File`
+// exposes `as_fd()`/`as_raw_fd()` and round-trips through `OwnedFd`.
+impl AsInner<FileDesc> for File {
+    #[inline]
+    fn as_inner(&self) -> &FileDesc {
+        &self.0
+    }
+}
+
+impl IntoInner<FileDesc> for File {
+    #[inline]
+    fn into_inner(self) -> FileDesc {
+        self.0
+    }
+}
+
+impl FromInner<FileDesc> for File {
+    #[inline]
+    fn from_inner(file_desc: FileDesc) -> File {
+        File(file_desc)
+    }
+}
+
+impl AsFd for File {
+    #[inline]
+    fn as_fd(&self) -> BorrowedFd<'_> {
+        self.0.as_fd()
+    }
+}
+
+impl AsRawFd for File {
+    #[inline]
+    fn as_raw_fd(&self) -> RawFd {
+        self.0.as_raw_fd()
+    }
+}
+
+impl IntoRawFd for File {
+    #[inline]
+    fn into_raw_fd(self) -> RawFd {
+        self.0.into_raw_fd()
+    }
+}
+
+impl FromRawFd for File {
+    #[inline]
+    unsafe fn from_raw_fd(fd: RawFd) -> File {
+        // SAFETY: guaranteed by the caller of the (unsafe) `FromRawFd` trait.
+        File(unsafe { FromRawFd::from_raw_fd(fd) })
+    }
+}
+
+// ---------------------------------------------------------------------------
+// Metadata (statx)
+// ---------------------------------------------------------------------------
+
+#[derive(Clone)]
+pub struct FileAttr {
+    size: u64,
+    mode: u16,
+    mask: u32,
+    atime: (i64, u32),
+    mtime: (i64, u32),
+    ctime: (i64, u32),
+    btime: (i64, u32),
+}
+
+fn rd_u16(b: &[u8], off: usize) -> u16 {
+    u16::from_ne_bytes(b[off..off + 2].try_into().unwrap())
+}
+fn rd_u32(b: &[u8], off: usize) -> u32 {
+    u32::from_ne_bytes(b[off..off + 4].try_into().unwrap())
+}
+fn rd_u64(b: &[u8], off: usize) -> u64 {
+    u64::from_ne_bytes(b[off..off + 8].try_into().unwrap())
+}
+fn rd_i64(b: &[u8], off: usize) -> i64 {
+    i64::from_ne_bytes(b[off..off + 8].try_into().unwrap())
+}
+
+fn do_statx(dirfd: usize, path: &CStr, flags: usize) -> io::Result<FileAttr> {
+    let mut buf = [0u8; STATX_SIZE];
+    cvt(unsafe {
+        sysc::syscall5(
+            sysc::STATX,
+            dirfd,
+            path.as_ptr() as usize,
+            flags,
+            STATX_MASK,
+            buf.as_mut_ptr() as usize,
+        )
+    })?;
+    // statx struct field offsets (linux/stat.h); timestamps are
+    // { i64 tv_sec @+0; u32 tv_nsec @+8 }.
+    Ok(FileAttr {
+        mask: rd_u32(&buf, 0),
+        mode: rd_u16(&buf, 28),
+        size: rd_u64(&buf, 40),
+        atime: (rd_i64(&buf, 64), rd_u32(&buf, 72)),
+        btime: (rd_i64(&buf, 80), rd_u32(&buf, 88)),
+        ctime: (rd_i64(&buf, 96), rd_u32(&buf, 104)),
+        mtime: (rd_i64(&buf, 112), rd_u32(&buf, 120)),
+    })
+}
+
+impl FileAttr {
+    pub fn size(&self) -> u64 {
+        self.size
+    }
+
+    pub fn perm(&self) -> FilePermissions {
+        FilePermissions { mode: self.mode & 0o7777 }
+    }
+
+    pub fn file_type(&self) -> FileType {
+        FileType { mode: self.mode & S_IFMT }
+    }
+
+    pub fn modified(&self) -> io::Result<SystemTime> {
+        Ok(SystemTime::new(self.mtime.0, self.mtime.1))
+    }
+
+    pub fn accessed(&self) -> io::Result<SystemTime> {
+        Ok(SystemTime::new(self.atime.0, self.atime.1))
+    }
+
+    pub fn created(&self) -> io::Result<SystemTime> {
+        if self.mask & STATX_BTIME != 0 {
+            Ok(SystemTime::new(self.btime.0, self.btime.1))
+        } else {
+            Err(io::const_error!(
+                io::ErrorKind::Unsupported,
+                "creation time is not available for the filesystem",
+            ))
+        }
+    }
+}
+
+// ---------------------------------------------------------------------------
+// Permissions / type / times
+// ---------------------------------------------------------------------------
+
+#[derive(Clone, PartialEq, Eq, Debug)]
+pub struct FilePermissions {
+    mode: u16,
+}
+
+impl FilePermissions {
+    pub fn readonly(&self) -> bool {
+        // No write bit set for owner, group, or others.
+        self.mode & 0o222 == 0
+    }
+
+    pub fn set_readonly(&mut self, readonly: bool) {
+        if readonly {
+            self.mode &= !0o222;
+        } else {
+            self.mode |= 0o222;
+        }
+    }
+}
+
+#[derive(Copy, Clone, PartialEq, Eq, Hash, Debug)]
+pub struct FileType {
+    mode: u16,
+}
+
+impl FileType {
+    pub fn is_dir(&self) -> bool {
+        self.mode == S_IFDIR
+    }
+    pub fn is_file(&self) -> bool {
+        self.mode == S_IFREG
+    }
+    pub fn is_symlink(&self) -> bool {
+        self.mode == S_IFLNK
+    }
+}
+
+#[derive(Copy, Clone, Debug, Default)]
+pub struct FileTimes {
+    accessed: Option<SystemTime>,
+    modified: Option<SystemTime>,
+}
+
+impl FileTimes {
+    pub fn set_accessed(&mut self, t: SystemTime) {
+        self.accessed = Some(t);
+    }
+    pub fn set_modified(&mut self, t: SystemTime) {
+        self.modified = Some(t);
+    }
+}
+
+/// Render an optional time as a `timespec` for `utimensat`, using `UTIME_OMIT`
+/// for the fields the caller left unset.
+fn to_timespec(t: Option<SystemTime>) -> [i64; 2] {
+    match t {
+        Some(st) => {
+            let d = st.sub_time(&crate::sys::time::UNIX_EPOCH).unwrap_or_default();
+            [d.as_secs() as i64, d.subsec_nanos() as i64]
+        }
+        None => [0, UTIME_OMIT],
+    }
+}
+
+// ---------------------------------------------------------------------------
+// OpenOptions / DirBuilder
+// ---------------------------------------------------------------------------
+
+#[derive(Clone, Debug)]
+pub struct OpenOptions {
+    read: bool,
+    write: bool,
+    append: bool,
+    truncate: bool,
+    create: bool,
+    create_new: bool,
+    mode: u32,
+}
+
+impl OpenOptions {
+    pub fn new() -> OpenOptions {
+        OpenOptions {
+            read: false,
+            write: false,
+            append: false,
+            truncate: false,
+            create: false,
+            create_new: false,
+            mode: 0o666,
+        }
+    }
+
+    pub fn read(&mut self, read: bool) {
+        self.read = read;
+    }
+    pub fn write(&mut self, write: bool) {
+        self.write = write;
+    }
+    pub fn append(&mut self, append: bool) {
+        self.append = append;
+    }
+    pub fn truncate(&mut self, truncate: bool) {
+        self.truncate = truncate;
+    }
+    pub fn create(&mut self, create: bool) {
+        self.create = create;
+    }
+    pub fn create_new(&mut self, create_new: bool) {
+        self.create_new = create_new;
+    }
+
+    fn get_access_mode(&self) -> io::Result<i32> {
+        match (self.read, self.write, self.append) {
+            (true, false, false) => Ok(O_RDONLY),
+            (false, true, false) => Ok(O_WRONLY),
+            (true, true, false) => Ok(O_RDWR),
+            (false, _, true) => Ok(O_WRONLY | O_APPEND),
+            (true, _, true) => Ok(O_RDWR | O_APPEND),
+            (false, false, false) => {
+                Err(io::const_error!(io::ErrorKind::InvalidInput, "invalid access mode"))
+            }
+        }
+    }
+
+    fn get_creation_mode(&self) -> io::Result<i32> {
+        match (self.write, self.append) {
+            (true, false) => {}
+            (false, false) => {
+                if self.truncate || self.create || self.create_new {
+                    return Err(io::const_error!(
+                        io::ErrorKind::InvalidInput,
+                        "invalid creation mode",
+                    ));
+                }
+            }
+            (_, true) => {
+                if self.truncate && !self.create_new {
+                    return Err(io::const_error!(
+                        io::ErrorKind::InvalidInput,
+                        "invalid creation mode",
+                    ));
+                }
+            }
+        }
+
+        Ok(match (self.create, self.truncate, self.create_new) {
+            (false, false, false) => 0,
+            (true, false, false) => O_CREAT,
+            (false, true, false) => O_TRUNC,
+            (true, true, false) => O_CREAT | O_TRUNC,
+            (_, _, true) => O_CREAT | O_EXCL,
+        })
+    }
+}
+
+#[derive(Debug)]
+pub struct DirBuilder {
+    mode: u32,
+}
+
+impl DirBuilder {
+    pub fn new() -> DirBuilder {
+        DirBuilder { mode: 0o777 }
+    }
+
+    pub fn mkdir(&self, path: &Path) -> io::Result<()> {
+        let c = os::cstr(path)?;
+        cvt(unsafe {
+            sysc::syscall3(sysc::MKDIRAT, AT_FDCWD, c.as_ptr() as usize, self.mode as usize)
+        })
+        .map(drop)
+    }
+
+    pub fn set_mode(&mut self, mode: u32) {
+        self.mode = mode;
+    }
+}
+
+// ---------------------------------------------------------------------------
+// Directory iteration (getdents64)
+// ---------------------------------------------------------------------------
+
+struct InnerReadDir {
+    root: PathBuf,
+    dir: Vec<u8>,
+}
+
+pub struct ReadDir {
+    inner: Arc<InnerReadDir>,
+    pos: usize,
+}
+
+impl fmt::Debug for ReadDir {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        fmt::Debug::fmt(&*self.inner.root, f)
+    }
+}
+
+impl Iterator for ReadDir {
+    type Item = io::Result<DirEntry>;
+
+    fn next(&mut self) -> Option<io::Result<DirEntry>> {
+        let buf = &self.inner.dir;
+        while self.pos < buf.len() {
+            let off = self.pos;
+            // struct linux_dirent64 { u64 d_ino; i64 d_off; u16 d_reclen;
+            //                         u8 d_type; char d_name[]; }
+            let reclen = rd_u16(buf, off + 16) as usize;
+            let d_type = buf[off + 18];
+            self.pos += reclen;
+
+            // d_name is NUL-terminated; take bytes up to the first NUL.
+            let name_start = off + 19;
+            let name_end = buf[name_start..off + reclen]
+                .iter()
+                .position(|&b| b == 0)
+                .map(|p| name_start + p)
+                .unwrap_or(off + reclen);
+            let name = &buf[name_start..name_end];
+
+            // Skip the "." and ".." pseudo-entries, like the unix backend.
+            if name == b"." || name == b".." {
+                continue;
+            }
+
+            return Some(Ok(DirEntry {
+                root: self.inner.clone(),
+                name: os::os_string_from_bytes(name),
+                d_type,
+            }));
+        }
+        None
+    }
+}
+
+pub struct DirEntry {
+    root: Arc<InnerReadDir>,
+    name: OsString,
+    d_type: u8,
+}
+
+impl DirEntry {
+    pub fn path(&self) -> PathBuf {
+        self.root.root.join(&self.name)
+    }
+
+    pub fn file_name(&self) -> OsString {
+        self.name.clone()
+    }
+
+    pub fn metadata(&self) -> io::Result<FileAttr> {
+        lstat(&self.path())
+    }
+
+    pub fn file_type(&self) -> io::Result<FileType> {
+        match self.d_type {
+            DT_DIR => Ok(FileType { mode: S_IFDIR }),
+            DT_REG => Ok(FileType { mode: S_IFREG }),
+            DT_LNK => Ok(FileType { mode: S_IFLNK }),
+            // Filesystems that don't report a d_type (DT_UNKNOWN) need a stat.
+            _ => Ok(self.metadata()?.file_type()),
+        }
+    }
+}
+
+pub fn readdir(path: &Path) -> io::Result<ReadDir> {
+    let c = os::cstr(path)?;
+    let fd = cvt(unsafe {
+        sysc::syscall4(
+            sysc::OPENAT,
+            AT_FDCWD,
+            c.as_ptr() as usize,
+            (O_RDONLY | O_DIRECTORY | O_CLOEXEC) as usize,
+            0,
+        )
+    })? as i32;
+    let guard = unsafe { File::from_raw_fd(fd) }; // closes the dir fd on the way out
+
+    let mut dir = Vec::new();
+    let mut buf = [0u8; 4096];
+    loop {
+        let n = cvt(unsafe {
+            sysc::syscall3(sysc::GETDENTS64, fd as usize, buf.as_mut_ptr() as usize, buf.len())
+        })?;
+        if n == 0 {
+            break;
+        }
+        dir.extend_from_slice(&buf[..n]);
+    }
+    drop(guard);
+
+    Ok(ReadDir {
+        inner: Arc::new(InnerReadDir { root: path.to_path_buf(), dir }),
+        pos: 0,
+    })
+}
+
+// ---------------------------------------------------------------------------
+// Path operations (the *at family, rooted at AT_FDCWD)
+// ---------------------------------------------------------------------------
+
+pub fn unlink(path: &Path) -> io::Result<()> {
+    let c = os::cstr(path)?;
+    cvt(unsafe { sysc::syscall3(sysc::UNLINKAT, AT_FDCWD, c.as_ptr() as usize, 0) }).map(drop)
+}
+
+pub fn rmdir(path: &Path) -> io::Result<()> {
+    let c = os::cstr(path)?;
+    cvt(unsafe { sysc::syscall3(sysc::UNLINKAT, AT_FDCWD, c.as_ptr() as usize, AT_REMOVEDIR) })
+        .map(drop)
+}
+
+pub fn rename(old: &Path, new: &Path) -> io::Result<()> {
+    let o = os::cstr(old)?;
+    let n = os::cstr(new)?;
+    cvt(unsafe {
+        sysc::syscall4(
+            sysc::RENAMEAT,
+            AT_FDCWD,
+            o.as_ptr() as usize,
+            AT_FDCWD,
+            n.as_ptr() as usize,
+        )
+    })
+    .map(drop)
+}
+
+pub fn set_perm(path: &Path, perm: FilePermissions) -> io::Result<()> {
+    let c = os::cstr(path)?;
+    cvt(unsafe {
+        sysc::syscall3(sysc::FCHMODAT, AT_FDCWD, c.as_ptr() as usize, perm.mode as usize)
+    })
+    .map(drop)
+}
+
+// Path-based timestamp setters — the free-function fs interface 1.92 added
+// (sys/fs/mod.rs calls imp::set_times / imp::set_times_nofollow). Same utimensat
+// path as File::set_times, rooted at AT_FDCWD; the _nofollow variant sets the
+// AT_SYMLINK_NOFOLLOW flag so it touches the symlink itself, not its target.
+pub fn set_times(path: &Path, times: FileTimes) -> io::Result<()> {
+    set_times_at(path, times, 0)
+}
+
+pub fn set_times_nofollow(path: &Path, times: FileTimes) -> io::Result<()> {
+    set_times_at(path, times, AT_SYMLINK_NOFOLLOW)
+}
+
+fn set_times_at(path: &Path, times: FileTimes, flags: usize) -> io::Result<()> {
+    let c = os::cstr(path)?;
+    let ts = [to_timespec(times.accessed), to_timespec(times.modified)];
+    cvt(unsafe {
+        sysc::syscall4(sysc::UTIMENSAT, AT_FDCWD, c.as_ptr() as usize, ts.as_ptr() as usize, flags)
+    })
+    .map(drop)
+}
+
+pub fn readlink(path: &Path) -> io::Result<PathBuf> {
+    let c = os::cstr(path)?;
+    let mut buf = vec![0u8; 256];
+    loop {
+        let n = cvt(unsafe {
+            sysc::syscall4(
+                sysc::READLINKAT,
+                AT_FDCWD,
+                c.as_ptr() as usize,
+                buf.as_mut_ptr() as usize,
+                buf.len(),
+            )
+        })?;
+        // A full buffer means the target may be truncated; grow and retry.
+        if n < buf.len() {
+            buf.truncate(n);
+            return Ok(PathBuf::from(os::os_string_from_bytes(&buf)));
+        }
+        let len = buf.len() * 2;
+        buf.resize(len, 0);
+    }
+}
+
+pub fn symlink(original: &Path, link: &Path) -> io::Result<()> {
+    let target = os::cstr(original)?;
+    let linkpath = os::cstr(link)?;
+    cvt(unsafe {
+        sysc::syscall3(
+            sysc::SYMLINKAT,
+            target.as_ptr() as usize,
+            AT_FDCWD,
+            linkpath.as_ptr() as usize,
+        )
+    })
+    .map(drop)
+}
+
+pub fn link(original: &Path, link: &Path) -> io::Result<()> {
+    let o = os::cstr(original)?;
+    let l = os::cstr(link)?;
+    cvt(unsafe {
+        sysc::syscall5(
+            sysc::LINKAT,
+            AT_FDCWD,
+            o.as_ptr() as usize,
+            AT_FDCWD,
+            l.as_ptr() as usize,
+            0,
+        )
+    })
+    .map(drop)
+}
+
+pub fn stat(path: &Path) -> io::Result<FileAttr> {
+    let c = os::cstr(path)?;
+    do_statx(AT_FDCWD, &c, 0)
+}
+
+pub fn lstat(path: &Path) -> io::Result<FileAttr> {
+    let c = os::cstr(path)?;
+    do_statx(AT_FDCWD, &c, AT_SYMLINK_NOFOLLOW)
+}
+
+pub fn canonicalize(path: &Path) -> io::Result<PathBuf> {
+    // No `realpath(3)` without libc: open the path with `O_PATH` and read back
+    // the kernel's canonical name via `/proc/self/fd/<n>`.
+    let c = os::cstr(path)?;
+    let fd = cvt(unsafe {
+        sysc::syscall4(
+            sysc::OPENAT,
+            AT_FDCWD,
+            c.as_ptr() as usize,
+            (O_PATH | O_CLOEXEC) as usize,
+            0,
+        )
+    })? as i32;
+    let guard = unsafe { File::from_raw_fd(fd) };
+    let proc = PathBuf::from(format!("/proc/self/fd/{fd}"));
+    let real = readlink(&proc);
+    drop(guard);
+    real
+}
