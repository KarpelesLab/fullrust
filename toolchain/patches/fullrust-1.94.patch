@@ -0,0 +1,23 @@
+use super::mystd::env;
+use super::{Library, LibrarySegment};
+use alloc::vec;
+use alloc::vec::Vec;
+
+// `fullrust` executables are statically linked and non-PIE, so the ELF's stated
+// virtual addresses equal the runtime addresses: the single mapped image has a
+// bias of 0 and a lone segment covering the whole address space. Symbolization
+// then reads DWARF straight from the on-disk executable (`/proc/self/exe`).
+pub(super) fn native_libraries() -> Vec<Library> {
+    let mut ret = Vec::new();
+    if let Ok(path) = env::current_exe() {
+        ret.push(Library {
+            name: path.into_os_string(),
+            segments: vec![LibrarySegment {
+                stated_virtual_memory_address: 0,
+                len: usize::MAX,
+            }],
+            bias: 0,
+        });
+    }
+    ret
+}
