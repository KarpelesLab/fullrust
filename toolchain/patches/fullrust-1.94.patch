+//! Environment variables for the fullrust target.
+//!
+//! There is no libc `environ`/`setenv`, so we own the environment: a map seeded
+//! once (lazily) from the loader's `envp` — captured at startup by the pal's
+//! `init` — and then mutated by `set_var`/`remove_var`. Names/values are decoded
+//! lossily as UTF-8, matching how `std::env::args()` treats non-Unicode here.
+
+pub use super::common::Env;
+use crate::collections::BTreeMap;
+use crate::ffi::{CStr, OsStr, OsString, c_char};
+use crate::io;
+use crate::ptr;
+use crate::sync::Mutex;
+use crate::sync::atomic::{AtomicPtr, Ordering};
+
+/// The loader's `envp` (a NULL-terminated `char**`), captured at startup.
+static ENVP: AtomicPtr<*const c_char> = AtomicPtr::new(ptr::null_mut());
+
+/// The owned environment, seeded lazily from `ENVP` on first access.
+static ENV: Mutex<Option<BTreeMap<OsString, OsString>>> = Mutex::new(None);
+
+/// Record the loader-provided environment vector. Called once at startup by the
+/// pal (`pal::fullrust::common::init`).
+///
+/// # Safety
+/// `envp` must be a valid NULL-terminated array of C strings (or null), valid
+/// for the life of the process.
+pub unsafe fn init(envp: *const *const c_char) {
+    ENVP.store(envp as *mut *const c_char, Ordering::Relaxed);
+}
+
+/// Run `f` with the owned environment map, seeding it from `envp` on first use.
+fn with_env<T>(f: impl FnOnce(&mut BTreeMap<OsString, OsString>) -> T) -> T {
+    let mut guard = ENV.lock().unwrap();
+    if guard.is_none() {
+        let mut map = BTreeMap::new();
+        let envp = ENVP.load(Ordering::Relaxed) as *const *const c_char;
+        if !envp.is_null() {
+            let mut i = 0;
+            // SAFETY: `envp` is a NULL-terminated array of valid C strings.
+            loop {
+                let p = unsafe { *envp.add(i) };
+                if p.is_null() {
+                    break;
+                }
+                i += 1;
+                let bytes = unsafe { CStr::from_ptr(p).to_bytes() };
+                if let Some((k, v)) = parse(bytes) {
+                    map.insert(k, v);
+                }
+            }
+        }
+        *guard = Some(map);
+    }
+    f(guard.as_mut().unwrap())
+}
+
+/// Split a `KEY=VALUE` entry. A leading `=` is allowed in the value-less form
+/// (glibc strategy): names must be non-empty, so search for `=` past the first
+/// byte. Malformed entries (no `=`) are skipped.
+fn parse(input: &[u8]) -> Option<(OsString, OsString)> {
+    if input.is_empty() {
+        return None;
+    }
+    let eq = input[1..].iter().position(|&b| b == b'=').map(|p| p + 1)?;
+    let key = String::from_utf8_lossy(&input[..eq]).into_owned();
+    let val = String::from_utf8_lossy(&input[eq + 1..]).into_owned();
+    Some((OsString::from(key), OsString::from(val)))
+}
+
+pub fn env() -> Env {
+    let snapshot = with_env(|m| m.iter().map(|(k, v)| (k.clone(), v.clone())).collect());
+    Env::new(snapshot)
+}
+
+pub fn getenv(k: &OsStr) -> Option<OsString> {
+    with_env(|m| m.get(k).cloned())
+}
+
+pub unsafe fn setenv(k: &OsStr, v: &OsStr) -> io::Result<()> {
+    with_env(|m| m.insert(k.to_owned(), v.to_owned()));
+    Ok(())
+}
+
+pub unsafe fn unsetenv(k: &OsStr) -> io::Result<()> {
+    with_env(|m| m.remove(k));
+    Ok(())
+}
