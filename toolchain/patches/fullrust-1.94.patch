+        self.inner.read(buf)
+    }
+    pub fn read_buf(&self, cursor: BorrowedCursor<'_>) -> io::Result<()> {
+        self.inner.read_buf(cursor)
+    }
+    pub fn read_vectored(&self, bufs: &mut [IoSliceMut<'_>]) -> io::Result<usize> {
+        self.inner.read_vectored(bufs)
+    }
+    pub fn is_read_vectored(&self) -> bool {
+        true
+    }
+    pub fn write(&self, buf: &[u8]) -> io::Result<usize> {
+        self.inner.write(buf)
+    }
+    pub fn write_vectored(&self, bufs: &[IoSlice<'_>]) -> io::Result<usize> {
+        self.inner.write_vectored(bufs)
+    }
+    pub fn is_write_vectored(&self) -> bool {
+        true
+    }
+    pub fn peer_addr(&self) -> io::Result<SocketAddr> {
+        self.inner.sockname(sysc::GETPEERNAME)
+    }
+    pub fn socket_addr(&self) -> io::Result<SocketAddr> {
+        self.inner.sockname(sysc::GETSOCKNAME)
+    }
+    pub fn shutdown(&self, how: Shutdown) -> io::Result<()> {
+        self.inner.shutdown(how)
+    }
+    pub fn duplicate(&self) -> io::Result<TcpStream> {
+        Ok(TcpStream { inner: self.inner.duplicate()? })
+    }
+    pub fn set_linger(&self, linger: Option<Duration>) -> io::Result<()> {
+        // struct linger { i32 l_onoff; i32 l_linger; }
+        let l: [i32; 2] = match linger {
+            Some(d) => [1, d.as_secs().min(i32::MAX as u64) as i32],
+            None => [0, 0],
+        };
+        self.inner.setsockopt(SOL_SOCKET, SO_LINGER, l)
+    }
+    pub fn linger(&self) -> io::Result<Option<Duration>> {
+        let l: [i32; 2] = self.inner.getsockopt(SOL_SOCKET, SO_LINGER)?;
+        Ok(if l[0] == 0 { None } else { Some(Duration::from_secs(l[1] as u64)) })
+    }
+    pub fn set_nodelay(&self, nodelay: bool) -> io::Result<()> {
+        self.inner.setsockopt(IPPROTO_TCP, TCP_NODELAY, nodelay as i32)
+    }
+    pub fn nodelay(&self) -> io::Result<bool> {
+        let v: i32 = self.inner.getsockopt(IPPROTO_TCP, TCP_NODELAY)?;
+        Ok(v != 0)
+    }
+    pub fn set_ttl(&self, ttl: u32) -> io::Result<()> {
+        self.inner.setsockopt(IPPROTO_IP, IP_TTL, ttl as i32)
+    }
+    pub fn ttl(&self) -> io::Result<u32> {
+        let v: i32 = self.inner.getsockopt(IPPROTO_IP, IP_TTL)?;
+        Ok(v as u32)
+    }
+    pub fn take_error(&self) -> io::Result<Option<io::Error>> {
+        self.inner.take_error()
+    }
+    pub fn set_nonblocking(&self, nonblocking: bool) -> io::Result<()> {
+        self.inner.set_nonblocking(nonblocking)
+    }
+}
